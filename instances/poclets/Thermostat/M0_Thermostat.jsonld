  "@graph": [
    {
      "@id": "M0_Thermostat.jsonld",
      "@type": "owl:Ontology",
      "rdfs:label": "Thermostat (studio flat, F1)",
      "rdfs:comment": "A one-room flat heated by a heater and a radiator, losing heat through its wall and window to the outside, and kept near a set point by a wall thermostat with hysteresis (on/off control). The minimal technical negative feedback loop: the room never rests on the set point but oscillates in a sawtooth between the two edges of the hysteresis band. First TSCG Kit workshop to go through the instance pipeline: its playable scale model (Synoptic, Panel, Scale model, Curves) is the simulation of this poclet.",
      "owl:versionInfo": "1.1.0",
      "dcterms:modified": "2026-11-08",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "dcterms:created": "2026-11-07",
      "owl:imports": [
        {
          "@id": "M3_GenesisGrammar.jsonld"
        },
        {
          "@id": "M2_GenericConcepts.jsonld"
        },
        {
          "@id": "M1_CoreConcepts.jsonld"
        },
        {
          "@id": "M0_Common.jsonld"
        }
      ],
      "m3:ontologyType": {
        "@id": "m3:Poclet"
      },
      "m3:hasFacetValue": {
        "@id": "m3:audience.KitUser"
      },
      "m1:domain": [
        "Cybernetics",
        "Engineering"
      ],
      "m0:scoreA": 0.85,
      "m0:scoreS": 0.85,
      "m0:scoreF": 0.9,
      "m0:scoreIt": 0.75,
      "m0:scoreD": 0.9,
      "m0:scoreR": 0.9,
      "m0:scoreE": 0.8,
      "m0:scoreV": 0.9,
      "m0:scoreO": 0.85,
      "m0:scoreIm": 0.7,
      "m0:asfidMean": 0.85,
      "m0:revoiMean": 0.83,
      "m0:epistemicGap": 0.014,
      "m0:spectralClass": {
        "@id": "m0:spectralClass.Coherent"
      },
      "m0:scoringStatus": {
        "@id": "m0:scoringStatus.Complete"
      },
      "m0:focalApplicable": false,
      "skos:note": "Scores. Territory: F and D are highest (two explicit heat and information flows; exponential relaxations, a limit cycle and a radiator delay). It is lowest: the command is one bit and the measurement a single temperature. Map: R and V are highest (the block diagram exists as a playable model whose curves can be checked against the physics); Im is lowest because three concepts needed to type it are missing or misfit in the framework (gaps G1-G3).",
      "m3:changelog": [
        {
          "owl:versionInfo": "1.1.0",
          "dcterms:date": "2026-11-08",
          "adms:versionNotes": "Gap G2 closed: the wall thermostat is typed m1:Hysteresis = Fm2(Threshold, Memory) (M1_CoreConcepts 2.25.0) instead of m2:Threshold + m2:Memory."
        },
        {
          "owl:versionInfo": "1.0.0",
          "dcterms:date": "2026-11-07",
          "adms:versionNotes": "Creation from the TSCG Kit workshop kit/thermostat (Kit 0.9.2), pipeline steps 1-3; gaps G1-G3 recorded in the validation section."
        }
      ],
      "m0.thermostat:completeness": {
        "dcterms:description": "Every element needed for on/off regulation is present: a store of heat (room), a delaying store (radiator), a source (heater), a loss path (wall and window) to an environment (outside), a sensor-comparator with hysteresis (thermostat) and the wires that close the loop."
      },
      "m0.thermostat:minimality": {
        "dcterms:description": "Five blocks and five wires; removing any of them breaks either the loop or the phenomenon (without the wall the room only warms; without hysteresis the heater chatters; without the radiator there is no overshoot)."
      },
      "m0.thermostat:pedagogy": {
        "dcterms:description": "Built piece by piece in the Kit tutorial (5 steps): the room cools, the heater warms it, the thermostat regulates it, a window perturbs it, the radiator delays it. It is the pivot of the Kit's map of scenarios: Larsen, Drinking bird and Sunflower articulate from it; the house (zoom out) and the inside of the thermostat (zoom in) are planned."
      },
      "m0.thermostat:observer": {
        "dcterms:description": "The player, through two views of the same graph: the Panel (instruments that read and write it: thermometers, heat lamp, set-point slider) and the Scale model (the studio flat itself, with its own wall thermometer and thermostat). The two views are never named as Map and Territory in the Kit: the player discovers the difference."
      },
      "m0.thermostat:process": {
        "dcterms:description": "While the room is below the lower edge of the band the thermostat closes and the heater warms the radiator, which warms the room; above the upper edge it opens and the room cools through the wall. The temperature climbs and falls between the two edges: a relaxation oscillation whose period depends on the hysteresis, the capacities, the losses and the outside temperature."
      },
      "m0.thermostat:territorySpace": {
        "dcterms:description": "ASFID. A: the set point and its hysteresis band. S: room, radiator, wall, thermostat and the loop topology. F: heat flux heater to outside, information flux temperature to command. It: measured temperature, 1-bit command, set point. D: relaxations (time constants C/k), sawtooth limit cycle, radiator delay and overshoot, perturbations."
      },
      "m0.thermostat:mapSpace": {
        "dcterms:description": "REVOI. R: the Synoptic is the block diagram. E: parameters and blocks are editable; the house scenario extends it. V: curves and scale model can be checked against Newton's law of cooling. O: every state variable has an instrument. Im: maps onto control theory (bang-bang control) and the Schmitt trigger, but needs Boundary, Hysteresis and a relaxation oscillator to be fully typed."
      },
      "m0.thermostat:epistemicGap": {
        "dcterms:description": "asfidMean 0.85, revoiMean 0.83, epistemicGap 0.014: Coherent. Map and Territory are aligned because the model was built as a working scale model before being formalised."
      },
      "m0.thermostat:GenericConceptsMobilized": [
        {
          "@id": "m2:Storage"
        },
        {
          "@id": "m2:Inertia"
        },
        {
          "@id": "m2:Transducer"
        },
        {
          "@id": "m2:Activation"
        },
        {
          "@id": "m2:Dissipation"
        },
        {
          "@id": "m2:Environment"
        },
        {
          "@id": "m2:Gradient"
        },
        {
          "@id": "m2:Threshold"
        },
        {
          "@id": "m2:Memory"
        },
        {
          "@id": "m2:Signal"
        },
        {
          "@id": "m2:FeedbackLoop"
        },
        {
          "@id": "m2:Regulation"
        },
        {
          "@id": "m2:Homeostasis"
        },
        {
          "@id": "m2:Balance"
        },
        {
          "@id": "m2:Trajectory"
        },
        {
          "@id": "m2:Observer"
        }
      ],
      "m0.thermostat:validation": [
        {
          "rdfs:label": "G1 - Boundary",
          "dcterms:description": "The wall (and the window that opens) is a boundary between the system and its environment; m2:Boundary is not defined (WS-5 lot-NSRESOLVE phantom; WS-13 D9 and Addendum A DA3). The wall is typed here by what crosses it (m2:Dissipation). The window is m1:Permeability, which still relies on the phantom m2:Interface."
        },
        {
          "rdfs:label": "G2 - Hysteresis",
          "dcterms:description": "CLOSED in 1.1.0 (2026-11-08). There was no concept for a threshold whose switching value depends on the direction of travel; the thermostat was typed m2:Threshold + m2:Memory. m1:Hysteresis = Fm2(Threshold, Memory) now exists (M1_CoreConcepts 2.25.0) and types it."
        },
        {
          "rdfs:label": "G3 - Relaxation oscillation",
          "dcterms:description": "The sawtooth is a relaxation limit cycle; m1:Oscillator describes a harmonic oscillation (attractor point, damping ratio, guard trajectoryShape=Circular). Typed here as m2:Trajectory only."
        }
      ],
      "m0.thermostat:simulation": {
        "rdfs:label": "Playable scale model (TSCG Kit)",
        "dcterms:description": "static/M0_Thermostat.html, built from static/src/ by kit/tools/bundle.js with the shared Kit libraries (kit/lib/). Tutorial, free mode, English / French."
      }
    },
    {
      "@id": "m0.thermostat:Room",
      "@type": [
        "owl:NamedIndividual",
        "m2:Storage",
        "m2:Inertia"
      ],
      "rdfs:label": "Room (studio flat)",
      "rdfs:comment": "The single space of the flat: a store of heat with a thermal capacity; its temperature is the regulated variable.",
      "m0.thermostat:kitBlock": "room (generic kind: storage)"
    },
    {
      "@id": "m0.thermostat:Radiator",
      "@type": [
        "owl:NamedIndividual",
        "m2:Storage",
        "m2:Inertia"
      ],
      "rdfs:label": "Radiator",
      "rdfs:comment": "A smaller store of heat between the heater and the room; it delays the heating and causes the overshoot.",
      "m0.thermostat:kitBlock": "radiator (generic kind: storage)"
    },
    {
      "@id": "m0.thermostat:Heater",
      "@type": [
        "owl:NamedIndividual",
        "m2:Transducer",
        "m2:Activation"
      ],
      "rdfs:label": "Heater",
      "rdfs:comment": "Converts electric power (or gas) into heat; switched on and off by the thermostat's command.",
      "m0.thermostat:kitBlock": "heater (generic kind: source)"
    },
    {
      "@id": "m0.thermostat:Wall",
      "@type": [
        "owl:NamedIndividual",
        "m2:Dissipation"
      ],
      "rdfs:label": "Wall and window",
      "rdfs:comment": "Lets heat leak to the outside, more when the window is open; a boundary of the system (gap G1).",
      "m0.thermostat:kitBlock": "wall (generic kind: sink)"
    },
    {
      "@id": "m0.thermostat:Outside",
      "@type": [
        "owl:NamedIndividual",
        "m2:Environment"
      ],
      "rdfs:label": "Outside",
      "rdfs:comment": "The cold environment the room loses heat to; its temperature is a parameter of the wall."
    },
    {
      "@id": "m0.thermostat:TemperatureGap",
      "@type": [
        "owl:NamedIndividual",
        "m2:Gradient"
      ],
      "rdfs:label": "Inside-outside temperature gap",
      "rdfs:comment": "The gap between the room and the outside drives the losses through the wall."
    },
    {
      "@id": "m0.thermostat:WallThermostat",
      "@type": [
        "owl:NamedIndividual",
        "m1:Hysteresis"
      ],
      "rdfs:label": "Thermostat",
      "rdfs:comment": "Compares the room temperature with its set point and switches the heater with a hysteresis: it closes below the lower edge of the band and opens above the upper edge. Typed m1:Hysteresis = Fm2(Threshold, Memory) (gap G2, closed in 1.1.0).",
      "m0.thermostat:kitBlock": "bimetal, named Thermostat (generic kind: threshold)",
      "m0.thermostat:setPoint": {
        "skos:note": "20 °C by default, hysteresis band 1 °C, adjustable on the Panel."
      }
    },
    {
      "@id": "m0.thermostat:TemperatureSignal",
      "@type": [
        "owl:NamedIndividual",
        "m2:Signal"
      ],
      "rdfs:label": "Temperature signal",
      "rdfs:comment": "Information wire from the room's level to the thermostat."
    },
    {
      "@id": "m0.thermostat:CommandSignal",
      "@type": [
        "owl:NamedIndividual",
        "m2:Signal"
      ],
      "rdfs:label": "On/off command",
      "rdfs:comment": "Information wire from the thermostat to the heater: one bit."
    },
    {
      "@id": "m0.thermostat:RegulationLoop",
      "@type": [
        "owl:NamedIndividual",
        "m2:FeedbackLoop",
        "m2:Regulation",
        "m2:Homeostasis",
        "m2:Balance"
      ],
      "rdfs:label": "Regulation loop",
      "rdfs:comment": "Room, thermostat, heater, radiator, room: a negative feedback loop. On average heating compensates the losses (Balance), but the loop has no resting point inside the hysteresis band."
    },
    {
      "@id": "m0.thermostat:Sawtooth",
      "@type": [
        "owl:NamedIndividual",
        "m2:Trajectory"
      ],
      "rdfs:label": "Sawtooth",
      "rdfs:comment": "The room temperature climbs and falls between the two edges of the band: a relaxation oscillation (gap G3)."
    },
    {
      "@id": "m0.thermostat:Instruments",
      "@type": [
        "owl:NamedIndividual",
        "m2:Observer"
      ],
      "rdfs:label": "Panel instruments",
      "rdfs:comment": "Thermometers of the room and the radiator, heat lamp, set-point slider, outside temperature: they read and write the same graph as the scale model."
    },
    {
      "@id": "m0.thermostat:completeness",
      "@type": "owl:AnnotationProperty",
      "rdfs:label": "Completeness",
      "rdfs:comment": "Why every element needed for the phenomenon is present."
