{
  "@context": {
    "@base": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/",
    "m0": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M0_Common.jsonld#",
    "m1": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M1_CoreConcepts.jsonld#",
    "m1.ext:electronics": "M1_extensions/electronics/M1_Electronics.jsonld#",
    "m1.ext:optics": "M1_extensions/optics/M1_Optics.jsonld#",
    "m2": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#",
    "m3": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M3_GenesisGrammar.jsonld#",
    "m3:eagle_eye": "M3_EagleEye.jsonld#",
    "m3:sphinx_eye": "M3_SphinxEye.jsonld#",
    "dcterms": "http://purl.org/dc/terms/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "m0.qRCodeToPocketCity": "https://raw.githubusercontent.com/Echopraxium/tscg/main/instances/poclets/QRCodeToPocketCity/M0_QRCodeToPocketCity.jsonld#"
  },
  "@graph": [
    {
      "@id": "M0_QRCodeToPocketCity.jsonld",
      "@type": "owl:Ontology",
      "rdfs:label": "QR Code to Pocket City",
      "rdfs:comment": "A QR code is deterministically transformed into a navigable 3D miniature city, under one binding constraint: seen orthographically from directly above, the city must still be a scannable QR code encoding the original payload. The same information therefore carries two simultaneous encodings — one machine-readable, one human-inhabitable — that are required not to conflict. The generative seed acts as the city's identity: same text produces the same city, always.",
      "owl:versionInfo": "1.0.0",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "dcterms:created": "2026-08-02",
      "owl:imports": [
        "M0_Common.jsonld",
        "M1_CoreConcepts.jsonld",
        "M2_GenericConcepts.jsonld",
        "M3_GenesisGrammar.jsonld"
      ],
      "m3:ontologyType": {
        "@id": "m3:Poclet"
      },
      "m3:semanticSignature": "dual_encoding + constrained_generation + navigable_symbol",
      "m0:hasFacet": {
        "@id": "m0:facet.Democratization"
      },
      "m0:roleGrounding": {
        "@id": "m0:roleGrounding.Designed"
      },
      "m0:illustratesConcept": [
        "Map/Territory duality — one payload, two simultaneous encodings that must not conflict",
        {
          "@id": "m2:Constraint"
        },
        {
          "@id": "m2:Invariant"
        }
      ],
      "m1:domain": [
        "Procedural Generation",
        "Coding Theory"
      ],
      "m0:scoreA": 0.85,
      "m0:scoreS": 0.92,
      "m0:scoreF": 0.7,
      "m0:scoreIt": 0.88,
      "m0:scoreD": 0.72,
      "m0:scoreR": 0.95,
      "m0:scoreE": 0.88,
      "m0:scoreV": 0.92,
      "m0:scoreO": 0.9,
      "m0:scoreIm": 0.82,
      "m0:meanASFID": 0.814,
      "m0:meanREVOI": 0.894,
      "m0:epistemicGap": 0.08,
      "m0:spectralClass": {
        "@id": "m0:spectralClass.OnCriticalLine"
      },
      "m0:scoringStatus": {
        "@id": "m0:scoringStatus.Complete"
      },
      "m0:focalApplicable": false,
      "m0:scoringRationale": "S is highest on the Territory side: the module grid, finder patterns and building geometry are fully determined and inspectable. F is lowest: flow exists (the scanner's reading path, the explorer's traversal) but is not the system's centre of gravity. On the Map side V is exceptionally high because the model is directly falsifiable — point a scanner at the Bird's-eye view and it either decodes the payload or it does not. This is a rare case where a TSCG instance carries its own empirical test.",
      "m2:changelog": [
        {
          "version": "1.0.0",
          "date": "2026-08-02",
          "changes": "Initial version. Poclet modelling the deterministic transformation of a QR code into a navigable 3D city under a top-view readability constraint. 12 M2 GenericConcepts mobilized. Carries the Democratization facet with roleGrounding=Designed — first instance designed primarily for pedagogical purpose. Companion BabylonJS simulation in static/."
        }
      ],
      "m0:note": "Candidate for a future m3:ExploratorySpace instance type (navigable artifact with Gs as primary grammar). Typed m3:Poclet pending the ≥3 instances required to admit a new type."
    },
    {
      "@id": "m0.qRCodeToPocketCity:Payload",
      "@type": "owl:NamedIndividual",
      "rdfs:label": "Payload",
      "rdfs:comment": "The text encoded in the QR code. It is simultaneously the message a scanner recovers and, hashed, the seed that determines the city. One string, two roles.",
      "m2:instantiates": {
        "@id": "m2:Code"
      },
      "m0.qRCodeToPocketCity:dualRole": "message (machine-readable) + seed (city identity)"
    },
    {
      "@id": "m0.qRCodeToPocketCity:ModuleGrid",
      "@type": "owl:NamedIndividual",
      "rdfs:label": "Module Grid",
      "rdfs:comment": "The QR matrix: n x n binary modules, n in {21,25,29,33,37,41,45,49} as fixed by the QR specification (n = 21 + 4(version-1)). Dark modules become built ground, light modules become streets. The grid pitch is the city's only unit of measure.",
      "m2:instantiates": [
        {
          "@id": "m2:Segmentation"
        },
        {
          "@id": "m2:Invariant"
        }
      ],
      "m0.qRCodeToPocketCity:pitch": "1.0 (buildings inset to 0.998 to avoid coplanar z-fighting; roof caps at full 1.0 so blocks stay contiguous from above)"
    },
    {
      "@id": "m0.qRCodeToPocketCity:FinderPattern",
      "@type": "owl:NamedIndividual",
      "rdfs:label": "Finder Pattern",
      "rdfs:comment": "Three nested 7x7 squares at three corners. A scanner uses them to locate and orient itself; the city reuses them as its civic anchors (town hall, university, hospital...). The same structure serves localization in both encodings.",
      "m2:instantiates": [
        {
          "@id": "m2:Symmetry"
        },
        {
          "@id": "m2:Role"
        }
      ],
      "m0.qRCodeToPocketCity:asymmetryNote": "Three corners rather than four: the missing fourth is what lets a scanner resolve rotation. Deliberate broken symmetry as an information-bearing feature."
    },
    {
      "@id": "m0.qRCodeToPocketCity:ReadabilityConstraint",
      "@type": "owl:NamedIndividual",
      "rdfs:label": "Top-View Readability Constraint",
      "rdfs:comment": "The binding rule of the whole system: a dark module must remain predominantly dark seen from directly above, a light module predominantly light. Everything else is free. This single constraint is what makes the generation disciplined rather than arbitrary, and it is empirically testable with any scanner.",
      "m2:instantiates": [
        {
          "@id": "m2:Constraint"
        },
        {
          "@id": "m2:Threshold"
        }
      ],
      "m0.qRCodeToPocketCity:enforcementConsequences": [
        "Orthographic projection is mandatory: perspective makes off-centre buildings lean outward, so their roofs no longer cover their footprint",
        "Roofs are flat and dark; chimney caps match the roof exactly, since from above the cap is all that is visible",
        "Signs, doors and windows are vertical, therefore invisible from above and unconstrained"
      ]
    },
    {
      "@id": "m0.qRCodeToPocketCity:GenerativeSeed",
      "@type": "owl:NamedIndividual",
      "rdfs:label": "Generative Seed",
      "rdfs:comment": "A 32-bit value derived from the payload. It drives every procedural decision — heights, fenestration, materials, landmark assignment, arch placement. Same seed, same city, always. Successive SHA-256 application walks an ordered sequence of distinct interpretations of one unchanged QR plan.",
      "m2:instantiates": [
        {
          "@id": "m2:Identity"
        },
        {
          "@id": "m2:Signature"
        }
      ],
      "m0.qRCodeToPocketCity:determinism": "Mulberry32 PRNG; all procedural textures use fixed seeds so a city is reproducible across sessions and machines"
    },
    {
      "@id": "m0.qRCodeToPocketCity:Stylesheet",
      "@type": "owl:NamedIndividual",
      "rdfs:label": "Stylesheet",
      "rdfs:comment": "A declarative interpretation layer holding palettes, textures AND generation rules. Because the rules block drives geometry (heights, arch budget, fenestration density), a stylesheet does not repaint a city — it re-interprets the same seed into a different one. Layout is a style channel.",
      "m2:instantiates": [
        {
          "@id": "m2:Layer"
        },
        {
          "@id": "m2:Transformation"
        }
      ],
      "m0.qRCodeToPocketCity:separationPrinciple": "DATA (QR matrix) / STYLE (stylesheet) / CORE (generator) — the generator never hardcodes an appearance value"
    },
    {
      "@id": "m0.qRCodeToPocketCity:ArchTunnel",
      "@type": "owl:NamedIndividual",
      "rdfs:label": "Arch Tunnel",
      "rdfs:comment": "A passage cut through a straight run of 2-4 dark modules that has open street at both ends. It adds an edge to the street connectivity graph that does not exist in the flat QR — the city acquires topology its source lacks, without altering any module's dark/light state.",
      "m2:instantiates": [
        {
          "@id": "m2:Topology"
        },
        {
          "@id": "m2:Network"
        }
      ],
      "m0.qRCodeToPocketCity:topologicalClaim": "Strictly additive: the QR reading is untouched, but the traversable graph gains edges. The clearest demonstration that the city is a construction from the seed, not a depiction of it."
    },
    {
      "@id": "m0.qRCodeToPocketCity:PolarityReading",
      "@type": "owl:NamedIndividual",
      "rdfs:label": "Polarity Reading",
      "rdfs:comment": "The matrix may be read normally or inverted. Inverted, the built fabric becomes a continuous labyrinth and the street network fragments into isolated blocks. QR decodability is lost — deliberately: it marks the point where the artifact stops serving the code and serves the explorer instead.",
      "m2:instantiates": [
        {
          "@id": "m2:Symmetry"
        },
        {
          "@id": "m2:Trade-off"
        }
      ],
      "m0.qRCodeToPocketCity:tradeOff": "Normal preserves the machine encoding; inverted sacrifices it for a richer navigable topology. The two readings cannot both hold."
    },
    {
      "@id": "m0.qRCodeToPocketCity:NavigableSpace",
      "@type": "owl:NamedIndividual",
      "rdfs:label": "Navigable Space",
      "rdfs:comment": "The city as inhabited extent rather than image: streets at eye level, arches to pass through, landmarks to steer by. What a scanner traverses as a bit sequence, a person traverses as a place.",
      "m2:instantiates": [
        {
          "@id": "m2:Space"
        },
        {
          "@id": "m2:Component"
        }
      ],
      "m0.qRCodeToPocketCity:viewModes": [
        "Isometric — orthographic, obliquely, for reading the whole",
        "Bird's eye — orthographic, straight down, returns the source QR",
        "Walk — perspective, eye height locked, street level",
        "Fly — perspective, free altitude"
      ]
    }
  ]
}
