  "@graph": [
    {
      "@id": "M0_World2DProjection.jsonld",
      "@type": "owl:Ontology",
      "owl:imports": [
        "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M3_GenesisGrammar.jsonld",
        "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld",
        "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M1_CoreConcepts.jsonld",
        "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M1_extensions/cartography/M1_Cartography.jsonld",
        "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M0_Common.jsonld"
      ],
      "m3:ontologyType": {
        "@id": "m3:Poclet"
      },
      "rdfs:label": "World 2D Projection (Poclet)",
      "rdfs:comment": "The Territory/Map dichotomy made literal: projecting the terrestrial globe (the Territory) onto a flat map (the Map). Classifies four canonical projections along two orthogonal M1 facets (distortion property preserved, graticule geometry) and foregrounds the irreducible epistemic gap that Gauss's Theorema Egregium proves: no flat map can preserve all metric invariants of the sphere at once. Minimal yet complete across ASFID; the canonical poclet for the Map/Territory distinction itself.",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "dcterms:created": "2026-09-13",
      "owl:versionInfo": "1.0.0",
      "m1:domain": "Cartography",
      "m0:scoreA": 0.55,
      "m0:scoreS": 0.9,
      "m0:scoreF": 0.35,
      "m0:scoreIt": 0.85,
      "m0:scoreD": 0.45,
      "m0:scoreR": 0.95,
      "m0:scoreE": 0.7,
      "m0:scoreV": 0.9,
      "m0:scoreO": 0.9,
      "m0:scoreIm": 0.85,
      "m0:asfidMean": 0.62,
      "m0:revoiMean": 0.86,
      "m0:epistemicGap": 0.17,
      "m0:spectralClass": {
        "@id": "m0:spectralClass.Liminal"
      },
      "m0:scoringStatus": {
        "@id": "m0:scoringStatus.Complete"
      },
      "m0:focalApplicable": true,
      "m2:changelog": [
        {
          "version": "1.0.0",
          "date": "2026-09-13",
          "changes": "Initial M0 poclet. m3:ontologyType m3:Poclet; m1:domain Cartography. Five projection anchors (Mercator, Mollweide, Azimuthal Equidistant, Robinson, Gall-Peters) each carrying m3:hasFacetValue -> cartography:distortionProperty.* and cartography:graticuleGeometry.* (SC-3 facet mechanism). Gall-Peters added as facet-orthogonality proof. Flat bare-numeric scores; canonical m0:epistemicGap=0.17 (Liminal). Projection MATH deliberately excluded (lives in the Step-4 simulation); M0 stores classification + metadata only. Notation: x / + / | only (no tensor glyph)."
        }
      ],
      "m0.world2DProjection:pocletType": "Classification (faceted)",
      "m0.world2DProjection:completeness": "All 5 ASFID dimensions present; S+It dominant",
      "m0.world2DProjection:minimality": "Four canonical anchors span the closed distortionProperty tetra-lemma; a 5th proves facet orthogonality",
      "m0.world2DProjection:pedagogy": "Entry point for the Territory/Map distinction and for faceted (Ranganathan) classification",
      "m0.world2DProjection:observer": "Human cartographer (modern GIS convention)",
      "m0.world2DProjection:anchors": [
        {
          "@id": "m0.world2DProjection:Mercator",
          "@type": "m0.world2DProjection:ProjectionAnchor",
          "rdfs:label": "Mercator",
          "m0.world2DProjection:author": "Gerardus Mercator",
          "m0.world2DProjection:year": "1569",
          "m0.world2DProjection:family": "Cylindrical conformal",
          "m0.world2DProjection:paramNote": "Standard parallel at the equator; unbounded toward the poles (poles at infinity).",
          "m0.world2DProjection:role": "The navigation map: straight rhumb lines. Area explodes toward the poles (Greenland ≈ Africa on screen, ~14× smaller in reality).",
          "m3:hasFacetValue": [
            {
              "@id": "cartography:distortionProperty.Conformal"
            },
            {
              "@id": "cartography:graticuleGeometry.Cylindrical"
            }
          ]
        },
        {
          "@id": "m0.world2DProjection:Mollweide",
          "@type": "m0.world2DProjection:ProjectionAnchor",
          "rdfs:label": "Mollweide",
          "m0.world2DProjection:author": "Karl Mollweide",
          "m0.world2DProjection:year": "1805",
          "m0.world2DProjection:family": "Pseudocylindrical equal-area",
          "m0.world2DProjection:paramNote": "Elliptical boundary (2:1); central meridian straight, other meridians as ellipse arcs.",
          "m0.world2DProjection:role": "An equal-area world map: every region's area is exact; shapes shear toward the edges.",
          "m3:hasFacetValue": [
            {
              "@id": "cartography:distortionProperty.EqualArea"
            },
            {
              "@id": "cartography:graticuleGeometry.Pseudocylindrical"
            }
          ]
        },
        {
          "@id": "m0.world2DProjection:AzimuthalEquidistant",
          "@type": "m0.world2DProjection:ProjectionAnchor",
          "rdfs:label": "Azimuthal Equidistant",
          "m0.world2DProjection:author": "Classical (Postel, 1581; polar aspect used in the UN emblem)",
          "m0.world2DProjection:year": "1581",
          "m0.world2DProjection:family": "Azimuthal equidistant",
          "m0.world2DProjection:paramNote": "Distances and bearings from the single centre point are exact; distortion grows with distance from centre.",
          "m0.world2DProjection:role": "The centre-referenced map: correct distance and direction from one chosen point. Polar aspect is the flagship (Arctic at the centre).",
          "m3:hasFacetValue": [
            {
              "@id": "cartography:distortionProperty.Equidistant"
            },
            {
              "@id": "cartography:graticuleGeometry.Azimuthal"
            }
          ]
        },
        {
          "@id": "m0.world2DProjection:Robinson",
          "@type": "m0.world2DProjection:ProjectionAnchor",
          "rdfs:label": "Robinson",
          "m0.world2DProjection:author": "Arthur H. Robinson",
          "m0.world2DProjection:year": "1963",
          "m0.world2DProjection:family": "Pseudocylindrical compromise",
          "m0.world2DProjection:paramNote": "Defined by a lookup table (not a closed formula); tuned by eye to 'look right'. Adopted by National Geographic 1988-1998.",
          "m0.world2DProjection:role": "The compromise world map: preserves no invariant exactly, minimising overall visual error. The pragmatic default of the general-purpose atlas.",
          "m3:hasFacetValue": [
            {
              "@id": "cartography:distortionProperty.Compromise"
            },
            {
              "@id": "cartography:graticuleGeometry.Pseudocylindrical"
            }
          ]
        },
        {
          "@id": "m0.world2DProjection:GallPeters",
          "@type": "m0.world2DProjection:ProjectionAnchor",
          "rdfs:label": "Gall-Peters",
          "m0.world2DProjection:author": "James Gall (1855); popularised by Arno Peters (1967)",
          "m0.world2DProjection:year": "1855",
          "m0.world2DProjection:family": "Cylindrical equal-area",
          "m0.world2DProjection:paramNote": "Standard parallels at 45 deg; a rectangular equal-area grid.",
          "m0.world2DProjection:role": "Orthogonality proof: shares distortionProperty=EqualArea with Mollweide but graticuleGeometry=Cylindrical (not Pseudocylindrical). Same preserved invariant, different construction family -> the two facets are independent axes.",
          "m3:hasFacetValue": [
            {
              "@id": "cartography:distortionProperty.EqualArea"
            },
            {
              "@id": "cartography:graticuleGeometry.Cylindrical"
            }
          ]
        }
      ],
      "m0.world2DProjection:facetOrthogonality": {
        "claim": "distortionProperty and graticuleGeometry are independent classification axes.",
        "proof1": "Mollweide and Gall-Peters share distortionProperty=EqualArea yet differ in graticuleGeometry (Pseudocylindrical vs Cylindrical).",
        "proof2": "Mollweide and Robinson share graticuleGeometry=Pseudocylindrical yet differ in distortionProperty (EqualArea vs Compromise).",
        "consequence": "The two facets cross-cut the anchor set; neither is derivable from the other."
      },
      "m0.world2DProjection:territorySpace": {
        "description": "The terrestrial globe as observed phenomenon (the Territory).",
        "observer": "Human with geodetic instrumentation",
        "basis": "ASFID (Eagle Eye)",
        "asfidState": {
          "A": 0.7,
          "S": 0.85,
          "F": 0.3,
          "I": 0.8,
          "D": 0.25
        },
        "observables": [
          "Continents and coastlines",
          "Latitude/longitude graticule",
          "Great-circle distances",
          "Surface areas",
          "Intrinsic (Gaussian) curvature K > 0"
        ]
      },
      "m0.world2DProjection:mapSpace": {
        "description": "A 2D projection as theoretical model (the Map).",
        "observer": "Modern cartographer",
        "basis": "REVOI (Sphinx Eye)",
        "asfidState": {
          "A": 0.55,
          "S": 0.9,
          "F": 0.35,
          "I": 0.85,
          "D": 0.45
        },
        "asfidJustification": {
          "A": "Moderate attractor: each projection tends toward preserving its chosen invariant.",
          "S": "Very high structure: the graticule geometry is the projection's defining skeleton.",
          "F": "Low flow: a projection is a static point-to-point mapping (flow appears only under morphing).",
          "I": "High information: the projection encodes exactly which metric invariant is preserved.",
          "D": "Low-moderate dynamics: the parametric family / morphing is the only dynamic axis."
        },
        "reviState": {
          "R": 0.95,
          "E": 0.7,
          "V": 0.9,
          "O": 0.9,
          "I": 0.85
        }
      },
      "m0.world2DProjection:epistemicGap": {
        "formula": "Canonical scalar at root: m0:epistemicGap = |asfidMean - revoiMean| / sqrt(2) = |0.62 - 0.86| / sqrt(2) = 0.17.",
        "deltaVector": "(-0.15, +0.05, +0.05, +0.05, +0.20)  [Map ASFID - Territory ASFID]",
        "theoremaEgregium": "The DEEP gap is not statistical but proven: Gauss's Theorema Egregium (1827) shows Gaussian curvature is an isometric invariant. The sphere has K = 1/R^2 > 0; any flat map has K = 0. No distance-preserving map between them can exist, so every projection MUST distort. This is an IRREDUCIBLE epistemic gap - the Map can never fully equal the Territory. Full proof in the README.",
        "interpretation": "spectralClass = Liminal (0.15 <= delta1 < 0.30): a substantial, principled gap - which is the whole lesson of the poclet.",
        "assessment": "The projection is an excellent Map (high REVOI) of a Territory it provably cannot fully capture (Theorema Egregium)."
      },
      "m0.world2DProjection:revoi": {
        "description": "Sphinx Eye evaluation of the projection-as-Map (REVOI Map-Space).",
        "reviState": {
          "R": 0.95,
          "E": 0.7,
          "V": 0.9,
          "O": 0.9,
          "I": 0.85
        },
        "dimensionInterpretations": [
          {
            "dimension": "R (Representability)",
            "coefficient": 0.95,
            "interpretation": "Projections are the paradigm of representation: a globe rendered as a drawable, printable plane. Maximal.",
            "evidence": "Every atlas, wall map, and GIS layer."
          },
          {
            "dimension": "E (Evolvability)",
            "coefficient": 0.7,
            "interpretation": "New compromise projections keep appearing (Robinson 1963, Winkel Tripel adopted by NatGeo 1998, Natural Earth 2011).",
            "evidence": "Ongoing invention of general-purpose projections."
          },
          {
            "dimension": "V (Verifiability)",
            "coefficient": 0.9,
            "interpretation": "Distortion is exactly measurable (Tissot indicatrix, Girard spherical excess) and Theorema Egregium is a proven theorem.",
            "evidence": "Tissot 1859; Gauss 1827."
          },
          {
            "dimension": "O (Observability)",
            "coefficient": 0.9,
            "interpretation": "Distortion is directly visible to any viewer (Greenland vs Africa on Mercator).",
            "evidence": "The Mercator size-controversy is a public, naked-eye observation."
          },
          {
            "dimension": "Im (Interoperability)",
            "coefficient": 0.85,
            "interpretation": "Projections are standardised and shared globally via EPSG codes; any GIS reprojects between them.",
            "evidence": "EPSG registry, PROJ library, OGC standards."
          }
        ],
        "overallAssessment": "REVOI_mean = 0.86 -> a very high-quality Map of an un-fully-knowable Territory."
      },
      "m0.world2DProjection:transdisciplinaryAnalogy": {
        "principle": "Any lossy representation of a richer source forces a choice of which invariant to preserve.",
        "analogies": [
          {
            "domain": "Optics / Photography",
            "poclet": "Exposure Triangle",
            "note": "A single exposure cannot optimise motion, depth, and noise at once - a forced trade-off, like preserving angle vs area vs distance."
          },
          {
            "domain": "Image processing",
            "poclet": "Colour synthesis / gamut mapping",
            "note": "Projecting a wide gamut into a smaller one preserves either hue, or lightness, or saturation - never all."
          },
          {
            "domain": "Statistics",
            "poclet": "Dimensionality reduction (PCA / t-SNE)",
            "note": "Projecting high-dimensional data to 2D preserves either global variance or local neighbourhoods - the same Theorema-Egregium-shaped bind."
          }
        ]
      },
      "m0.world2DProjection:validation": {
        "asfidCompleteness": "All 5 dimensions present (A, S, F, It, D) - OK",
        "genericConceptCoverage": "11 M2 GenericConcepts mobilized - OK",
        "minimality": "4 canonical anchors span the closed distortion tetra-lemma (+1 orthogonality proof) - OK",
        "emergence": "The epistemic gap (Theorema Egregium) emerges from the sphere->plane relation, not from any single anchor - OK",
        "facetOrthogonality": "Proven by Gall-Peters vs Mollweide vs Robinson - OK",
        "frameworkFit": "Clean M3 (facet mechanism) -> M2 (Representation/Constraint/...) -> M1 (Cartography facets) -> M0 instantiation - OK"
      },
      "rdfs:seeAlso": [
        "cartography:DistortionProperty",
        "cartography:GraticuleGeometry",
        "m2:Representation",
        "m2:Constraint",
        "m2:Invariant"
      ],
      "dcterms:references": [
        "Gauss, C.F. (1827). Disquisitiones generales circa superficies curvas (Theorema Egregium).",
        "Tissot, N.A. (1859). Indicatrix of distortion.",
        "Snyder, J.P. (1987). Map Projections - A Working Manual (USGS PP 1395).",
        "Lapaine, M. & Francula, N. (2022). Classification of map projections by graticule geometry."
      ],
      "m1:simulationTitle": "World 2D Projection"
    }
  ]
