      "m0.fireTriangle:synergyPrinciple": {
        "formula": "Fuel × O₂ × Heat → Fire (emergent)",
        "description": "All three components required simultaneously",
        "emergentProperty": "Flame (self-sustaining exothermic reaction)",
        "nonLinearity": "1 + 1 + 1 ≠ 3, but = Fire (qualitative emergence)",
        "removal": "Eliminating ANY component stops combustion"
      },
      "m0.fireTriangle:constraints": [
        {
          "type": "Concentration",
          "parameter": "Fuel",
          "condition": "Above Lower Explosive Limit (LEL)"
        },
        {
          "type": "Concentration",
          "parameter": "O₂",
          "condition": "> 16% (typical for air)"
        },
        {
          "type": "Temperature",
          "parameter": "Heat",
          "condition": "> T_ignition (fuel-specific)"
        },
        {
          "type": "Mixing",
          "parameter": "Fuel-Oxidizer ratio",
          "condition": "Proper stoichiometry for complete combustion"
        }
      ],
      "m0.fireTriangle:process": {
        "name": "Combustion",
        "type": "m1.ext:chemistry:Combustion",
        "trigger": "Heat exceeds ignition threshold (m2:Trigger)",
        "mechanism": "Fuel vaporization → Mixing with O₂ → Oxidation → Heat + Light + Products",
        "products": [
          "CO₂",
          "H₂O",
          "Heat",
          "Light",
          "Ash/Smoke (incomplete combustion)"
        ],
        "energyBalance": "Exothermic (ΔH < 0)",
        "selfSustaining": "Yes (positive feedback loop)"
      },
