        "asfidJustification": {
          "A": "Moderate attractor (model has stability but fire dynamics are complex)",
          "S": "High structure (triangle = perfect geometry, orthogonal edges)",
          "F": "Low-moderate flow (conceptual model, not physical flux)",
          "I": "High information (3-component encoding, precise conditions)",
          "D": "Low dynamics (static diagram, not temporally evolving)"
