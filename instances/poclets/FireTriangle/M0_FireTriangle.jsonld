            "O₂",
            "Heat"
          ],
          "edges": [
            "Fuel-O₂ interaction",
            "O₂-Heat interaction",
            "Heat-Fuel interaction"
          ],
          "center": "Fire (emergent)"
        },
        "symbolism": "3-sided shape = 3 essential factors (remove any → no fire)"
      },
      "m0.fireTriangle:epistemicGap": {
        "formula": "Per-dimension ASFID divergence between Territory profile (observed fire) and Map profile (triangle model). Canonical scalar gap at root: m0:epistemicGap = |asfidMean − revoiMean| / √2.",
        "deltaVector": "(+0.10, -0.20, +0.30, -0.15, +0.25)",
        "interpretation": "Model captures the essence but simplifies reality; largest divergences on S, F, D (see below).",
        "assessment": "Model reasonably good - captures essence but simplifies reality",
        "majorDivergences": [
          {
            "dimension": "S (Structure)",
            "divergence": -0.2,
            "reason": "Triangle = perfect geometry; Real fire = irregular, fluctuating"
          },
          {
            "dimension": "F (Flow)",
            "divergence": 0.3,
            "reason": "Real fire = massive flows (gases, heat); Model = conceptual flows"
          },
          {
            "dimension": "D (Dynamics)",
            "divergence": 0.25,
            "reason": "Real fire = rapid, chaotic dynamics; Model = static representation"
          }
        ]
      },
      "m0.fireTriangle:revoi": {
        "description": "Sphinx Eye evaluation of Fire Triangle Map quality (REVOI Map-Space)",
        "perspective": "Philosophical interpretation using REVOI basis",
        "reviState": {
          "R": 0.9,
          "E": 0.7,
          "V": 0.95,
          "O": 0.8,
          "I": 0.9
        },
        "dimensionInterpretations": [
          {
            "dimension": "O (Observability)",
            "coefficient": 0.8,
            "interpretation": "Fire Triangle is highly observable as a model - can be drawn, visualized, taught. The triangle shape itself is immediately perceptible. Slightly lower than maximum because the model is abstract (not the fire itself).",
            "evidence": "Universal use in fire safety posters, training materials, educational content"
          },
          {
            "dimension": "R (Representability)",
            "coefficient": 0.9,
            "interpretation": "Excellently representable - simple geometric diagram with 3 labeled vertices. Minimal symbolism (triangle + 3 words). Easy to express in any language or medium.",
            "evidence": "Universally recognized symbol across cultures, languages, professions"
          },
          {
            "dimension": "I (Interoperability)",
            "coefficient": 0.9,
            "interpretation": "Highly shareable - Fire Triangle is international standard in fire safety. Same model used by firefighters, chemists, safety engineers, educators worldwide. No ambiguity in transmission.",
            "evidence": "ISO standards, NFPA guidelines, global fire safety curricula"
          },
          {
            "dimension": "V (Verifiability)",
            "coefficient": 0.95,
            "interpretation": "Extremely verifiable - Popper gold standard. Falsifiable prediction: 'Remove ANY component → fire stops.' Testable experimentally in seconds. Has been verified millions of times.",
            "evidence": "Fire extinguisher mechanisms (remove O₂, Heat, or Fuel), controlled experiments, everyday observation (blow out candle → remove O₂ → fire stops)"
          },
          {
            "dimension": "E (Evolvability)",
            "coefficient": 0.7,
            "interpretation": "Moderately evolvable - Model has been extended to Fire Tetrahedron (added 4th component: Chain Reaction) for more complete combustion theory. However, Triangle remains dominant in pedagogy due to simplicity.",
            "evidence": "Triangle → Tetrahedron evolution demonstrates revisability, but Triangle persists in basic training"
          }
        ],
        "overallAssessment": "Excellent Map - High REVOI across all dimensions. Fire Triangle is paradigmatic example of effective scientific model: observable, representable, shareable, testable, and evolvable.",
        "mapQuality": "REVOI_mean = 0.85 → Very high-quality Map",
        "comparisonToASFID": {
          "note": "ASFID measures Territory (fire phenomenon), REVOI measures Map (Triangle model). Both high values but different spaces.",
          "territoryASFID": "(A:0.85, S:0.70, F:0.90, I:0.65, D:0.75) - Physical fire",
          "mapREVOI": "(R:0.90, E:0.70, V:0.95, O:0.80, I:0.90) - Triangle model",
          "mappingF": "Unknown - relationship between ASFID and REVOI to be explored empirically"
        },
        "sphinxRiddle": {
          "question": "What has three legs but cannot walk, three sides but is not a shape, and dies when you remove any one of its parts?",
          "answer": "Fire Triangle - A model that represents a process, not a geometric object. Remove Fuel, O₂, or Heat → fire stops (system collapses).",
          "tradition": "Sphinx tradition of revealing truth through enigma"
        }
      },
