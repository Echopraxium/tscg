  "@graph": [
    {
      "@id": "instances/poclets/TscgCanopyGraphVizProto/M0_TscgCanopyGraphVizProto.jsonld",
      "@type": "owl:Ontology",
      "owl:imports": [
        "M3_GenesisGrammar.jsonld",
        "M2_GenericConcepts.jsonld",
        "M1_CoreConcepts.jsonld"
      ],
      "m3:ontologyType": { "@id": "m3:Poclet" },
      "rdfs:label": "TscgCanopyGraphVizProto",
      "rdfs:comment": "Serverless HTML prototype of an egocentric 3D graph visualiser. The observer stands INSIDE the graph at its barycentre and looks outward: nodes are celestial bodies, relations are constellations. A first-person 'jetpack' flies the observer along the gaze, so the same view continuously spans an interior vantage (inside the graph) and, by backing far enough out, an exterior one (the classic outside view); a right-click teleports the observer onto any node. Rendering is driven by a declarative STYLESHEET that is simultaneously the machine encoding and the on-screen legend, so the visualisation is itself a small representation ontology configured to the graph's semantics. This is the PROTOTYPE stage (single-file, BabylonJS from CDN, no server, no build); the mature ElectronJS tool is projected separately as TscgCanopyGraphViz (m3:TscgTool).",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "dcterms:created": "2026-07-27",
      "dcterms:modified": "2026-07-27",
      "owl:versionInfo": "0.1.0",
      "m1:domain": "TSCG",
      "m0:pocletType": "ToolPrototype",
      "m0:phenomenon": "Egocentric navigation of a graph/ontology from a mobile viewpoint, unifying interior (barycentre) and exterior vantages, with a stylesheet that binds representation to graph semantics.",
      "m0:maturityStatus": "Prototype — serverless HTML, single artifact; not yet the projected ElectronJS TscgTool.",
      "A_score":  { "@value": "0.82", "@type": "xsd:float" },
      "S_score":  { "@value": "0.86", "@type": "xsd:float" },
      "F_score":  { "@value": "0.78", "@type": "xsd:float" },
      "It_score": { "@value": "0.84", "@type": "xsd:float" },
      "D_score":  { "@value": "0.68", "@type": "xsd:float" },
      "R_score":  { "@value": "0.80", "@type": "xsd:float" },
      "E_score":  { "@value": "0.88", "@type": "xsd:float" },
      "V_score":  { "@value": "0.62", "@type": "xsd:float" },
      "O_score":  { "@value": "0.90", "@type": "xsd:float" },
      "Im_score": { "@value": "0.70", "@type": "xsd:float" },
      "m0:asfidMean": { "@value": "0.796", "@type": "xsd:float" },
      "m0:revoiMean": { "@value": "0.780", "@type": "xsd:float" },
      "m0:epistemicGap": { "@value": "0.016", "@type": "xsd:float" },
      "m0:spectralClass": "Coherent",
      "m0:scoreJustification": {
        "A_score": "One stable attractor — bring a large graph into a legible, navigable field. Interior and exterior views are two poses of the same goal, not competing goals.",
        "S_score": "Clear separation of concerns: DATA (typed nodes/edges) | LAYOUT STRATEGY (a library selected as a style channel) | STYLE (the stylesheet = the legend). Three files with an explicit boundary.",
        "F_score": "Well-defined flows: load data -> spanning forest -> layout -> render; hover/right-click -> action; fold policy -> derived visibility. Some flows (magnitude from degree) are provisional.",
        "It_score": "Rich structure surfaced: layer, kind, facet, magnitude, containment vs contract, recovered spectral clusters, Visible/Observed counts.",
        "D_score": "Several interacting subsystems (instrument, folding LRU, cone slices, radar, structure recovery). Moderate; not fully stabilised at v0.1.",
        "R_score": "The M0 faithfully represents the prototype's architecture, controls, and stylesheet principle. Reduced because the shipped data is a synthetic fixture, not the live corpus.",
        "E_score": "Explicitly a way-to-explore, not a finished claim: the stylesheet, layout library and data adapter are each designed to be swapped and grown.",
        "V_score": "Lowest score, honestly: verification is headless smoke tests plus manual on-screen inspection. Visual behaviour (occlusion, billboarding, event order) is not machine-verified — a real limitation, not a rounding.",
        "O_score": "Everything the observer needs is on screen: field angle, seeing magnitude, Visible/Observed, folded-mass brightness, a generated legend, an egocentric radar.",
        "Im_score": "Plain HTML + BabylonJS + a single data adapter emitting {nodes, edges}; portable to Neo4j/GEXF inputs. Reduced because the default stylesheet is TSCG-flavoured."
      },
      "m0:mobilizedGenericConcepts": [
        { "GenericConcept": "Observer", "role": "The viewpoint is a first-class entity placed at the graph barycentre; the layout is computed from it, and it can be teleported." },
        { "GenericConcept": "Representation", "role": "The stylesheet is an explicit, editable representation layer; changing it changes both render and legend." },
        { "GenericConcept": "Layer", "role": "The M3->M2->M1->M0 strata drive the cone arrangement and the meta radial axis." },
        { "GenericConcept": "Hierarchy", "role": "Containment (single-valued relations) builds the folding forest; contracts (multi-valued) stay lateral." },
        { "GenericConcept": "Composition (Decomposition)", "role": "Folding composes a subtree into one bright body and decomposes it back on demand; magnitude of a folded star encodes hidden mass." },
        { "GenericConcept": "Emergence", "role": "Structure recovery (spectral clustering, trophic levels) lets grouping emerge from usage links, to be compared against declared facets — a Map/Territory signal." }
      ],
      "m0:territoryVsMapAnalysis": {
        "territory": "The typed graph itself — nodes and edges with their declared relations (the data adapter's output).",
        "map": "The stylesheet-driven rendering — glyph, hue, magnitude, arrangement, legend — a chosen, defeasible representation of that territory.",
        "reflexivity": "The tool embodies the very Map/Territory distinction it helps explore: the observer stands in the territory (barycentre) yet reads a map (the stylesheet), and can step out to see the map whole. The measurable gap between recovered clusters and declared facets is a delta-1 epistemic signal surfaced by the tool on its own subject matter."
      },
      "m0:architecture": {
        "m0:files": {
          "M0_CanopyGraphviz.html": "Markup shell only; loads external modules in order data -> stylesheet -> core.",
          "src/canopy-data.js": "DATA adapter — emits {nodes, edges}. The single file to replace for real data (JSON-LD / Neo4j / GEXF).",
          "src/canopy-stylesheet.js": "STYLE — the declarative encoding, and the source the on-screen legend is generated from.",
          "src/canopy-core.js": "CORE — domain-agnostic engine: layout strategies, structure recovery, rendering, radar, interaction, legend generation.",
          "src/canopy.css": "Panel presentation.",
          "test/boot-smoke.js": "Headless full-initialisation smoke test."
        },
        "m0:viewpointModes": {
          "interior": "Default. First-person camera at the graph barycentre, looking outward through the 'canopy'.",
          "exterior": "Reached by flying back with the jetpack, or by 'Teleport outside', which frames the whole graph broadside — for the cone arrangement, a side-on vantage so strata separate.",
          "teleport": "Right-click a node -> the observer re-centres on it; the layout re-forms around the new vantage."
        },
        "m0:arrangements": ["canopy", "clusters", "cone", "nautilus"],
        "m0:radialAxes": ["tree", "subclass", "meta", "hops", "trophic"]
      },
      "m0:stylesheetPrinciple": {
        "description": "Rendering is driven by a single declarative STYLESHEET object with two faces: the machine encoding that positions and paints every node, and the on-screen legend generated from that same object. Shape encodes node KIND, hue encodes a chosen FACET, size and brightness encode MAGNITUDE, position is a LAYOUT strategy chosen as a style channel.",
        "asOntology": "Because the stylesheet declares how graph semantics map to visual variables, it is itself a small representation ontology — a second-order Map. Different stylesheets are different Maps of the same Territory, and travel with the view.",
        "deferred": "Formalising the stylesheet as an OWL+SHACL ontology is deliberately DEFERRED for a single-author prototype (it would be OntologicalOverfitting); the mature TscgTool is the place for it."
      },
      "m0:technologyStack": {
        "runtime": "Serverless static HTML; no server, no build step, no bundler.",
        "rendering": "BabylonJS 6.49.0 (loaded from CDN).",
        "structureRecovery": "Pure JS — normalized-Laplacian spectral clustering (power iteration + k-means), trophic levels.",
        "testing": "Headless boot-smoke (stubbed DOM + Babylon) plus manual on-screen inspection."
      },
      "m0:knownLimitations": [
        "Rendering does not yet scale to the full corpus (one mesh + one material per node, per-edge meshes rebuilt on relayout); edge-merge and shared materials are the first fixes, instancing later.",
        "Magnitude is derived from degree — the crudest centrality — over all relation types; corpus properties (epistemicGap, asfidMean, revoiMean) would be more meaningful drivers.",
        "Concentric shells saturate with depth (area grows as r^2, node count as b^d); the nautilus arrangement addresses this, folding and the seeing limit postpone it elsewhere.",
        "The shipped data is a synthetic fixture matched to the corpus's proportions, not the live M0-M3 graph; the JSON-LD parser is the next milestone.",
        "Verification of visual behaviour (occlusion, billboarding, browser event order) is manual, not machine-checked — the honest reason V_score is low."
      ],
      "m0:futureExtensions": [
        "Replace the data adapter with a real M0-M3 JSON-LD parser (node/edge policy already specified: filter schema plumbing, key on full prefixed IRIs, cardinality-based containment).",
        "Promote to the ElectronJS TscgTool 'TscgCanopyGraphViz' with a fuller stylesheet engine and support for arbitrary graphs/ontologies beyond TSCG.",
        "Magnitude driven by epistemic/ASFID/REVOI properties instead of degree.",
        "Rendering optimisation (edge LineSystem merge, shared materials, thin-instance glyphs)."
      ],
      "m0:pedagogicalValue": "Shows a newcomer that a large ontology can be entered and walked rather than only diagrammed, and makes the Map/Territory distinction tangible by letting the observer stand inside the Territory while reading a Map they can edit and step out of.",
      "m0:summary": "A serverless prototype proposing egocentric, jetpack-navigated graph visualisation with a stylesheet that is at once encoding and legend — offered as a way to explore graph visualisation, not as a finished tool.",
      "m2:changelog": [
        {
          "version": "0.1.0",
          "date": "2026-07-27",
          "changes": "Initial M0 specification for the serverless Canopée prototype, typed m3:Poclet. Mobilizes Observer, Representation, Layer, Hierarchy, Composition, Emergence. Documents interior/exterior/teleport viewpoints, the stylesheet-as-second-order-Map principle, and honest limitations (rendering scale, degree-based magnitude, manual visual verification)."
        }
      ],
      "m1core:simulationTitle": "Canopy — egocentric graph star-map (prototype)",
      "rdfs:seeAlso": "instances/poclets/TscgCanopyGraphVizProto/M0_TscgCanopyGraphVizProto_README.md",
      "dcterms:references": "https://echopraxium.github.io/tscg/"
    }
  ]
}
