#!/bin/sh
# git am: the patch's author is in rebase-apply/author-script (not in the environment)
f="$(git rev-parse --git-path rebase-apply/author-script)"
[ -f "$f" ] || exit 0
name=$(sed -n "s/^GIT_AUTHOR_NAME='\(.*\)'$/\1/p" "$f")
mail=$(sed -n "s/^GIT_AUTHOR_EMAIL='\(.*\)'$/\1/p" "$f")
exec sh "$(git rev-parse --show-toplevel)/.githooks/check-author.sh" "$name <$mail>"
