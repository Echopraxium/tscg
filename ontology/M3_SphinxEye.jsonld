{
  "@context": {
    "@base": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/",
    "dcterms": "http://purl.org/dc/terms/",
    "adms": "http://www.w3.org/ns/adms#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "m3": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M3_GenesisGrammar.jsonld#"
  },
  "@graph": [
    {
      "@id": "m3:sphinx_eye:SphinxEye",
      "@type": "owl:Ontology",
      "owl:versionInfo": "3.13.0",
      "dcterms:created": "2026-01-21",
      "dcterms:modified": "2026-10-10",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "dcterms:description": "Map Grammar Gm — the Map perspective of TSCG (how a system is known; metaphoric name: Sphinx Eye). Free commutative monoidal grammar over the primitive types {R, E, V, O, Im} (Map types 𝕋₀(+)), operator +. At M0, each primitive type receives a score in [0,1] for a given instance (m0:revoiScores). These scores are provisional: stipulated by the TSCG Architects (KitArchitect role) and not yet validated by users or validators outside that role. Their credibility grows by accretion, as independent evaluations converge (m3:grammar_foundation:intersubjectiveBenchmark, defeasibilityStatus); they are not factual measurements. The epistemic gap δ₁ is computed from them. See TSCG_StructuralGrammar_as_Mathematical_Foundation_README.md.",
      "m3:ontologyCategory": {
        "@id": "m3:GenesisExtension"
      },
      "owl:imports": [
        { "@id": "M3_GrammarFoundation.jsonld" }
      ],
      "rdfs:label": "Sphinx Eye - Map Grammar Gm",
      "m3:ontologyType": {
        "@id": "m3:GenesisExtension"
      },
      "m3:metaphoricLabel": "Sphinx Eye",
      "metadata": {
        "layer": "M3",
        "name": "Sphinx Eye - REVOI Basis",
        "version": "3.5.0",
        "date_created": "2026-01-21",
        "date_modified": "2026-05-18",
        "authors": [
          "Echopraxium with the collaboration of Claude AI"
        ],
        "description": "REVOI basis for Map construction through synthetic composition"
      },
      "parent_ontology": {
        "@id": "m3:genesis_space:GenesisGrammar",
        "relationship": "component_of",
        "dcterms:description": "Sphinx Eye is the REVOI component of M3 Genesis Grammar, providing the synthetic perspective on systems"
      },
      "grammar_properties": {
        "grammar_name": "Map Grammar Gm",
        "grammar_type": "free_commutative_monoidal",
        "primitives": [
          "R",
          "E",
          "V",
          "O",
          "I"
        ],
        "product": "+",
        "primitive_role": "generators of Map type expressions (epistemic quality signatures)",
        "functor_role": "F_R, F_E, F_V, F_O, F_I : System → (M0 numeric ValueSpace)  (evaluation morphisms at M0)",
        "perspective": "epistemic / representational",
        "independence": "verified  (no primitive derivable from others)",
        "mathematical_foundation": "Commutative Lambek calculus / free commutative monoidal categories (Lambek 1958, commutative variant; MacLane 1963)",
        "operator": "+ (Map structural sum — intra-REVOI)",
        "neutral_element": "m3:grammar_foundation:EmptyMap",
        "neutral_element_label": "Empty Map (neutral of +)",
        "neutral_element_semantic": "Empty pentagon — absence of all REVOI types"
      },
      "grammatical_note": {
        "form": "Adjective (qualificatif)",
        "m3:rationale": "Simplified from abstract nouns (-ability) to adjectives (-able) for consistency and brevity. Mirrors ASFID which uses concrete nouns (Attractor, Structure, Flow, Information, Dynamics).",
        "comparison": {
          "ASFID": "Nouns (substantifs concrets)",
          "REVOI_v2": "Abstract nouns ending in -ity (substantifs abstraits)",
          "REVOI_v3": "Adjectives ending in -able (adjectifs qualificatifs)"
        },
        "advantages": [
          "Shorter (5-7 characters saved per type)",
          "More natural in French (représentable, vérifiable, observable, interopérable)",
          "Grammatically parallel (all adjectives)",
          "Easier to use in sentences (e.g., 'is representable' vs 'has representability')"
        ]
      },
      "metaphor": {
        "image": "Sphinx posing riddles at the crossroads",
        "wisdom": "Enigmatic knowledge that constructs understanding",
        "action": "Constructs, synthesizes, composes",
        "domain": "Map (Model)",
        "perspective": "From within, participatory view",
        "symbolic_nature": "Half-human (reason) half-lion (instinct)"
      },
      "dual_axes_position": {
        "model_reality_axis": "Model",
        "analysis_synthesis_axis": "Synthesis",
        "quadrant": "Synthesis of Model (Map)"
      },
      "independence_matrix": {
        "dcterms:description": "The 5 primitive types {R,E,V,O,Im} are analytically independent — no primitive type is derivable from the others",
        "verified": "true",
        "skos:note": "Independence here means conceptual non-redundancy, not metric orthogonality. No inner product is defined or required."
      },
      "coupling_with_TerritoryGrammar": {
        "dcterms:description": "Map Grammar Gm and Territory Grammar Gt are connected via natural transformations (category theory). Gm and Gt are structurally separate grammars — their separation is fundamental, not a consequence of orthogonality.",
        "natural_transformations": {
          "Phi": {
            "symbol": "Φ",
            "signature": "Φ : Gt → Gm",
            "role": "Observation — Territory measurements inform Map construction"
          },
          "Psi": {
            "symbol": "Ψ",
            "signature": "Ψ : Gm → Gt",
            "role": "Interpretation — Map predictions guide Territory measurement strategies"
          }
        },
        "epistemic_gap": {
          "symbol": "δ₁",
          "formula": "||ASFID_mean − REVOI_mean|| / √2",
          "meaning": "Measure of non-isomorphism of Φ — Korzybski principle: Φ is never a perfect isomorphism"
        },
        "korzybski": "The map is not the territory — Gm ≠ Gt structurally, δ₁ > 0 in all real systems",
        "see_also": "M3_GenesisGrammar.jsonld for complete bicephalous architecture"
      },
      "complementary_grammar": {
        "@id": "m3:eagle_eye:EagleEye",
        "dcterms:description": "Eagle Eye provides Territory Grammar Gt over primitive types {A,S,F,I,D}, complementing Sphinx's Map Grammar Gm",
        "relationship": "structurally_complementary",
        "complete_architecture": "TSCG Bicephalous Architecture = Gt (Territory) + Gm (Map) — Gs (Stereopsis) is the reification of their stereopsic synergy"
      },
      "m3:changelog": [
        {
          "owl:versionInfo": "3.13.0",
          "dcterms:date": "2026-10-10",
          "adms:versionNotes": "ONE ROLE, ONE PROPERTY — batch 1 (Michel, 2026-10-10): the owl:Ontology header keeps dcterms:description only; the former rdfs:comment, a paraphrase, is merged into it and removed. Fixed on the way: {R, E, V, O, I} → {R, E, V, O, Im} in the description; M0 scores numeric, provisional; F_x notation dropped; 'bicephalous architecture' dropped."
        },
        {
          "owl:versionInfo": "3.12.0",
          "dcterms:date": "2026-10-08",
          "adms:versionNotes": "WS-5 DEBT LOT (A), decision Michel 2026-10-08 (Debt Overview §8.0): m3:ontologyType m3:GenesisExtension (one of the three perspectives of Genesis) and m3:metaphoricLabel \"Sphinx Eye\", both declared in the apex M3_GrammarFoundation. Also (S5-1): the alphabet written {R,E,V,O,I} in two texts (header comment, independence note) is now {R,E,V,O,Im} — the I of REVOI is always suffixed. Formalism named precisely (Michel, 2026-10-10): the COMMUTATIVE Lambek calculus — Lambek's 1958 calculus is non-commutative; the three TSCG operators ×, +, | are commutative on the types of their monoid, primitive or derived. Precedence unchanged: × (Gt) > + (Gm) > | (Gs)."
        },
        {
          "owl:versionInfo": "3.11.0",
          "dcterms:date": "2026-10-06",
          "adms:versionNotes": "WS-5 DEBT LOT (2a), decision D5(a) (Michel, 2026-10-06): removed the legacy 'changelog' object from the 'metadata' block (option i: dropped, not folded). Its entries (v3.3.0, v3.2.0, v3.1.0) predate the m3:changelog entries kept here and remain in git history; folding them would have exceeded the 7-entry M3 window. The only changelog is m3:changelog on the owl:Ontology node."
        },
        {
          "owl:versionInfo": "3.10.0",
          "dcterms:date": "2026-09-30",
          "adms:versionNotes": "WS-1 VOCABULARY CONSOLIDATION, lot 1i. owl:imports written as plain strings (JSON-LD literals: no reasoner followed them, so this file was reasoned in isolation and the apex declarations of M3_GrammarFoundation were invisible to it) rewritten as IRIs {\"@id\": ...}: 1 import(s). Target = the imported file's document URL, resolved by @base (Michel, 2026-09-30: aligning ontology IRIs with document URLs is recorded as a later lot). Triage: ontology/docs/_01_Worksite/WS-1/WS-1_FamilyA_Triage.md."
        },
        {
          "owl:versionInfo": "3.9.0",
          "dcterms:date": "2026-09-30",
          "adms:versionNotes": "WS-1 VOCABULARY CONSOLIDATION, lot 1g (Family A). Bare keys (dropped on JSON-LD expansion) replaced: alternative_names -> skos:altLabel, comment -> dcterms:description (consistent with lot 1b), note -> skos:note, definition -> skos:definition, label -> rdfs:label, title -> dcterms:title, id -> dcterms:identifier, rationale -> m3:rationale (declared in M3_GrammarFoundation, rdfs:subPropertyOf skos:note). In this file: rationale 1, note 1. Triage: ontology/docs/_01_Worksite/WS-1/WS-1_FamilyA_Triage.md."
        },
        {
          "owl:versionInfo": "3.8.0",
          "dcterms:date": "2026-09-30",
          "adms:versionNotes": "WS-1 VOCABULARY CONSOLIDATION, lot 1c (Family A). Changelog entry keys, previously bare and dropped on JSON-LD expansion, replaced by standards: version -> owl:versionInfo, date -> dcterms:date, changes -> adms:versionNotes (ADMS: a description of changes between this version and the previous one). Prefix adms declared in @context: ADMS accepted as an external vocabulary (Michel, 2026-09-30). Changelog entries become graph-visible. Legacy changelog forms (maps keyed by version, metadata blocks) left for a separate lot. Triage: ontology/docs/_01_Worksite/WS-1/WS-1_FamilyA_Triage.md."
        },
        {
          "owl:versionInfo": "3.7.0",
          "dcterms:date": "2026-09-30",
          "adms:versionNotes": "WS-1 VOCABULARY CONSOLIDATION, lot 1b (Family A). Bare key 'description' (declared in no @context, hence dropped on JSON-LD expansion) replaced by the standard dcterms:description (DCMI: an account of the resource; literal). Chosen over rdfs:comment on semantic grounds (Michel, 2026-09-30). 4 occurrences, all under bare parent keys: they stay graph-invisible until those are resolved (later WS-1 lot). Bare 'description' inside legacy 'metadata' blocks left untouched (separate lot). No semantic change: documentation made graph-visible. Triage: ontology/docs/_01_Worksite/WS-1/WS-1_FamilyA_Triage.md."
        }
      ]
    },
