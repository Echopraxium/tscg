    sc9  [label="SC-9 tensor purge\n(~13 canonical occ., bulk in M0)", fillcolor="#b2dfdb", color="#00695c"];
    sc5  [label="SC-5 domain fusion Phase 0\nHIGH risk", fillcolor="#b2dfdb", color="#00695c"];
