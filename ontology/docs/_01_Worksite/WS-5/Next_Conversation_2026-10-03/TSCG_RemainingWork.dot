    sc11a[label="SC-11a M2 grammar, doc plane\n(ready)\noverlaps WS-5 step (2)", fillcolor="#b2dfdb", color="#00695c"];
    sc348[label="SC-3 design-decided, SC-4 scoped,\nSC-8 FeedbackLoop, SC-0/SC-7 staged", fillcolor="#e0f2f1", color="#00695c"];
  }

  // ================= Parked findings (side) =================
  subgraph cluster_parked {
    label="Parked findings (no lot yet)"; style="rounded,dashed"; color="#757575"; fontcolor="#616161"; fontsize=14;
    p1 [label="M1_Domains lacks m2\n(the 1 M1 warning left)\n-> SC-6", fillcolor="#eeeeee", color="#9e9e9e", style="rounded,filled,dashed"];
    p2 [label="196 rdfs:subClassOf literals\n(M1 SHACL debt)\n-> SC-6", fillcolor="#eeeeee", color="#9e9e9e", style="rounded,filled,dashed"];
    p3 [label="Dangling m1:Accretion, m1:Nucleation,\nTrophicPyramid combo props\n-> B1", fillcolor="#eeeeee", color="#9e9e9e", style="rounded,filled,dashed"];
    p4 [label="\"m3:eagle_eye:Flow\" literals in M1\n(term not defined by M3)\n-> WS-9", fillcolor="#eeeeee", color="#9e9e9e", style="rounded,filled,dashed"];
    p5 [label="Stale docs: CLAUDE.md, simulation-skill\ndead paths", fillcolor="#eeeeee", color="#9e9e9e", style="rounded,filled,dashed"];
    p6 [label="C12 scans changelog prose\n(known over-reach) -> check_m0", fillcolor="#eeeeee", color="#9e9e9e", style="rounded,filled,dashed"];
    p7 [label="WS-6 note says canonical changelog =\nnested metadata block (stale since 1c/1d)\n-> WS-6", fillcolor="#eeeeee", color="#9e9e9e", style="rounded,filled,dashed"];
  }

  // ---------- vertical order of the rows (invisible) ----------
  done_dec -> e1 [style=invis];
  e4 -> b1 [style=invis];
  b2l -> ws3 [style=invis]; ws3 -> ws6 [style=invis]; ws6 -> ws9 [style=invis]; ws9 -> ws11 [style=invis]; ws11 -> ws12 [style=invis];
  ws4 -> ws10 [style=invis]; ws10 -> ws9 [style=invis];
  sc6 -> sc9 [style=invis]; sc9 -> sc5 [style=invis]; sc5 -> sc10 [style=invis]; sc10 -> sc11a [style=invis]; sc11a -> sc348 [style=invis];
  p1 -> p2 [style=invis]; p2 -> p3 [style=invis]; p3 -> p4 [style=invis]; p4 -> p5 [style=invis]; p5 -> p6 [style=invis]; p6 -> p7 [style=invis];

  // ---------- dependencies WRITTEN in a source (solid) ----------
  done_ctx5 -> e2   [label="unblocks D7\n(scoping §4)"];
  done_dec  -> e1   [label="Q1 (a): engine"];
  e1 -> e3          [label="job one\n(worksite map)"];
  e2 -> e4          [label="doc plane first\n(HandOver)"];
  e3 -> e4;
  e4 -> b1          [label="checks lock\nevery B1/B2 lot\n(HandOver)"];
  b1 -> b2d         [label="planned order"];
  b2d -> b2l;
  rename -> lot1k   [dir=both, label="linked\n(decided today)"];
  canon -> ws10     [label="prerequisite\n(WS-5 yaml)"];
  ws10 -> ws9       [label="after WS-10\n(WS-9 yaml)"];
  b2l -> ws11       [label="SC-11b blocked\nby WS-1"];
  frb -> sc9        [label="makes SC-9\nmeasurable"];
  dup -> sc5        [label="makes SC-5\nmeasurable"];
  ws3 -> ws11       [label="GR-M3-b risk:\nM3 still evolving"];
  ws7 -> ws11;
  sc9 -> ws11;
  sc10 -> ws11;
  m0voc -> ws10     [label="one of the\noptions"];
  m0voc -> ws9;
  ws11 -> ws12      [label="after WS-11\n(WS-12 yaml)"];

  // ---------- dependencies PROPOSED by Claude (dashed purple) ----------
  edge [style=dashed, color="#7b1fa2", fontcolor="#7b1fa2", penwidth=1.6];
  e4 -> rename      [label="proposed: gate\nlocks M3/M2 first"];
  e4 -> vest        [label="proposed"];
  b2d -> vocab      [label="proposed"];
  e4 -> sc6         [label="proposed: SC-6 repairs\nmeasured by the gate"];

  // ---------- overlap / feeds (dotted grey) ----------
  edge [style=dotted, color="#9e9e9e", fontcolor="#757575", penwidth=1.3];
  famA -> b2l;

  { rank=same; done_ctx5; done_notes; done_dec; done_tools; }
  { rank=same; e1; e2; canon; frb; dup; nottyp; }
  { rank=same; ws3; ws4; }
  { rank=same; ws6; ws10; ws7; ws8; }
}
