    {
      "@id": "schema:value",
      "@type": "owl:AnnotationProperty",
      "rdfs:isDefinedBy": {
        "@id": "https://schema.org/"
      },
      "rdfs:comment": "schema.org: 'The value of a QuantitativeValue (including Observation) or property value node.' Used on the {rdfs:label, schema:value} nodes of skos:example lists (name / value pairs); replaces rdf:value, a reserved IRI that cannot be declared in OWL 2 DL (WS-1 lot 1h).",
      "dcterms:created": "2026-09-30"
    },
    {
      "@id": "m3:grammar_foundation:Fm2",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Fm2 — GenericConcept Combination (function)",
      "rdfs:comment": "Producing FUNCTION for GenericConceptCombos. Fm2 : GenericConcept²⁺ → GenericConceptCombo. Fm2 is NOT a morphism and NOT a functor: its essence is combination with EMERGENCE, which is non-compositional, while a morphism/functor must preserve composition. (The word 'functor' stays reserved for M0 dimension evaluation F_x : System → Score.) Consequently a combo has NO monoidal expansion: its formula IS this signature. Arguments are ≥2 NAMED CONCEPTS declared in M2_GenericConcepts.jsonld or M1_CoreConcepts.jsonld — never primitive types, never a monoidal expression, juxtaposed by comma and never joined by a grammar operator (×, +, |). Supersedes the retired ⊗⇒ notation.",
      "skos:example": "Fm2(Memory, Entropy) = Inertia  |  Fm2(Incoherence, Invariant) = TopologicalDefect  |  Fm2(Process, Step, Trajectory) = PipelineProcess",
      "m3:grammar_foundation:signature": "Fm2 : GenericConcept²⁺ → GenericConceptCombo",
      "m3:grammar_foundation:operatesAt": "𝕋₁ (GenericConcept level — not 𝕋₀ primitive level)",
      "rdfs:domain": {
        "@id": "m3:MonoidalType"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "dcterms:created": "2026-05-20",
      "m3:grammar_foundation:kind": "function",
      "m3:grammar_foundation:functionFamily": "MORPHISMS: Φ (Gt→Gm), Ψ (Gm→Gt) — structure-preserving, they compose. FUNCTIONS: Fm2, Fm1m2 — emergence, non-compositional, they do NOT compose."
    },
    {
      "@id": "m3:grammar_foundation:Fm1m2",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Fm1m2 — Domain + GenericConcept Combination (function)",
      "rdfs:comment": "Producing FUNCTION for DomainConceptCombos. Fm1m2 : Domain⁺, GenericConcept⁺ → DomainConceptCombo. A HYBRID of at least one Domain and at least one GenericConcept. ⚠ CORRECTION (SC-1, 2026-07-12): Fm1m2 does NOT mean 'the function that crosses the M1/M2 boundary'. That earlier reading was wrong and propagated into the corpus (e.g. Fm1m2(Cascade, Duplication, Network), which has no Domain and is really an Fm2). What distinguishes Fm1m2 from Fm2 is DOMAIN QUALIFICATION — nothing else. An Fm2 argument may legitimately be a named concept from M1_CoreConcepts, so 'crossing M1/M2' distinguishes nothing. Both slots are non-empty; the Domain × Concept hybridisation IS the emergence, so one concept argument suffices. Multi-domain conjunction is carried by juxtaposed domain arguments — Fm1m2(Biology, Chemistry, Catalysis); there is no Fm1 and no reification of composite domains. Fm1m2 is NOT a morphism and NOT a functor (emergence is non-compositional). Supersedes the retired ⊗⇒ notation.",
      "skos:example": "Fm1m2(Biology, Process) = BiologicalProcess  |  Fm1m2(Physics, Coherence) = LaserCoherence  |  Fm1m2(Education, Memory, Structure) = CurriculumDesign",
      "m3:grammar_foundation:signature": "Fm1m2 : Domain⁺, GenericConcept⁺ → DomainConceptCombo",
      "m3:grammar_foundation:operatesAt": "M1/M2 boundary — domain-specific instantiation of generic patterns",
      "rdfs:domain": {
        "@id": "m3:MonoidalType"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "dcterms:created": "2026-05-20",
      "m3:grammar_foundation:kind": "function",
      "m3:grammar_foundation:functionFamily": "MORPHISMS: Φ (Gt→Gm), Ψ (Gm→Gt) — structure-preserving, they compose. FUNCTIONS: Fm2, Fm1m2 — emergence, non-compositional, they do NOT compose."
    },
    {
      "@id": "m3:grammar_foundation:SpecialElements",
      "@type": "owl:NamedIndividual",
      "rdfs:label": "TSCG Special Elements — Neutral and Limit Elements",
      "rdfs:comment": "Registry of the four special elements of the TSCG monoidal grammar system: neutral elements of ×, +, | and the pseudo-absorbent of |.",
      "dcterms:created": "2026-05-20",
      "EmptyTerritory": {
        "@id": "m3:grammar_foundation:EmptyTerritory",
        "rdfs:label": "Empty Territory",
        "rdfs:comment": "Neutral element of ×. Absence of all ASFID types. A × EmptyTerritory = A for all A ∈ 𝕋₀(×).",
        "m3:grammar_foundation:grammar": "Gt",
        "m3:grammar_foundation:operator": "×",
        "m3:grammar_foundation:role": "neutral_element",
        "m3:grammar_foundation:visual": "Black — absence of all ASFID types"
      },
      "EmptyMap": {
        "@id": "m3:grammar_foundation:EmptyMap",
        "rdfs:label": "Empty Map",
        "rdfs:comment": "Neutral element of +. Absence of all REVOI types. R + EmptyMap = R for all R ∈ 𝕋₀(+).",
        "m3:grammar_foundation:grammar": "Gm",
        "m3:grammar_foundation:operator": "+",
        "m3:grammar_foundation:role": "neutral_element",
        "m3:grammar_foundation:visual": "Empty pentagon — absence of all REVOI types"
      },
      "StereopsisEmptySet": {
        "@id": "m3:odins_wisdom.StereopsisEmptySet",
        "rdfs:label": "Stereopsis Empty Set",
        "rdfs:comment": "Neutral element of |. Defined as EmptyTerritory | EmptyMap. Divergent Strabismus — δ₁ = max. x | StereopsisEmptySet = x for all x.",
        "m3:grammar_foundation:grammar": "Gs",
        "m3:grammar_foundation:operator": "|",
        "m3:grammar_foundation:role": "neutral_element",
        "m3:grammar_foundation:visual": "Black + Empty pentagon",
        "m3:grammar_foundation:epistemicGap": "δ₁ = max",
        "m3:grammar_foundation:definition": "EmptyTerritory | EmptyMap",
        "m3:grammar_foundation:semantics": "Divergent Strabismus — Territory and Map share nothing"
      },
      "StereopsisUniversalSet": {
        "@id": "m3:odins_wisdom.StereopsisUniversalSet",
        "rdfs:label": "Stereopsis Universal Set",
        "rdfs:comment": "Pseudo-absorbent of |. Defined as 𝕋₀(×) ∪ 𝕋₀(+) ∪ 𝕋₀(|) = 𝕋₀ (16 primitives — Base16). StereopsisUniversalSet | a = StereopsisUniversalSet for all a. Degenerate limit — Borges 1:1 map paradox. Distinct from SpectralClass Coherent (δ₁ ≈ 0).",
        "m3:grammar_foundation:grammar": "Gs",
        "m3:grammar_foundation:operator": "|",
        "m3:grammar_foundation:role": "pseudo_absorbent",
        "m3:grammar_foundation:visual": "White + Full pentagon",
        "m3:grammar_foundation:epistemicGap": "δ₁ = 0",
        "m3:grammar_foundation:definition": "𝕋₀(×) ∪ 𝕋₀(+) ∪ 𝕋₀(|)",
        "m3:grammar_foundation:semantics": "Convergent Strabismus — degenerate limit, not a semantic ideal"
      }
    },
    {
      "@id": "m3:ontologyType",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Ontology Type",
      "rdfs:comment": "Specifies the architectural type of a TSCG ontology. Value must be an instance of m3:TscgOntologyType (e.g. m3:Poclet, m3:Genesis, m3:DomainExtension). Enables both OWL reasoning (subClassOf hierarchy) and SKOS navigation (ConceptScheme). Renamed from m3:ontologyCategory in v3.3.0.",
      "skos:definition": "A framework-level architectural property that specifies the position and role of an ontology within the TSCG metamodel hierarchy through reference to a controlled vocabulary defined as a skos:ConceptScheme.",
      "rdfs:domain": {
        "@id": "owl:Ontology"
      },
      "rdfs:range": {
        "@id": "m3:TscgOntologyType"
      },
      "dcterms:created": "2026-01-27",
      "dcterms:modified": "2026-01-27",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "skos:editorialNote": "Defined in M3 (Genesis Space) because it is a foundational metamodel property needed by all layers. M3 has no dependencies, ensuring m3:ontologyCategory is always available without creating circular dependencies.",
      "skos:changeNote": "v3.3.0: Renamed from m3:ontologyCategory to m3:ontologyType for clarity. Range changed from m3:OntologyCategoryScheme (incorrect — was the ConceptScheme, not a concept) to m3:TscgOntologyType (correct — the abstract class).",
      "skos:example": [
        "M3_GenesisGrammar.jsonld uses m3:Genesis",
        "M2_MetaConcepts.jsonld uses m3:TransdisciplinaryPattern",
        "M1_Biology.jsonld uses m3:DomainExtension",
        "M0_Yggdrasil.jsonld uses m3:Poclet"
      ]
    },
    {
      "@id": "m3:TscgOntologyType",
      "@type": "owl:Class",
      "rdfs:label": "TSCG Ontology Type",
      "rdfs:comment": "Abstract OWL class representing the architectural types of ontologies in the TSCG framework. Each TSCG ontology belongs to exactly one type. Instances (subclasses) are: Genesis, GenesisExtension, GenericConcepts, DomainExtension, SystemicFramework, Poclet, CaseStudy, RealWorldSystem, SymbolicSystemGrammar, TscgTool, TransDisclet. Each type is simultaneously an owl:Class (for OWL reasoning and Protégé class hierarchy) and a skos:Concept (for SKOS vocabulary navigation). Replaces the former m3:OntologyCategoryScheme/m3:OntologyCategoryScheme pattern (v3.3.0).",
      "rdfs:isDefinedBy": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "dcterms:created": "2026-02-19",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI"
    },
    {
      "@id": "m3:TscgOntologyTypeScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": "TSCG Ontology Type Scheme",
      "skos:definition": "Controlled vocabulary of the eleven architectural types of TSCG ontologies, from the foundational grammar (Genesis) to concrete instances (Poclet, TransDisclet…). Each type is both an owl:Class, subclass of m3:TscgOntologyType (for reasoning), and a skos:Concept of this scheme (for vocabulary navigation). An ontology declares exactly one type with m3:ontologyType on its owl:Ontology node.",
      "dcterms:created": "2026-01-27",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "skos:hasTopConcept": [
        {
          "@id": "m3:Genesis"
        },
        {
          "@id": "m3:GenesisExtension"
        },
        {
          "@id": "m3:GenericConcepts"
        },
        {
          "@id": "m3:DomainExtension"
        },
        {
          "@id": "m3:SystemicFramework"
        },
        {
          "@id": "m3:Poclet"
        },
        {
          "@id": "m3:CaseStudy"
        },
        {
          "@id": "m3:RealWorldSystem"
        },
        {
          "@id": "m3:SymbolicSystemGrammar"
        },
        {
          "@id": "m3:TscgTool"
        },
        {
          "@id": "m3:TransDisclet"
        }
      ],
      "skos:scopeNote": "This scheme is extensible upon framework revision. Each category represents a fundamental architectural distinction in the TSCG metamodel."
    },
    {
      "@id": "m3:Genesis",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Genesis",
      "skos:altLabel": [
        "Foundational Basis",
        "M3 Layer",
        "Structural Grammar Basis"
      ],
      "skos:definition": "The foundation of TSCG: the structural grammar — the type system of the three grammars Gt, Gm and Gs, rooted in the commutative Lambek calculus and free commutative monoidal categories — upon which all other TSCG layers are built. Its ontologies hold the apex (operators, type system, shared vocabulary) and the assembly of the three grammars and their couplings; the three perspectives themselves are m3:GenesisExtension.",
      "m3:semanticSignature": "structural_grammar_apex + three_perspectives(Gt,Gm,Gs) + commutative_Lambek_calculus_foundation",
      "skos:notation": "M3",
      "skos:example": [
        "M3_GrammarFoundation.jsonld",
        "M3_GenesisGrammar.jsonld"
      ],
      "skos:scopeNote": "Exactly 2 ontologies in this category: M3_GrammarFoundation (apex) and M3_GenesisGrammar (assembly of the three grammars). Closed set.",
      "m3:layerOrder": 1,
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:GenesisExtension",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Genesis Extension",
      "skos:altLabel": [
        "M3 Component",
        "Basis Component"
      ],
      "skos:definition": "Component ontologies of Genesis defining its three perspectives, one grammar each: Territory (Gt, AStFItD — Eagle Eye), Map (Gm, REVOIm — Sphinx Eye) and Stereopsis (Gs, the synergy of Territory and Map — Odin's Wisdom). Their metaphoric names are given by m3:metaphoricLabel.",
      "m3:semanticSignature": "perspective_of_Genesis + single_grammar(Gt|Gm|Gs)",
      "skos:notation": "M3_Ext",
      "skos:example": [
        "M3_EagleEye.jsonld (Territory — Gt, ASFID)",
        "M3_SphinxEye.jsonld (Map — Gm, REVOI)",
        "M3_OdinsWisdom.jsonld (Stereopsis — Gs, TKSL + poles; target name M3_OdinsWisdom)"
      ],
      "skos:scopeNote": "Exactly 3 ontologies in this category: M3_EagleEye, M3_SphinxEye, M3_OdinsWisdom. Closed set.",
      "m3:layerOrder": 1,
      "skos:broader": {
        "@id": "m3:Genesis"
      },
      "skos:related": {
        "@id": "m3:Genesis"
      },
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:GenericConcepts",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "GenericConcepts",
      "skos:altLabel": [
        "Universal Pattern",
        "M2 Layer",
        "Metaconcept",
        "Structural Formula"
      ],
      "skos:definition": "M2 ontologies of GenericConcepts: universal patterns, each a named product type (𝕋₁) built from M3 primitive types by the structural-grammar operators and written as a structural formula, valid across multiple scientific disciplines.",
      "m3:semanticSignature": "named_product_type(𝕋₁) + domain_agnostic + validated_across_disciplines",
      "skos:notation": "M2",
      "skos:example": [
        "M2_GenericConcepts.jsonld"
      ],
      "skos:scopeNote": "Typically one ontology (M2_GenericConcepts). It grows as new transdisciplinary patterns are discovered.",
      "m3:layerOrder": 2,
      "skos:broader": {
        "@id": "m3:Genesis"
      },
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:DomainExtension",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Domain Extension",
      "skos:altLabel": [
        "M1 Layer",
        "Specialized Ontology",
        "Domain Instance"
      ],
      "skos:definition": "M1 ontologies that specialize the M2 GenericConcepts for a scientific or professional field, bridging transdisciplinary patterns (M2) and concrete systems (M0). Each is an instance of the m2:Domain GenericConcept, with a characteristic coupling of Territory (ASFID, Gt) and Map (REVOI, Gm).",
      "m3:semanticSignature": "domain_specific + specializes_M2_metaconcepts + bridges_M2_to_M0",
      "skos:notation": "M1",
      "skos:example": [
        "M1_CoreConcepts.jsonld (transdisciplinary foundation)",
        "M1_Biology.jsonld",
        "M1_Chemistry.jsonld",
        "M1_Optics.jsonld",
        "M1_Photography.jsonld",
        "M1_Mythology.jsonld"
      ],
      "skos:scopeNote": "Open-ended set: new domains are added as the framework expands.",
      "m3:layerOrder": 3,
      "skos:broader": {
        "@id": "m3:GenericConcepts"
      },
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:SystemicFramework",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Systemic Framework",
      "skos:altLabel": [
        "External Framework Mapping",
        "Framework Integration",
        "Theoretical Framework Bridge"
      ],
      "skos:definition": "Ontologies that map established systemic or theoretical frameworks (TRIZ, the Viable System Model, the Business Model Canvas…) into TSCG formalism. As bridges between TSCG and existing methodologies, they validate TSCG's expressiveness and let practitioners use familiar frameworks within it.",
      "skos:notation": "M1_Framework",
      "skos:example": [
        "M0_Triz.jsonld (Theory of Inventive Problem Solving)",
        "M0_VSM.jsonld (Viable System Model)",
        "M0_Bmc.jsonld (Business Model Canvas)"
      ],
      "skos:scopeNote": "Open-ended set: any established framework with a systemic structure can be mapped. Distinct from DomainExtension (disciplinary) and from Poclet (minimal instances).",
      "m3:layerOrder": 3,
      "skos:broader": {
        "@id": "m3:GenericConcepts"
      },
      "skos:related": [
        {
          "@id": "m3:DomainExtension"
        },
        {
          "@id": "m3:Poclet"
        }
      ],
      "m3:semanticSignature": "established_methodology + prescriptive + convergent_toward_solution + formalizable_in_TSCG",
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:Poclet",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Poclet",
      "skos:altLabel": [
        "Proof of Concept",
        "M0 Layer",
        "Minimal Complete System",
        "Validation Instance"
      ],
      "skos:definition": "Minimal yet complete M0 instances of concrete, well-understood systems — minimal (no unnecessary component) and complete (all ASFID types present). They play a triple role: proof of concept of the framework, identification of M2 GenericConcepts, and population of M1 core concepts.",
      "m3:semanticSignature": "minimal + complete(all_ASFID_dimensions) + triple_role(validation+M2_discovery+M1_population)",
      "skos:notation": "M0_Poclet",
      "skos:example": [
        "M0_FireTriangle.jsonld",
        "M0_ExposureTriangle.jsonld",
        "M0_ButterflyMetamorphosis.jsonld",
        "M0_FourStrokeEngine.jsonld",
        "M0_Yggdrasil.jsonld"
      ],
      "skos:scopeNote": "Open-ended set, meant to span many domains.",
      "m3:layerOrder": 4,
      "skos:broader": {
        "@id": "m3:DomainExtension"
      },
      "skos:related": [
        {
          "@id": "m3:CaseStudy"
        },
        {
          "@id": "m3:RealWorldSystem"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:CaseStudy",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Case Study",
      "skos:altLabel": [
        "M0 Layer",
        "Educational Example",
        "Application Demonstration"
      ],
      "skos:definition": "M0 ontologies made for educational, illustrative or exploratory purposes, without the rigor required of Poclets: they may be incomplete (missing ASFID types) or over-specified (non-minimal), and may become Poclets after validation.",
      "m3:semanticSignature": "pedagogical + may_be_incomplete + evolves_toward_Poclet",
      "skos:notation": "M0_Case",
      "skos:example": [
        "M0_SocialMediaEcosystem.jsonld (hypothetical)",
        "M0_UrbanTrafficFlow.jsonld (hypothetical)"
      ],
      "skos:scopeNote": "Optional category. Not required for framework validation. May grow based on educational needs.",
      "m3:layerOrder": 4,
      "skos:broader": {
        "@id": "m3:DomainExtension"
      },
      "skos:related": [
        {
          "@id": "m3:Poclet"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:RealWorldSystem",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Real-World System",
      "skos:altLabel": [
        "M0 Layer",
        "Production Application",
        "Operational Ontology"
      ],
      "skos:definition": "M0 ontologies of actual deployed systems with stakeholders, analysed with TSCG — not pedagogical examples. They may be complex (non-minimal) and evolving, and test TSCG's scalability beyond simple examples.",
      "m3:semanticSignature": "deployed_system + complex(non_minimal) + stakeholder_validated",
      "skos:notation": "M0_Real",
      "skos:example": [
        "M0_HospitalERWorkflow.jsonld (hypothetical)",
        "M0_ManufacturingSupplyChain.jsonld (hypothetical)"
      ],
      "skos:scopeNote": "Future category. Not yet populated. Requires TSCG maturity and adoption.",
      "m3:layerOrder": 4,
      "skos:broader": {
        "@id": "m3:DomainExtension"
      },
      "skos:related": [
        {
          "@id": "m3:Poclet"
        },
        {
          "@id": "m3:CaseStudy"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:SymbolicSystemGrammar",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Symbolic System Grammar",
      "skos:altLabel": [
        "Combinatoric Symbolic System",
        "Interpretive Grammar",
        "Formal Symbolic Language"
      ],
      "skos:definition": "Ontologies of formal symbolic systems: a finite set of primitives and combination rules, whose value lies in the multiplicity of legitimate interpretations they generate. Neither prescriptive nor empirically arbitrated — interpretation is symbolic, cultural or contextual. Unlike SystemicFrameworks (which converge toward solutions) or Poclets (which validate observable systems), they are productive engines of interpretive diversity.",
      "skos:notation": "M3_SystemSymbolicGrammar",
      "skos:example": [
        "M0_IChing.jsonld (64 hexagrams from a Yin/Yang binary grammar)",
        "M0_TriskeleToolchain.jsonld",
        "M0_AlchemyGame.jsonld (planned)",
        "M0_ChineseGlyphs.jsonld (planned)",
        "M0_MusicalNotation.jsonld (planned)"
      ],
      "skos:scopeNote": "Open-ended set. Any formal symbolic system with finite primitives, explicit combination rules, and multiple legitimate interpretations qualifies. Arbitration is symbolic/cultural/contextual, never purely physical or empirical.",
      "m3:layerOrder": 3,
      "m3:semanticSignature": "finite_primitives + combination_rules + multiple_legitimate_interpretations(symbolic_arbitration)",
      "skos:broader": {
        "@id": "m3:GenericConcepts"
      },
      "skos:related": [
        {
          "@id": "m3:SystemicFramework"
        },
        {
          "@id": "m3:Poclet"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:TscgTool",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "TSCG Tool",
      "skos:altLabel": [
        "Framework Tool",
        "Ontology Tool",
        "Meta-Level Application",
        "Reflexive Tool"
      ],
      "skos:definition": "Software tools that operate reflexively ON the TSCG framework: they take TSCG artifacts (ontologies, GenericConcepts, poclets, formulas) as input and produce analysis, navigation or transformation — explorers, validators, converters, generators, simulators. They are M0 instances whose subject matter is the framework itself; like any system, they can be characterised by ASFID and REVOI.",
      "m3:semanticSignature": "operates_on_tscg_artifacts + reflexive_meta_level + software_tool + framework_self_analysis",
      "skos:notation": "M0_TscgTool",
      "skos:example": [
        "M0_TscgOntologyExplorer.jsonld",
        "M0_TscgOntologyAPIServer.jsonld",
        "M0_TscgPocletGenerator.jsonld",
        "M0_TscgPocletMiner.jsonld"
      ],
      "skos:scopeNote": "Open-ended set. Any software tool whose primary input/subject is TSCG ontological artifacts qualifies. Instantiated at M0 level but typed as TscgTool rather than Poclet.",
      "m3:layerOrder": 4,
      "skos:related": [
        {
          "@id": "m3:Poclet"
        },
        {
          "@id": "m3:Genesis"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:TransDisclet",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "TransDisclet",
      "skos:altLabel": [
        "Transdisciplinary System Instance",
        "Cross-Domain System",
        "Multi-Domain Native System"
      ],
      "skos:definition": "M0 ontologies of a system that exists natively and autonomously in several disciplines at once — the same system concept, not an analogy (from 'Transdisciplinary' + the diminutive '-let', as in 'Poclet'). Unlike a Poclet (one system in one domain), a TransDisclet is a minimal yet complete cross-domain model. Example: the Transducer — sensor/actuator in Electronics, sensory receptor in Biology, microphone/speaker in Acoustics, piezoelectric effect in Physics.",
      "m3:semanticSignature": "multi_domain_native + same_system_concept + independent_disciplinary_instantiation + M0_level",
      "skos:notation": "M0_TransDisclet",
      "skos:example": [
        "M0_Transducer.jsonld (planned)",
        "M0_Oscillator.jsonld (planned)",
        "M0_Filter.jsonld (planned)"
      ],
      "skos:scopeNote": "Open-ended set. A system qualifies as a TransDisclet when: (1) it exists natively in at least 2 distinct disciplines, (2) the same GenericConcept structure (ASFID) is identifiable in each disciplinary instance, and (3) the cross-domain homology is structural, not merely metaphorical. Stored in instances/transdisclet/ folder.",
      "m3:layerOrder": 4,
      "skos:broader": {
        "@id": "m3:Poclet"
      },
      "skos:related": [
        {
          "@id": "m3:Poclet"
        },
        {
          "@id": "m3:DomainExtension"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:metaphoricLabel",
      "@type": "owl:AnnotationProperty",
      "rdfs:label": "metaphoric label",
      "rdfs:comment": "The metaphoric name of a TSCG construct, given alongside its technical name (rdfs:label). It belongs to the metaphoric terminology context, one of the three coexisting terminology contexts that name the three perspectives of TSCG (monoidal: Gt, Gm, Gs; epistemological: Territory, Map, Stereopsis; metaphoric: Eagle Eye, Sphinx Eye, Odin's Wisdom). The metaphor is a TSCG interpretation of the Norse myth, not part of it: Odin keeps one eye to see the world (Territory, Eagle Eye) and leaves the other in Mímir's well to see into knowledge (Map, Sphinx Eye); his wisdom, born of both, is the Stereopsis. Declared in the apex so that every layer can use it without a level crossing. Annotation only: no logical effect."
    }
  ]
}
