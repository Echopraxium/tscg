    {
      "@id": "schema:value",
      "@type": "owl:AnnotationProperty",
      "rdfs:isDefinedBy": {
        "@id": "https://schema.org/"
      },
      "rdfs:comment": "schema.org: 'The value of a QuantitativeValue (including Observation) or property value node.' Used on the {rdfs:label, schema:value} nodes of skos:example lists (name / value pairs); replaces rdf:value, a reserved IRI that cannot be declared in OWL 2 DL (WS-1 lot 1h).",
      "dcterms:created": "2026-09-30"
    },
    {
      "@id": "m3:grammar_foundation:Fm2",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Fm2 — GenericConcept Combination (function)",
      "rdfs:comment": "Producing FUNCTION for GenericConceptCombos. Fm2 : GenericConcept²⁺ → GenericConceptCombo. Fm2 is NOT a morphism and NOT a functor: its essence is combination with EMERGENCE, which is non-compositional, while a morphism/functor must preserve composition. (The word 'functor' stays reserved for M0 dimension evaluation F_x : System → Score.) Consequently a combo has NO monoidal expansion: its formula IS this signature. Arguments are ≥2 NAMED CONCEPTS declared in M2_GenericConcepts.jsonld or M1_CoreConcepts.jsonld — never primitive types, never a monoidal expression, juxtaposed by comma and never joined by a grammar operator (×, +, |). Supersedes the retired ⊗⇒ notation.",
      "skos:example": "Fm2(Memory, Entropy) = Inertia  |  Fm2(Incoherence, Invariant) = TopologicalDefect  |  Fm2(Process, Step, Trajectory) = PipelineProcess",
      "m3:grammar_foundation:signature": "Fm2 : GenericConcept²⁺ → GenericConceptCombo",
      "m3:grammar_foundation:operatesAt": "𝕋₁ (GenericConcept level — not 𝕋₀ primitive level)",
      "rdfs:domain": {
        "@id": "m3:MonoidalType"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "dcterms:created": "2026-05-20",
      "m3:grammar_foundation:kind": "function",
      "m3:grammar_foundation:functionFamily": "MORPHISMS: Φ (Gt→Gm), Ψ (Gm→Gt) — structure-preserving, they compose. FUNCTIONS: Fm2, Fm1m2 — emergence, non-compositional, they do NOT compose."
    },
    {
      "@id": "m3:grammar_foundation:Fm1m2",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Fm1m2 — Domain + GenericConcept Combination (function)",
      "rdfs:comment": "Producing FUNCTION for DomainConceptCombos. Fm1m2 : Domain⁺, GenericConcept⁺ → DomainConceptCombo. A HYBRID of at least one Domain and at least one GenericConcept. ⚠ CORRECTION (SC-1, 2026-07-12): Fm1m2 does NOT mean 'the function that crosses the M1/M2 boundary'. That earlier reading was wrong and propagated into the corpus (e.g. Fm1m2(Cascade, Duplication, Network), which has no Domain and is really an Fm2). What distinguishes Fm1m2 from Fm2 is DOMAIN QUALIFICATION — nothing else. An Fm2 argument may legitimately be a named concept from M1_CoreConcepts, so 'crossing M1/M2' distinguishes nothing. Both slots are non-empty; the Domain × Concept hybridisation IS the emergence, so one concept argument suffices. Multi-domain conjunction is carried by juxtaposed domain arguments — Fm1m2(Biology, Chemistry, Catalysis); there is no Fm1 and no reification of composite domains. Fm1m2 is NOT a morphism and NOT a functor (emergence is non-compositional). Supersedes the retired ⊗⇒ notation.",
      "skos:example": "Fm1m2(Biology, Process) = BiologicalProcess  |  Fm1m2(Physics, Coherence) = LaserCoherence  |  Fm1m2(Education, Memory, Structure) = CurriculumDesign",
      "m3:grammar_foundation:signature": "Fm1m2 : Domain⁺, GenericConcept⁺ → DomainConceptCombo",
      "m3:grammar_foundation:operatesAt": "M1/M2 boundary — domain-specific instantiation of generic patterns",
      "rdfs:domain": {
        "@id": "m3:MonoidalType"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "dcterms:created": "2026-05-20",
      "m3:grammar_foundation:kind": "function",
      "m3:grammar_foundation:functionFamily": "MORPHISMS: Φ (Gt→Gm), Ψ (Gm→Gt) — structure-preserving, they compose. FUNCTIONS: Fm2, Fm1m2 — emergence, non-compositional, they do NOT compose."
    },
    {
      "@id": "m3:grammar_foundation:SpecialElements",
      "@type": "owl:NamedIndividual",
      "rdfs:label": "TSCG Special Elements — Neutral and Limit Elements",
      "rdfs:comment": "Registry of the four special elements of the TSCG monoidal grammar system: neutral elements of ×, +, | and the pseudo-absorbent of |.",
      "dcterms:created": "2026-05-20",
      "EmptyTerritory": {
        "@id": "m3:grammar_foundation:EmptyTerritory",
        "rdfs:label": "Empty Territory",
        "rdfs:comment": "Neutral element of ×. Absence of all ASFID types. A × EmptyTerritory = A for all A ∈ 𝕋₀(×).",
        "m3:grammar_foundation:grammar": "Gt",
        "m3:grammar_foundation:operator": "×",
        "m3:grammar_foundation:role": "neutral_element",
        "m3:grammar_foundation:visual": "Black — absence of all ASFID types"
      },
      "EmptyMap": {
        "@id": "m3:grammar_foundation:EmptyMap",
        "rdfs:label": "Empty Map",
        "rdfs:comment": "Neutral element of +. Absence of all REVOI types. R + EmptyMap = R for all R ∈ 𝕋₀(+).",
        "m3:grammar_foundation:grammar": "Gm",
        "m3:grammar_foundation:operator": "+",
        "m3:grammar_foundation:role": "neutral_element",
        "m3:grammar_foundation:visual": "Empty pentagon — absence of all REVOI types"
      },
      "StereopsisEmptySet": {
        "@id": "m3:bicephalous:StereopsisEmptySet",
        "rdfs:label": "Stereopsis Empty Set",
        "rdfs:comment": "Neutral element of |. Defined as EmptyTerritory | EmptyMap. Divergent Strabismus — δ₁ = max. x | StereopsisEmptySet = x for all x.",
        "m3:grammar_foundation:grammar": "Gs",
        "m3:grammar_foundation:operator": "|",
        "m3:grammar_foundation:role": "neutral_element",
        "m3:grammar_foundation:visual": "Black + Empty pentagon",
        "m3:grammar_foundation:epistemicGap": "δ₁ = max",
        "m3:grammar_foundation:definition": "EmptyTerritory | EmptyMap",
        "m3:grammar_foundation:semantics": "Divergent Strabismus — Territory and Map share nothing"
      },
      "StereopsisUniversalSet": {
        "@id": "m3:bicephalous:StereopsisUniversalSet",
        "rdfs:label": "Stereopsis Universal Set",
        "rdfs:comment": "Pseudo-absorbent of |. Defined as 𝕋₀(×) ∪ 𝕋₀(+) ∪ 𝕋₀(|) = 𝕋₀ (16 primitives — Base16). StereopsisUniversalSet | a = StereopsisUniversalSet for all a. Degenerate limit — Borges 1:1 map paradox. Distinct from SpectralClass Coherent (δ₁ ≈ 0).",
        "m3:grammar_foundation:grammar": "Gs",
        "m3:grammar_foundation:operator": "|",
        "m3:grammar_foundation:role": "pseudo_absorbent",
        "m3:grammar_foundation:visual": "White + Full pentagon",
        "m3:grammar_foundation:epistemicGap": "δ₁ = 0",
        "m3:grammar_foundation:definition": "𝕋₀(×) ∪ 𝕋₀(+) ∪ 𝕋₀(|)",
        "m3:grammar_foundation:semantics": "Convergent Strabismus — degenerate limit, not a semantic ideal"
      }
    },
    {
      "@id": "m3:ontologyType",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "Ontology Type",
      "rdfs:comment": "Specifies the architectural type of a TSCG ontology. Value must be an instance of m3:TscgOntologyType (e.g. m3:Poclet, m3:Genesis, m3:DomainExtension). Enables both OWL reasoning (subClassOf hierarchy) and SKOS navigation (ConceptScheme). Renamed from m3:ontologyCategory in v3.3.0.",
      "skos:definition": "A framework-level architectural property that specifies the position and role of an ontology within the TSCG metamodel hierarchy through reference to a controlled vocabulary defined as a skos:ConceptScheme.",
      "rdfs:domain": {
        "@id": "owl:Ontology"
      },
      "rdfs:range": {
        "@id": "m3:TscgOntologyType"
      },
      "dcterms:created": "2026-01-27",
      "dcterms:modified": "2026-01-27",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "skos:editorialNote": "Defined in M3 (Genesis Space) because it is a foundational metamodel property needed by all layers. M3 has no dependencies, ensuring m3:ontologyCategory is always available without creating circular dependencies.",
      "skos:changeNote": "v3.3.0: Renamed from m3:ontologyCategory to m3:ontologyType for clarity. Range changed from m3:OntologyCategoryScheme (incorrect — was the ConceptScheme, not a concept) to m3:TscgOntologyType (correct — the abstract class).",
      "skos:example": [
        "M3_GenesisGrammar.jsonld uses m3:Genesis",
        "M2_MetaConcepts.jsonld uses m3:TransdisciplinaryPattern",
        "M1_Biology.jsonld uses m3:DomainExtension",
        "M0_Yggdrasil.jsonld uses m3:Poclet"
      ]
    },
    {
      "@id": "m3:TscgOntologyType",
      "@type": "owl:Class",
      "rdfs:label": "TSCG Ontology Type",
      "rdfs:comment": "Abstract OWL class representing the architectural types of ontologies in the TSCG framework. Each TSCG ontology belongs to exactly one type. Instances (subclasses) are: Genesis, GenesisExtension, GenericConcepts, DomainExtension, SystemicFramework, Poclet, CaseStudy, RealWorldSystem, SymbolicSystemGrammar, TscgTool, TransDisclet. Each type is simultaneously an owl:Class (for OWL reasoning and Protégé class hierarchy) and a skos:Concept (for SKOS vocabulary navigation). Replaces the former m3:OntologyCategoryScheme/m3:OntologyCategoryScheme pattern (v3.3.0).",
      "rdfs:isDefinedBy": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "dcterms:created": "2026-02-19",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI"
    },
    {
      "@id": "m3:TscgOntologyTypeScheme",
      "@type": "skos:ConceptScheme",
      "rdfs:label": "TSCG Ontology Type Scheme",
      "rdfs:comment": "SKOS controlled vocabulary listing all TSCG ontology types. Each concept in this scheme is simultaneously an owl:Class subClassOf m3:TscgOntologyType (OWL) and a skos:Concept (SKOS). Use m3:ontologyType property (range: m3:TscgOntologyType) to annotate ontologies with their type.",
      "skos:definition": "A controlled vocabulary defining the eleven architectural types of TSCG ontologies, organized from foundational mathematical basis (Genesis) to concrete real-world instantiations (RealWorldSystem, TransDisclet). Each type serves as both an OWL class (enabling reasoning) and a SKOS concept (enabling vocabulary navigation).",
      "dcterms:created": "2026-01-27",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "skos:hasTopConcept": [
        {
          "@id": "m3:Genesis"
        },
        {
          "@id": "m3:GenesisExtension"
        },
        {
          "@id": "m3:GenericConcepts"
        },
        {
          "@id": "m3:DomainExtension"
        },
        {
          "@id": "m3:SystemicFramework"
        },
        {
          "@id": "m3:Poclet"
        },
        {
          "@id": "m3:CaseStudy"
        },
        {
          "@id": "m3:RealWorldSystem"
        },
        {
          "@id": "m3:SymbolicSystemGrammar"
        },
        {
          "@id": "m3:TscgTool"
        },
        {
          "@id": "m3:TransDisclet"
        }
      ],
      "skos:scopeNote": "This scheme is extensible upon framework revision. Each category represents a fundamental architectural distinction in the TSCG metamodel."
    },
    {
      "@id": "m3:Genesis",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Genesis",
      "skos:altLabel": [
        "Foundational Basis",
        "M3 Layer",
        "Structural Grammar Basis"
      ],
      "skos:definition": "Foundational structural grammar providing the type system of the three grammars (Gt, Gm, Gs) upon which all other TSCG layers are built. Rooted in the commutative Lambek calculus and free commutative monoidal categories.",
      "rdfs:comment": "M3 layer ontologies holding the foundation and its assembly: M3_GrammarFoundation (the apex: operators, type system, shared vocabulary; imports nothing) and M3_GenesisGrammar (assembles the three grammars Gt, Gm, Gs and their couplings). The three perspectives themselves are m3:GenesisExtension.",
      "m3:semanticSignature": "structural_grammar_apex + three_perspectives(Gt,Gm,Gs) + commutative_Lambek_calculus_foundation",
      "skos:notation": "M3",
      "skos:example": [
        "M3_GrammarFoundation.jsonld",
        "M3_GenesisGrammar.jsonld"
      ],
      "skos:scopeNote": "Exactly 2 ontologies in this category: M3_GrammarFoundation (apex) and M3_GenesisGrammar (assembly of the three grammars). Closed set.",
      "m3:layerOrder": 1,
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:GenesisExtension",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Genesis Extension",
      "skos:altLabel": [
        "M3 Component",
        "Basis Component"
      ],
      "skos:definition": "Component ontologies of Genesis defining its three perspectives: Territory (Gt, ASFID — Eagle Eye), Map (Gm, REVOI — Sphinx Eye) and Stereopsis (Gs, the synergy of Territory and Map — Odin's Wisdom). Each perspective carries one grammar.",
      "rdfs:comment": "While m3:Genesis holds the grammar foundation and its assembly, m3:GenesisExtension holds its three perspectives, one grammar each (Gt, Gm, Gs). Their metaphoric names are given by m3:metaphoricLabel.",
      "m3:semanticSignature": "perspective_of_Genesis + single_grammar(Gt|Gm|Gs)",
      "skos:notation": "M3_Ext",
      "skos:example": [
        "M3_EagleEye.jsonld (Territory — Gt, ASFID)",
        "M3_SphinxEye.jsonld (Map — Gm, REVOI)",
        "M3_BicephalousPerspective.jsonld (Stereopsis — Gs, TKSL + poles; target name M3_OdinsWisdom)"
      ],
      "skos:scopeNote": "Exactly 3 ontologies in this category: M3_EagleEye, M3_SphinxEye, M3_BicephalousPerspective. Closed set.",
      "m3:layerOrder": 1,
      "skos:broader": {
        "@id": "m3:Genesis"
      },
      "skos:related": {
        "@id": "m3:Genesis"
      },
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:GenericConcepts",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "GenericConcepts",
      "skos:altLabel": [
        "Universal Pattern",
        "M2 Layer",
        "Metaconcept",
        "Structural Formula"
      ],
      "skos:definition": "Universal patterns derived as named product types (𝕋₁) from M3 primitive types via structural grammar operators, validated across multiple scientific disciplines.",
      "rdfs:comment": "M2 layer ontologies containing GenericConcepts — named product types in the TSCG type system. Each concept is expressible as a structural formula combining M3 primitive types (e.g., Homeostasis = A×S×F).",
      "m3:semanticSignature": "named_product_type(𝕋₁) + domain_agnostic + validated_across_disciplines",
      "skos:notation": "M2",
      "skos:example": [
        "M2_MetaConcepts.jsonld (currently 62 metaconcepts including Step, Node, Homeostasis, etc.)"
      ],
      "skos:scopeNote": "Typically 1 ontology containing 72+ metaconcepts. May grow as new transdisciplinary patterns are discovered.",
      "m3:layerOrder": 2,
      "skos:broader": {
        "@id": "m3:Genesis"
      },
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:DomainExtension",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Domain Extension",
      "skos:altLabel": [
        "M1 Layer",
        "Specialized Ontology",
        "Domain Instance"
      ],
      "skos:definition": "Domain-specific ontologies that specialize M2 metaconcepts for particular scientific or professional fields. Each is an instance of the m2:Domain metaconcept with specific 5D structural composition.",
      "rdfs:comment": "M1 layer ontologies that bridge transdisciplinary metaconcepts (M2) with concrete systems (M0). Examples include Biology, Chemistry, Optics, Photography, Mythology. Each domain has characteristic ASFID|REVOI coupling.",
      "m3:semanticSignature": "domain_specific + specializes_M2_metaconcepts + bridges_M2_to_M0",
      "skos:notation": "M1",
      "skos:example": [
        "M1_CoreConcepts.jsonld (transdisciplinary foundation)",
        "M1_Biology.jsonld",
        "M1_Chemistry.jsonld",
        "M1_Optics.jsonld",
        "M1_Photography.jsonld",
        "M1_Mythology.jsonld"
      ],
      "skos:scopeNote": "Open-ended set. New domains can be added as framework expands. Currently ~6 active domain extensions.",
      "m3:layerOrder": 3,
      "skos:broader": {
        "@id": "m3:GenericConcepts"
      },
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:SystemicFramework",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Systemic Framework",
      "skos:altLabel": [
        "External Framework Mapping",
        "Framework Integration",
        "Theoretical Framework Bridge"
      ],
      "skos:definition": "Ontologies that map established systemic/theoretical frameworks (TRIZ, VSD, TPACK, etc.) into TSCG formalism. These provide bridges between TSCG and existing methodologies, enabling cross-framework analysis and integration.",
      "rdfs:comment": "Systemic Frameworks are existing theories, methodologies, or analytical frameworks that have been formalized within TSCG's ontological structure. They serve as validation of TSCG's expressiveness and enable practitioners to leverage familiar frameworks within TSCG's rigorous formalism.",
      "skos:notation": "M1_Framework",
      "skos:example": [
        "M0_TRIZ.jsonld (Theory of Inventive Problem Solving)",
        "M0_VSD.jsonld (Value-Sensitive Design)",
        "M0_TPACK.jsonld (Technological Pedagogical Content Knowledge)",
        "M0_SystemsThinking.jsonld (General Systems Theory)",
        "M0_DesignThinking.jsonld (Design Thinking methodology)"
      ],
      "skos:scopeNote": "Open-ended set. Any established framework with systemic structure can be mapped. Typically 10-20 major frameworks. Distinct from DomainExtension (which are disciplinary) and from Poclet (which are minimal instances).",
      "m3:layerOrder": 3,
      "skos:broader": {
        "@id": "m3:GenericConcepts"
      },
      "skos:related": [
        {
          "@id": "m3:DomainExtension"
        },
        {
          "@id": "m3:Poclet"
        }
      ],
      "m3:semanticSignature": "established_methodology + prescriptive + convergent_toward_solution + formalizable_in_TSCG",
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:Poclet",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Poclet",
      "skos:altLabel": [
        "Proof of Concept",
        "M0 Layer",
        "Minimal Complete System",
        "Validation Instance"
      ],
      "skos:definition": "Minimal yet complete system instances that serve the triple role of (1) framework proof-of-concept, (2) M2 metaconcept identification, and (3) M1 core concept population.",
      "rdfs:comment": "M0 layer ontologies representing concrete, well-understood systems used to validate TSCG framework. Must be minimal (no unnecessary components) yet complete (all ASFID types present). Examples: Fire Triangle, Butterfly Metamorphosis, Four-Stroke Engine.",
      "m3:semanticSignature": "minimal + complete(all_ASFID_dimensions) + triple_role(validation+M2_discovery+M1_population)",
      "skos:notation": "M0_Poclet",
      "skos:example": [
        "M0_FireTriangle.jsonld",
        "M0_ExposureTriangle.jsonld",
        "M0_ButterflyMetamorphosis.jsonld",
        "M0_FourStrokeEngine.jsonld",
        "M0_Yggdrasil.jsonld"
      ],
      "skos:scopeNote": "Open-ended set. Goal is 20+ poclets spanning 10+ domains. Currently ~16 validated poclets.",
      "m3:layerOrder": 4,
      "skos:broader": {
        "@id": "m3:DomainExtension"
      },
      "skos:related": [
        {
          "@id": "m3:CaseStudy"
        },
        {
          "@id": "m3:RealWorldSystem"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:CaseStudy",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Case Study",
      "skos:altLabel": [
        "M0 Layer",
        "Educational Example",
        "Application Demonstration"
      ],
      "skos:definition": "M0 ontologies created primarily for educational, illustrative, or exploratory purposes. Unlike Poclets, Case Studies may be incomplete (missing ASFID types) or over-specified (non-minimal).",
      "rdfs:comment": "Case Studies demonstrate TSCG application without the rigor required of Poclets. They serve pedagogical or experimental roles and may evolve into full Poclets after validation.",
      "m3:semanticSignature": "pedagogical + may_be_incomplete + evolves_toward_Poclet",
      "skos:notation": "M0_Case",
      "skos:example": [
        "M0_SocialMediaEcosystem.jsonld (hypothetical)",
        "M0_UrbanTrafficFlow.jsonld (hypothetical)"
      ],
      "skos:scopeNote": "Optional category. Not required for framework validation. May grow based on educational needs.",
      "m3:layerOrder": 4,
      "skos:broader": {
        "@id": "m3:DomainExtension"
      },
      "skos:related": [
        {
          "@id": "m3:Poclet"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:RealWorldSystem",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Real-World System",
      "skos:altLabel": [
        "M0 Layer",
        "Production Application",
        "Operational Ontology"
      ],
      "skos:definition": "M0 ontologies representing actual deployed systems analyzed using TSCG framework. These are not pedagogical examples but real applications with stakeholders.",
      "rdfs:comment": "Real-World Systems demonstrate TSCG applied to production environments. May be complex (non-minimal) and evolving. Used to validate TSCG scalability beyond simple examples.",
      "m3:semanticSignature": "deployed_system + complex(non_minimal) + stakeholder_validated",
      "skos:notation": "M0_Real",
      "skos:example": [
        "M0_HospitalERWorkflow.jsonld (hypothetical)",
        "M0_ManufacturingSupplyChain.jsonld (hypothetical)"
      ],
      "skos:scopeNote": "Future category. Not yet populated. Requires TSCG maturity and adoption.",
      "m3:layerOrder": 4,
      "skos:broader": {
        "@id": "m3:DomainExtension"
      },
      "skos:related": [
        {
          "@id": "m3:Poclet"
        },
        {
          "@id": "m3:CaseStudy"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:SymbolicSystemGrammar",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "Symbolic System Grammar",
      "skos:altLabel": [
        "Combinatoric Symbolic System",
        "Interpretive Grammar",
        "Formal Symbolic Language"
      ],
      "skos:definition": "Ontologies representing formal symbolic systems defined by a finite set of primitives and combination rules, whose value lies in the multiplicity of legitimate interpretations they generate. Neither prescriptive nor empirically arbitrated — interpretation is symbolic, cultural, or contextual.",
      "rdfs:comment": "Symbolic System Grammars are complete symbolic languages with combinatorial structure. Unlike SystemicFrameworks (which converge toward solutions) or Poclets (which validate observable systems), SymbolicSystemGrammars are productive engines of legitimate interpretive diversity. Examples span divination systems, generative alphabets, and musical notation.",
      "skos:notation": "M3_SystemSymbolicGrammar",
      "skos:example": [
        "M0_IChing.jsonld (64 hexagrams from Yin/Yang binary grammar)",
        "M0_Tarot.jsonld (78 arcanes, positional combination rules)",
        "M0_AlchemyGame.jsonld (4 elements → 173 compounds by binary combination)",
        "M0_ChineseGlyphs.jsonld (~200 radicals → ~50,000 sinograms)",
        "M0_MusicalNotation.jsonld (notes + rhythm rules → infinite interpretations)"
      ],
      "skos:scopeNote": "Open-ended set. Any formal symbolic system with finite primitives, explicit combination rules, and multiple legitimate interpretations qualifies. Arbitration is symbolic/cultural/contextual, never purely physical or empirical.",
      "m3:layerOrder": 3,
      "m3:semanticSignature": "finite_primitives + combination_rules + multiple_legitimate_interpretations(symbolic_arbitration)",
      "skos:broader": {
        "@id": "m3:GenericConcepts"
      },
      "skos:related": [
        {
          "@id": "m3:SystemicFramework"
        },
        {
          "@id": "m3:Poclet"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:TscgTool",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "TSCG Tool",
      "skos:altLabel": [
        "Framework Tool",
        "Ontology Tool",
        "Meta-Level Application",
        "Reflexive Tool"
      ],
      "skos:definition": "Software tools that operate reflexively ON the TSCG framework itself. Unlike Poclets (which model external systems), TscgTools model and operate on TSCG artifacts: ontologies, GenericConcepts, poclets, formulas. They are M0-level concrete instantiations whose subject matter is the framework.",
      "rdfs:comment": "TscgTools are meta-level applications: visualizers, explorers, validators, converters, simulators that take TSCG ontologies as input and produce analysis, navigation, or transformation as output. They can themselves be characterized by ASFID/REVOI (as any system), but their primary purpose is operating on the TSCG knowledge graph.",
      "m3:semanticSignature": "operates_on_tscg_artifacts + reflexive_meta_level + software_tool + framework_self_analysis",
      "skos:notation": "M0_TscgTool",
      "skos:example": [
        "M0_TscgExplorer.jsonld (interactive GenericConcept net visualizer, 3 projection modes)",
        "M0_TscgValidator.jsonld (ontology consistency checker — planned)",
        "M0_TscgRagSearch.jsonld (RAG-based semantic search over TSCG — planned)"
      ],
      "skos:scopeNote": "Open-ended set. Any software tool whose primary input/subject is TSCG ontological artifacts qualifies. Instantiated at M0 level but typed as TscgTool rather than Poclet.",
      "m3:layerOrder": 4,
      "skos:related": [
        {
          "@id": "m3:Poclet"
        },
        {
          "@id": "m3:Genesis"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:TransDisclet",
      "@type": [
        "owl:Class",
        "skos:Concept"
      ],
      "skos:inScheme": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:topConceptOf": {
        "@id": "m3:TscgOntologyTypeScheme"
      },
      "skos:prefLabel": "TransDisclet",
      "skos:altLabel": [
        "Transdisciplinary System Instance",
        "Cross-Domain System",
        "Multi-Domain Native System"
      ],
      "skos:definition": "M0-level ontologies modeling systems that exist natively and autonomously across multiple disciplines simultaneously. Unlike Poclets (which validate a single system in one domain), a TransDisclet captures a system concept whose existence is inherently multi-disciplinary — the same system arises independently in each discipline, not by analogy but by native instantiation.",
      "rdfs:comment": "A TransDisclet (from 'Transdisciplinary' + diminutive suffix '-let', analogous to 'Poclet') is a minimal yet complete cross-domain system model. The defining criterion is that the system is not merely analogous across domains — it is the SAME system concept natively instantiated in each discipline. Example: Transducer exists natively in Electronics (sensor/actuator), Biology (sensory receptor), Acoustics (microphone/speaker), and Physics (piezoelectric effect).",
      "m3:semanticSignature": "multi_domain_native + same_system_concept + independent_disciplinary_instantiation + M0_level",
      "skos:notation": "M0_TransDisclet",
      "skos:example": [
        "M0_Transducer.jsonld (Electronics: sensor/actuator; Biology: sensory receptor; Acoustics: microphone/speaker; Physics: piezoelectric effect)",
        "M0_Oscillator.jsonld (Electronics: LC circuit; Biology: circadian rhythm; Physics: pendulum; Neuroscience: neural oscillation)",
        "M0_Filter.jsonld (Electronics: RC/LC filter; Biology: kidney glomerulus; Acoustics: resonator; Signal Processing: digital filter)"
      ],
      "skos:scopeNote": "Open-ended set. A system qualifies as a TransDisclet when: (1) it exists natively in at least 2 distinct disciplines, (2) the same GenericConcept structure (ASFID) is identifiable in each disciplinary instance, and (3) the cross-domain homology is structural, not merely metaphorical. Stored in instances/transdisclet/ folder.",
      "m3:layerOrder": 4,
      "skos:broader": {
        "@id": "m3:Poclet"
      },
      "skos:related": [
        {
          "@id": "m3:Poclet"
        },
        {
          "@id": "m3:DomainExtension"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "m3:TscgOntologyType"
      }
    },
    {
      "@id": "m3:metaphoricLabel",
      "@type": "owl:AnnotationProperty",
      "rdfs:label": "metaphoric label",
      "rdfs:comment": "The metaphoric name of a TSCG construct, given alongside its technical name (rdfs:label). It belongs to the metaphoric lens, one of the three lenses through which the three perspectives of TSCG can be read (structural grammar: Gt, Gm, Gs; epistemology: Territory, Map, Stereopsis; metaphor: Eagle Eye, Sphinx Eye, Odin's Wisdom). The metaphor is a TSCG interpretation of the Norse myth, not part of it: Odin keeps one eye to see the world (Territory, Eagle Eye) and leaves the other in Mímir's well to see into knowledge (Map, Sphinx Eye); his wisdom, born of both, is the Stereopsis. Declared in the apex so that every layer can use it without a level crossing. Annotation only: no logical effect."
    }
  ]
}
