  },
  "@graph": [
    {
      "@id": "m3:eagle_eye:EagleEye",
      "@type": "owl:Ontology",
      "owl:versionInfo": "2.18.0",
      "dcterms:created": "2026-01-21",
      "dcterms:modified": "2026-10-10",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "dcterms:description": "Territory Grammar Gt — the Territory perspective of TSCG (what a system is; metaphoric name: Eagle Eye). Free commutative monoidal grammar over the primitive types {A, St, F, It, D} (Territory types 𝕋₀(×)), operator ×. At M0, each primitive type receives a score in [0,1] for a given instance (m0:asfidScores). These scores are provisional: stipulated by the TSCG Architects (KitArchitect role) and not yet validated by users or validators outside that role. Their credibility grows by accretion, as independent evaluations converge (m3:grammar_foundation:intersubjectiveBenchmark, defeasibilityStatus); they are not factual measurements. The epistemic gap δ₁ is computed from them. See TSCG_StructuralGrammar_as_Mathematical_Foundation_README.md.",
      "m3:ontologyCategory": {
        "@id": "m3:GenesisExtension"
      },
      "owl:imports": [
        { "@id": "M3_GrammarFoundation.jsonld" }
      ],
      "rdfs:label": "Eagle Eye - Territory Grammar Gt",
      "m3:ontologyType": {
        "@id": "m3:GenesisExtension"
      },
      "m3:metaphoricLabel": "Eagle Eye",
      "metadata": {
        "layer": "M3",
        "name": "Eagle Eye - ASFID Basis",
        "version": "2.8.0",
        "date_created": "2026-01-21",
        "date_modified": "2026-05-20",
        "authors": [
          "Echopraxium with the collaboration of Claude AI"
        ],
        "description": "ASFID basis for Territory measurement through analytical decomposition"
      },
      "parent_ontology": {
        "@id": "m3:genesis_space:GenesisSpace",
        "relationship": "component_of",
        "dcterms:description": "Eagle Eye is the ASFID component of M3 Genesis Space, providing the analytical perspective on systems"
      },
      "grammar_properties": {
        "grammar_name": "Territory Grammar Gt",
        "grammar_type": "free_commutative_monoidal",
        "primitives": [
          "A",
          "St",
          "F",
          "It",
          "D"
        ],
        "product": "×",
        "primitive_role": "generators of Territory type expressions (M2 structural formulas)",
        "functor_role": "F_A, F_S, F_F, F_I, F_D : System → (M0 numeric ValueSpace)  (evaluation morphisms at M0)",
        "perspective": "ontological / empirical",
        "independence": "verified  (no primitive derivable from others)",
        "mathematical_foundation": "Commutative Lambek calculus / free commutative monoidal categories (Lambek 1958, commutative variant; MacLane 1963)",
        "operator": "× (Territory structural product — intra-ASFID)",
        "neutral_element": "m3:grammar_foundation:EmptyTerritory",
        "neutral_element_label": "Empty Territory (neutral of ×)",
        "neutral_element_semantic": "Black — absence of all ASFID types"
      },
      "coupling_with_MapGrammar": {
        "dcterms:description": "Territory Grammar Gt and Map Grammar Gm are connected via natural transformations (category theory). Gt and Gm are structurally separate grammars — their separation is fundamental, not a consequence of orthogonality.",
        "natural_transformations": {
          "Phi": {
            "symbol": "Φ",
            "signature": "Φ : Gt → Gm",
            "role": "Observation — Territory measurements inform Map construction",
            "skos:example": "Nuclear reactor: neutron flux measurements (ASFID) → diffusion model coefficients (REVOI)"
          },
          "Psi": {
            "symbol": "Ψ",
            "signature": "Ψ : Gm → Gt",
            "role": "Interpretation — Map predictions guide Territory measurement strategies",
            "skos:example": "Nuclear reactor: xenon oscillation model (REVOI) → install in-core detectors (ASFID)"
          }
        },
        "epistemic_gap": {
          "symbol": "δ₁",
          "formula": "||ASFID_mean − REVOI_mean|| / √2",
          "meaning": "Measure of non-isomorphism of Φ — Korzybski principle: Φ is never a perfect isomorphism"
        },
        "korzybski": "The map is not the territory — Gt ≠ Gm structurally, δ₁ > 0 in all real systems",
        "see_also": "M3_GenesisGrammar.jsonld for complete bicephalous architecture"
      },
      "metaphor": {
        "image": "Eagle soaring above the territory",
        "vision": "Penetrating sight that perceives reality as-is",
        "action": "Observes, measures, analyzes",
        "domain": "Territory (Reality)",
        "perspective": "From above, comprehensive view",
        "visual_acuity": "8× human vision - precision at distance"
      },
      "dual_axes_position": {
        "model_reality_axis": "Reality",
        "analysis_synthesis_axis": "Analysis",
        "quadrant": "Analysis of Reality (Territory)"
      },
      "independence_matrix": {
        "dcterms:description": "The 5 primitive types {A,St,F,It,D} are analytically independent — no primitive type is derivable from the others",
        "verified": "true",
        "skos:note": "Independence here means conceptual non-redundancy, not metric orthogonality. No inner product is defined or required."
      },
      "complementary_grammar": {
        "@id": "m3:sphinx_eye:SphinxEye",
        "dcterms:description": "Sphinx Eye provides Map Grammar Gm over primitive types {R,E,V,O,Im}, complementing Eagle's Territory Grammar Gt",
        "relationship": "structurally_complementary",
        "complete_architecture": "TSCG Bicephalous Grammar = Gt (Territory) + Gm (Map)"
      },
      "m3:changelog": [
        {
          "owl:versionInfo": "2.18.0",
          "dcterms:date": "2026-10-10",
          "adms:versionNotes": "ONE ROLE, ONE PROPERTY — batch 1 (Michel, 2026-10-10): the owl:Ontology header keeps dcterms:description only; the former rdfs:comment, a paraphrase, is merged into it and removed. Fixed on the way: the description said 'F_x : System → [0,1]' and the comment 'qualitative, no numeric scoring': the M0 scores are numeric in [0,1] and PROVISIONAL (stipulated by the KitArchitect role, credibility by accretion); the F_x notation is dropped (confusable with Fm2/Fm1m2). 'Bicephalous architecture' dropped."
        },
        {
          "owl:versionInfo": "2.17.0",
          "dcterms:date": "2026-10-08",
          "adms:versionNotes": "WS-5 DEBT LOT (A), decision Michel 2026-10-08 (Debt Overview §8.0): m3:ontologyType m3:GenesisExtension (one of the three perspectives of Genesis) and m3:metaphoricLabel \"Eagle Eye\", both declared in the apex M3_GrammarFoundation. Formalism named precisely (Michel, 2026-10-10): the COMMUTATIVE Lambek calculus — Lambek's 1958 calculus is non-commutative; the three TSCG operators ×, +, | are commutative on the types of their monoid, primitive or derived. Precedence unchanged: × (Gt) > + (Gm) > | (Gs)."
        },
        {
          "owl:versionInfo": "2.16.0",
          "dcterms:date": "2026-10-06",
          "adms:versionNotes": "WS-5 DEBT LOT (2a), decision D5(a) (Michel, 2026-10-06): removed the legacy 'changelog' object from the 'metadata' block (option i: dropped, not folded). Its entries (v2.5.0, v2.4.0, v2.3.0) predate the m3:changelog entries kept here and remain in git history; folding them would have exceeded the 7-entry M3 window. The only changelog is m3:changelog on the owl:Ontology node."
        },
        {
          "owl:versionInfo": "2.15.0",
          "dcterms:date": "2026-09-30",
          "adms:versionNotes": "WS-1 VOCABULARY CONSOLIDATION, lot 1i. owl:imports written as plain strings (JSON-LD literals: no reasoner followed them, so this file was reasoned in isolation and the apex declarations of M3_GrammarFoundation were invisible to it) rewritten as IRIs {\"@id\": ...}: 1 import(s). Target = the imported file's document URL, resolved by @base (Michel, 2026-09-30: aligning ontology IRIs with document URLs is recorded as a later lot). Triage: ontology/docs/_01_Worksite/WS-1/WS-1_FamilyA_Triage.md."
        },
        {
          "owl:versionInfo": "2.14.0",
          "dcterms:date": "2026-09-30",
          "adms:versionNotes": "WS-1 VOCABULARY CONSOLIDATION, lot 1g (Family A). Bare keys (dropped on JSON-LD expansion) replaced: alternative_names -> skos:altLabel, comment -> dcterms:description (consistent with lot 1b), note -> skos:note, definition -> skos:definition, label -> rdfs:label, title -> dcterms:title, id -> dcterms:identifier, rationale -> m3:rationale (declared in M3_GrammarFoundation, rdfs:subPropertyOf skos:note). In this file: note 1. Triage: ontology/docs/_01_Worksite/WS-1/WS-1_FamilyA_Triage.md."
        },
        {
          "owl:versionInfo": "2.13.0",
          "dcterms:date": "2026-09-30",
          "adms:versionNotes": "WS-1 VOCABULARY CONSOLIDATION, lot 1c (Family A). Changelog entry keys, previously bare and dropped on JSON-LD expansion, replaced by standards: version -> owl:versionInfo, date -> dcterms:date, changes -> adms:versionNotes (ADMS: a description of changes between this version and the previous one). Prefix adms declared in @context: ADMS accepted as an external vocabulary (Michel, 2026-09-30). Changelog entries become graph-visible. Legacy changelog forms (maps keyed by version, metadata blocks) left for a separate lot. Triage: ontology/docs/_01_Worksite/WS-1/WS-1_FamilyA_Triage.md."
        },
        {
          "owl:versionInfo": "2.12.0",
          "dcterms:date": "2026-09-30",
          "adms:versionNotes": "WS-1 VOCABULARY CONSOLIDATION, lot 1b (Family A). Bare key 'description' (declared in no @context, hence dropped on JSON-LD expansion) replaced by the standard dcterms:description (DCMI: an account of the resource; literal). Chosen over rdfs:comment on semantic grounds (Michel, 2026-09-30). 4 occurrences, all under bare parent keys: they stay graph-invisible until those are resolved (later WS-1 lot). Bare 'description' inside legacy 'metadata' blocks left untouched (separate lot). No semantic change: documentation made graph-visible. Triage: ontology/docs/_01_Worksite/WS-1/WS-1_FamilyA_Triage.md."
        }
      ]
    },
    {
      "@id": "m3:eagle_eye:physicalInterpretation",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Physical Interpretation (ASFID)",
      "rdfs:comment": "Concrete physical manifestations or analogues of the ASFID types in Territory",
      "rdfs:domain": {
        "@id": "m3:MonoidalType"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:definition": "Description of how the ASFID types manifests in physical, biological, or social systems as observable Territory phenomena",
      "skos:example": "Attractor → Stability basin, homeostatic set-point",
      "dcterms:created": "2026-02-16"
    },
    {
      "@id": "m3:eagle_eye:rangeAnalog",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Qualitative Range (ASFID)",
      "rdfs:comment": "Qualitative structural domain of the ASFID types in Territory — expressed as a spectrum, not a numeric scale.",
      "rdfs:domain": {
        "@id": "m3:MonoidalType"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:definition": "Description of the structural domain of this ASFID dimension as a qualitative spectrum from minimal/absent structural expression to maximal/dominant. Replaces the numeric [0,1] scale of the former Hilbert-space formalism with qualitative anchors compatible with the Structural Grammar formalism.",
      "skos:example": "Structure (S): minimal structural bonding (gas-like, no stable organisation) ↔ maximal structural order (crystalline, fully constrained lattice)",
      "dcterms:created": "2026-02-16"
    },
    {
      "@id": "m3:eagle_eye:criticalAxiom",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Structural Axiom (ASFID)",
      "rdfs:comment": "Universal structural principle or necessity governing the presence and role of this ASFID types in any non-degenerate system.",
      "rdfs:domain": {
        "@id": "m3:MonoidalType"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:definition": "A structural necessity or universal principle — expressed as a qualitative rule, not a numeric inequality — that must hold for this ASFID dimension in any observable system. Replaces scalar constraints (e.g., F ≥ 0.1) of the former Hilbert-space formalism with structural grammar rules.",
      "skos:example": "Flow (F) — Universal Openness Axiom: F is structurally necessary in any observable system; no real system is perfectly isolated from its environment. Expressed structurally: F cannot be absent from the structural formula of any non-degenerate system.",
      "dcterms:created": "2026-02-16"
    },
