# ============================================================================
# M1_Schema.shacl.ttl
# SHACL Grammar for TSCG M1 Layer
# Covers: M1_CoreConcepts.jsonld + all M1 Extension files
# ============================================================================
# Author : Echopraxium with the collaboration of Claude AI
# Version: 1.7.0
# 1.7.0 (WS-1 B2 lot C2, 2026-10-11): NEW SHAPE 12 NoComboPunningShape FORBIDS typing a combo
#   as an instance of a combo class (rdf:type m2:GenericConceptCombo / m2:DomainConceptCombo).
#   Lot C2 removed that typing from the 139 combos: an M1 combo is "@type": "owl:Class" with
#   rdfs:subClassOf the combo class. SHAPE 2/3 "Pattern" comments updated. The rdf:type branch of
#   the combo targets (1.6.0) is kept: a punned node stays in reach of the combo contract AND is
#   flagged by SHAPE 12. Counts unchanged on HEAD (SHAPE 12: 0 violations, focus = all owl:Class).
# 1.6.0 (WS-1 B2 lot C1, 2026-10-11): combos are DERIVED CLASSES, not instances. Every
#   combo shape (2, 3, 9, 10, 11) now targets its focus nodes by rdfs:subClassOf
#   m2:GenericConceptCombo / m2:DomainConceptCombo (sh:SPARQLTarget, pyshacl advanced=True)
#   instead of sh:targetClass, which selects by rdf:type and so depended on the combos being
#   punned as instances of the combo class. The rdf:type branch is KEPT in the target (UNION)
#   so that a node still typed as a combo instance remains in reach: no focus node is lost. SHAPE 2's escape hatch likewise tests
#   rdfs:subClassOf m2:DomainConceptCombo instead of sh:class. Same focus nodes today: the
#   counts must not move. Lot C2 then removes the instance typing from the data.
# 1.5.0 (WS-1 lot 1d, 2026-09-30): changelog container m2:changelog -> m3:changelog (recommended);
#   m2:changelog now FORBIDDEN (sh:maxCount 0). Entries: {owl:versionInfo, dcterms:date, adms:versionNotes}.
# 1.4.0 (SC-1 enforcement fix): SHAPE 9 ComboFormulaShape given dual sh:targetClass
#        (GenericConceptCombo + DomainConceptCombo). It had only the former with an
#        "inherited by" comment, so the three SC-1 rules (no monoidal operator in a
#        signature, no bare primitive as argument, correct arity) were enforced on
#        M1_CoreConcepts ONLY and on NO M1 extension. RAISING change: expect new
#        violations across the 14 extensions. Isolated golden lot.
# 1.3.0 (SC-5 hardening): SHAPE 10 extended to the full retired D8 serialisation triad
#        (Expanded + TeX + RawText, not Expanded alone). NEW SHAPE 11 forbids the M0
#        measurement m1/m2:hasEpistemicGap on M1 combo types (δ₁ is measured on an M0
#        instance). Both were blind spots: only Expanded had a shape, hasEpistemicGap had none.
# 1.2.0 (SC-5 pre-fix): SHAPE 2 no longer double-validates DomainConceptCombo
#        (sh:or escape hatch). Removes ~256 spurious violations in merged-corpus runs.
# Date   : 2026-10-11
# Status : Active
# ============================================================================

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

@prefix m3: <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M3_GenesisGrammar.jsonld#> .
@prefix m2: <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#> .
@prefix m1: <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M1_CoreConcepts.jsonld#> .


# ============================================================================
# SHAPE 1 : M1 Ontology Node (owl:Ontology)
# Applies to ALL M1 files (CoreConcepts + Extensions)
# ============================================================================

m1:M1OntologyShape
    a sh:NodeShape ;
    sh:name "M1OntologyShape" ;
    sh:description "Validates the owl:Ontology header node of any M1 file." ;
    sh:targetClass owl:Ontology ;

    # --- Mandatory metadata ---
    sh:property [
        sh:path dcterms:creator ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^Echopraxium with the collaboration of Claude AI$" ;
        sh:message "REQUIRED: dcterms:creator must be 'Echopraxium with the collaboration of Claude AI'."
    ] ;
    sh:property [
        sh:path dcterms:created ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ;
        sh:message "REQUIRED: dcterms:created must be ISO 8601 date (YYYY-MM-DD)."
    ] ;
    sh:property [
        sh:path owl:versionInfo ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^[0-9]+\\.[0-9]+\\.[0-9]+$" ;
        sh:message "REQUIRED: owl:versionInfo must use semver format (X.Y.Z)."
    ] ;
    sh:property [
        sh:path m3:ontologyType ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "REQUIRED: m3:ontologyType must be declared exactly once."
    ] ;

    # --- m3:ontologyType must be DomainExtension or CoreConcepts ---
    sh:property [
        sh:path m3:ontologyType ;
        sh:in (
            <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M3_GenesisGrammar.jsonld#DomainExtension>
            <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M3_GenesisGrammar.jsonld#CoreConcepts>
        ) ;
        sh:message "FORBIDDEN: m3:ontologyType value must be m3:DomainExtension or m3:CoreConcepts."
    ] ;

    # --- owl:imports must reference M3_GenesisGrammar (not GenesisSpace) ---
    sh:sparql [
        sh:select """
            PREFIX owl: <http://www.w3.org/2002/07/owl#>
            SELECT $this ?import
            WHERE {
                $this owl:imports ?import .
                FILTER(CONTAINS(STR(?import), "M3_GenesisSpace"))
            }
        """ ;
        sh:message "FORBIDDEN: owl:imports references M3_GenesisSpace.jsonld — use M3_GenesisGrammar.jsonld instead."
    ] ;

    # --- m3:changelog recommended (WS-1 lot 1d, 2026-09-30: container moved from m2: to m3:) ---
    sh:property [
        sh:path m3:changelog ;
        sh:minCount 0 ;
        sh:message "RECOMMENDED: m3:changelog should be present: an array of {owl:versionInfo, dcterms:date, adms:versionNotes} objects, 3 most recent entries."
    ] ;

    # --- FORBIDDEN: retired m2:changelog container ---
    sh:property [
        sh:path m2:changelog ;
        sh:maxCount 0 ;
        sh:message "FORBIDDEN: m2:changelog is retired (WS-1 lot 1d) — use m3:changelog."
    ] ;

    # --- FORBIDDEN: GenesisSpace references ---
    sh:not [
        sh:property [
            sh:path rdfs:comment ;
            sh:pattern "GenesisSpace" ;
            sh:minCount 1
        ]
    ] ;
    sh:message "FORBIDDEN: M3_GenesisSpace reference — use M3_GenesisGrammar." ;
.


# ============================================================================
# SHAPE 2 : GenericConceptCombo (M1_CoreConcepts only)
# Pattern: "@type": "owl:Class", "rdfs:subClassOf": m2:GenericConceptCombo  (derived class, lot C2;
#          typing it rdf:type m2:GenericConceptCombo is forbidden by SHAPE 12)
# Formula: Fm2(...)
# ============================================================================

m1:GenericConceptComboShape
    a sh:NodeShape ;
    sh:name "GenericConceptComboShape" ;
    sh:description "Validates GenericConceptCombo subclasses (derived classes) in M1_CoreConcepts.jsonld ONLY. DomainConceptCombo (extension combos) are a subclass and are validated by SHAPE 3 alone; the sh:or escape branch below prevents the subclass-following sh:targetClass from double-validating them (fixes the ~256 spurious violations, SC-5)." ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select "SELECT DISTINCT ?this WHERE { { ?this <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#GenericConceptCombo> } UNION { ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#GenericConceptCombo> } }" ] ;
    sh:or (
        # Escape hatch: a DomainConceptCombo is validated by SHAPE 3, NOT here.
        [ sh:property [ sh:path rdfs:subClassOf ; sh:hasValue m2:DomainConceptCombo ; sh:minCount 1 ] ]
        # Genuine (non-domain) GenericConceptCombo contract:
        [
            sh:property [
                sh:path rdf:type ; sh:hasValue owl:Class ; sh:minCount 1 ;
                sh:message "REQUIRED: GenericConceptCombo must also be typed as owl:Class."
            ] ;
            sh:property [
                sh:path rdfs:subClassOf ; sh:hasValue m2:GenericConceptCombo ; sh:minCount 1 ;
                sh:message "REQUIRED: rdfs:subClassOf must point to m2:GenericConceptCombo for OWL hierarchy visibility."
            ] ;
            sh:property [
                sh:path rdfs:label ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:message "REQUIRED: rdfs:label must be present (PascalCase concept name)."
            ] ;
            sh:property [
                sh:path rdfs:comment ; sh:datatype xsd:string ; sh:minCount 1 ;
                sh:message "REQUIRED: rdfs:comment must define the concept."
            ] ;
            sh:property [
                sh:path m1:structuralGrammarFormula ; sh:datatype xsd:string ;
                sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^Fm2[²]?\\(" ;
                sh:message "REQUIRED: m1:structuralGrammarFormula must use Fm2(...) notation for GenericConceptCombos."
            ] ;
            sh:property [
                sh:path m1:structuralGrammarFormula ; sh:not [ sh:pattern "⊗" ] ;
                sh:message "FORBIDDEN: tensor notation in structuralGrammarFormula - use x / + / |."
            ]
        ]
    ) ;
    sh:message "GenericConceptCombo (non-domain, M1_CoreConcepts) must be an owl:Class, rdfs:subClassOf m2:GenericConceptCombo, carry rdfs:label + rdfs:comment, and use an Fm2(...) formula with no tensor operator." ;
.


# ============================================================================
# SHAPE 3 : DomainConceptCombo (M1 Extensions)          [renamed v1.1.0 — SC-1]
# Pattern: "@type": "owl:Class", "rdfs:subClassOf": m2:DomainConceptCombo  (derived class, lot C2;
#          typing it rdf:type m2:DomainConceptCombo is forbidden by SHAPE 12)
# Formula: Fm1m2(<Domain>+, <GenericConcept>+)
# NOTE: the m2:knowledgeField requirement below is a KNOWN PHANTOM (SC-5 fixes it,
#       replacing it with m2:appliesToDomains). Left untouched on purpose: SC-1
#       renames the combo class only and does not resolve the Domain duplicate.
# ============================================================================

m1:DomainConceptComboShape
    a sh:NodeShape ;
    sh:name "DomainConceptComboShape" ;
    sh:description "Validates DomainConceptCombo subclasses (derived classes) in M1 extension files." ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select "SELECT DISTINCT ?this WHERE { { ?this <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#DomainConceptCombo> } UNION { ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#DomainConceptCombo> } }" ] ;

    # --- Must also be typed as owl:Class ---
    sh:property [
        sh:path rdf:type ;
        sh:hasValue owl:Class ;
        sh:minCount 1 ;
        sh:message "REQUIRED: DomainConceptCombo must also be typed as owl:Class."
    ] ;

    # --- rdfs:subClassOf → m2:KnowledgeFieldConceptCombo (OWL hierarchy) ---
    sh:property [
        sh:path rdfs:subClassOf ;
        sh:hasValue m2:DomainConceptCombo ;
        sh:minCount 1 ;
        sh:message "REQUIRED: rdfs:subClassOf must point to m2:DomainConceptCombo for OWL hierarchy visibility."
    ] ;

    # --- m2:knowledgeField mandatory ---
    sh:property [
        sh:path m2:knowledgeField ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "REQUIRED: m2:knowledgeField must reference the domain KnowledgeField instance."
    ] ;

    # --- rdfs:label mandatory ---
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "REQUIRED: rdfs:label must be present (PascalCase concept name)."
    ] ;

    # --- m1:structuralGrammarFormula: must start with Fm1m2( ---
    sh:property [
        sh:path m1:structuralGrammarFormula ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:pattern "^Fm1m2\\(" ;
        sh:message "REQUIRED: m1:structuralGrammarFormula must use Fm1m2(<Domain>, ...) notation for DomainConceptCombos."
    ] ;

    # --- FORBIDDEN: ⊗ in formulas ---
    sh:property [
        sh:path m1:structuralGrammarFormula ;
        sh:not [
            sh:pattern "⊗"
        ] ;
        sh:message "FORBIDDEN: ⊗ tensor notation in structuralGrammarFormula — use × / + / |."
    ] ;

    # --- FORBIDDEN: old asfidSignature property ---
    sh:not [
        sh:property [
            sh:path <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M0_Poclet#asfidSignature> ;
            sh:minCount 1
        ]
    ] ;
    sh:message "FORBIDDEN: asfidSignature is deprecated — use m1:structuralGrammarFormula." ;
.


# ============================================================================
# SHAPE 4 : KnowledgeField Instance
# Pattern: ["owl:NamedIndividual", "m2:KnowledgeField"]
# ============================================================================

m1:KnowledgeFieldInstanceShape
    a sh:NodeShape ;
    sh:name "KnowledgeFieldInstanceShape" ;
    sh:description "Validates KnowledgeField instances (NOUN/ADJECTIVE forms)." ;
    sh:targetClass m2:KnowledgeField ;

    sh:property [
        sh:path rdf:type ;
        sh:hasValue owl:NamedIndividual ;
        sh:minCount 1 ;
        sh:message "REQUIRED: KnowledgeField must also be typed as owl:NamedIndividual."
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "REQUIRED: KnowledgeField must have rdfs:label."
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "REQUIRED: KnowledgeField must have rdfs:comment."
    ] ;
.


# ============================================================================
# SHAPE 5 : owl:Class general (plain domain classes in extensions)
# Applies to owl:Class nodes that are NOT GenericConceptCombo or KFCC
# ============================================================================

m1:PlainDomainClassShape
    a sh:NodeShape ;
    sh:name "PlainDomainClassShape" ;
    sh:description "Validates plain owl:Class nodes (non-combo specializations) in M1 extensions." ;

    # Target: owl:Class that is NOT a KnowledgeFieldConceptCombo
    sh:targetSubjectsOf rdfs:subClassOf ;

    # --- rdfs:label mandatory ---
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "REQUIRED: All M1 classes must have rdfs:label."
    ] ;

    # --- rdfs:comment mandatory ---
    sh:property [
        sh:path rdfs:comment ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:message "RECOMMENDED: M1 classes should have rdfs:comment."
    ] ;
.


# ============================================================================
# SHAPE 6 : Namespace Purity — FORBIDDEN patterns
# ============================================================================

m1:NamespacePurityShape
    a sh:NodeShape ;
    sh:name "NamespacePurityShape" ;
    sh:description "Enforces M1 namespace conventions and forbids obsolete patterns." ;
    sh:targetSubjectsOf rdf:type ;

    # FORBIDDEN: m2:characterizedBy
    sh:not [
        sh:property [
            sh:path m2:characterizedBy ;
            sh:minCount 1
        ]
    ] ;
    sh:message "FORBIDDEN: m2:characterizedBy is deprecated — remove it (Fm1m2() formula captures the relationship)." ;

    # FORBIDDEN: tensorFormula
    sh:not [
        sh:property [
            sh:path m1:tensorFormula ;
            sh:minCount 1
        ]
    ] ;
    sh:message "FORBIDDEN: m1:tensorFormula is obsolete — use m1:structuralGrammarFormula." ;

    # FORBIDDEN: hasTensorFormula
    sh:not [
        sh:property [
            sh:path m2:hasTensorFormula ;
            sh:minCount 1
        ]
    ] ;
    sh:message "FORBIDDEN: m2:hasTensorFormula is obsolete — use m1:structuralGrammarFormula." ;
.


# ============================================================================
# SHAPE 7 : m1:structuralGrammarFormula property constraints
# ============================================================================

m1:StructuralGrammarFormulaShape
    a sh:NodeShape ;
    sh:name "StructuralGrammarFormulaShape" ;
    sh:description "Validates m1:structuralGrammarFormula values across M1 files." ;
    sh:targetSubjectsOf m1:structuralGrammarFormula ;

    sh:property [
        sh:path m1:structuralGrammarFormula ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:pattern "^(Fm1m2|Fm2)\\(" ;
        sh:message "REQUIRED: structuralGrammarFormula must start with Fm1m2( or Fm2(."
    ] ;

    # FORBIDDEN: raw ⊗ tensor product
    sh:property [
        sh:path m1:structuralGrammarFormula ;
        sh:not [ sh:pattern "⊗" ] ;
        sh:message "FORBIDDEN: ⊗ in structuralGrammarFormula — replace with × (product) / | (bridge) / + (sum)."
    ] ;

    # FORBIDDEN: ORIVE (should be REVOI)
    sh:property [
        sh:path m1:structuralGrammarFormula ;
        sh:not [ sh:pattern "ORIVE" ] ;
        sh:message "FORBIDDEN: ORIVE terminology — use REVOI (Representability, Evolvability, Verifiability, Observability, Interoperability)."
    ] ;
.


# ============================================================================
# CHANGELOG
# ============================================================================
#
# v1.0.0 (2026-05-26)
#   Initial M1 SHACL grammar. 7 shapes covering:
#   - M1OntologyShape          : owl:Ontology header validation
#   - GenericConceptComboShape  : Fm2() combos in CoreConcepts
#   - KFConceptComboShape       : Fm1m2() combos in Extensions
#   - KnowledgeFieldShape       : NOUN/ADJECTIVE KF instances
#   - PlainDomainClassShape     : specialization classes
#   - NamespacePurityShape      : forbidden deprecated patterns
#   - StructuralGrammarShape    : formula format validation
#
# ============================================================================

# ============================================================================
# SHAPE 8 : m1:CorePattern NamedIndividual
# CorePatterns are NamedIndividuals with raw structural formulas (no Fm2 wrapping)
# ============================================================================

m1:CorePatternShape
    a sh:NodeShape ;
    sh:name "CorePatternShape" ;
    sh:description "Validates m1:CorePattern NamedIndividuals in M1_CoreConcepts." ;
    sh:targetClass m1:CorePattern ;

    sh:property [
        sh:path rdf:type ;
        sh:hasValue owl:NamedIndividual ;
        sh:minCount 1 ;
        sh:message "REQUIRED: CorePattern must be typed as owl:NamedIndividual."
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "REQUIRED: CorePattern must have rdfs:label."
    ] ;
    sh:property [
        sh:path m1:structuralGrammarFormula ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:message "OPTIONAL: CorePattern may have a raw structural formula (× / + / | notation)."
    ] ;
.

# ============================================================================
# SHAPE 9 : ComboFormulaShape  — A COMBO'S FORMULA *IS* A FUNCTION SIGNATURE
# ----------------------------------------------------------------------------
# SC-1, 2026-07-12. See StructuralGrammar/Functional_Grammar_Model.md.
#
#   Fm2   : GenericConcept²⁺           -> m2:GenericConceptCombo
#   Fm1m2 : Domain⁺, GenericConcept⁺   -> m2:DomainConceptCombo
#
# Fm2/Fm1m2 are FUNCTIONS, not functors: emergence is non-compositional, so a
# combo has NO monoidal expansion. Its formula is the signature — nothing else.
# Arguments are NAMED CONCEPTS, juxtaposed by comma, never joined by an operator.
# ============================================================================

m1:ComboFormulaShape
    a sh:NodeShape ;
    sh:name "ComboFormulaShape" ;
    sh:description "A combo's structuralGrammarFormula is a function signature: no monoidal operator, no primitive as argument, correct arity." ;
    # DUAL TARGET (v1.4.0): the "inherited by" assumption was FALSE in practice —
    # SHAPE 9 never fired on any M1 extension (all extension combos are typed
    # m2:DomainConceptCombo). Verified empirically 2026-07-22 on M1_Geology:
    # 17 violations reported, ZERO from SHAPE 9, despite formulas that plainly
    # violate SC-1 (monoidal operators + bare primitives as arguments).
    # Same Fix-B trap already corrected on SHAPE 10 / SHAPE 11 in v1.3.0.
    sh:target [ a sh:SPARQLTarget ;
        sh:select "SELECT DISTINCT ?this WHERE { { ?this <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#GenericConceptCombo> } UNION { ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#GenericConceptCombo> } UNION { ?this <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#DomainConceptCombo> } UNION { ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#DomainConceptCombo> } }" ] ;

    # --- FORBIDDEN: monoidal operators inside a signature -------------------
    # x / + / | belong to ATOM formulas only. In a signature they would assert
    # the compositional (functorial) reading that SC-1 retires.
    sh:property [
        sh:path m1:structuralGrammarFormula ;
        sh:not [ sh:pattern "[×+|⊗]" ] ;
        sh:severity sh:Violation ;
        sh:message "FORBIDDEN (SC-1): monoidal operator (× / + / | / ⊗) inside a combo formula. A combo's formula IS a function signature — arguments are juxtaposed by comma, never joined by a grammar operator. Monoidal formulas belong to ATOMS only."
    ] ;

    # --- FORBIDDEN: a bare primitive type as an argument ---------------------
    # ASFID {A,S,F,I,D} + REVOI {R,E,V,O,Im} + TKSL {T,K,Ss,L} + subscripted
    # {St,It,Ss,Im}. A primitive is a generative DIMENSION of a grammar, not a
    # GenericConcept, hence not a legal argument.
    sh:property [
        sh:path m1:structuralGrammarFormula ;
        sh:not [ sh:pattern "[(,][ ]*(A|S|F|I|D|R|E|V|O|T|K|L|St|Ss|It|Im)[ ]*[,)]" ] ;
        sh:severity sh:Violation ;
        sh:message "FORBIDDEN (SC-1): primitive type used as an argument of Fm2/Fm1m2. Arguments must be NAMED CONCEPTS declared in M2_GenericConcepts.jsonld or M1_CoreConcepts.jsonld."
    ] ;

    # --- REQUIRED: a well-formed signature, correct arity (D5) ---------------
    # Fm2   : >= 2 concept arguments  -> at least one comma
    # Fm1m2 : >= 1 domain AND >= 1 concept -> at least one comma
    # (A domain-less Fm1m2 is an Fm2 that mislabelled itself.)
    sh:property [
        sh:path m1:structuralGrammarFormula ;
        sh:pattern "^(Fm2|Fm1m2)\\([^,()]+,[^()]+\\)$" ;
        sh:severity sh:Violation ;
        sh:message "REQUIRED (SC-1): formula must be a well-formed signature Fm2(a, b, ...) or Fm1m2(Domain, a, ...) with at least two arguments. Fm2 needs >= 2 concepts (an emergence needs two ingredients); Fm1m2 needs >= 1 Domain AND >= 1 GenericConcept."
    ] ;
.


# ============================================================================
# SHAPE 10 : NoMonoidalExpansionShape  — retired D8 serialisation triad
#            (structuralGrammarFormulaExpanded / TeX / RawText)
# ----------------------------------------------------------------------------
# SC-1 / Decision D8, 2026-07-12.
# This property stored the "expansion" of a combo as a monoidal formula, e.g.
# "S × I × A × D × F" — i.e. lattice_join(dims(parents)), the union of the
# parents' dimensions. That is precisely the COMPOSITIONAL thesis SC-1 retires
# (with m2:morphism_emergence, from which it descends). If emergence is
# non-compositional, there is nothing to expand: the property has no referent,
# which is why half its occurrences are empty strings.
# ============================================================================

m1:NoMonoidalExpansionShape
    a sh:NodeShape ;
    sh:name "NoMonoidalExpansionShape" ;
    sh:description "A combo has no monoidal expansion (emergence is non-compositional). Forbids the whole retired D8 triad: the expansion and its TeX/RawText serialisations." ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select "SELECT DISTINCT ?this WHERE { { ?this <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#GenericConceptCombo> } UNION { ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#GenericConceptCombo> } UNION { ?this <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#DomainConceptCombo> } UNION { ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#DomainConceptCombo> } }" ] ;   # per-file reach: core AND extension combos

    sh:property [
        sh:path m1:structuralGrammarFormulaExpanded ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "FORBIDDEN (SC-1/D8): m1:structuralGrammarFormulaExpanded is retired. A combo has NO monoidal expansion — the arguments are combined, not associated. Superseded by the function signature carried by m1:structuralGrammarFormula."
    ] ;

    sh:property [
        sh:path m1:structuralGrammarFormulaTeX ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "FORBIDDEN (SC-1/D8): m1:structuralGrammarFormulaTeX is retired — the TeX serialisation of the non-existent monoidal expansion (several instances still carried the obsolete ×⇒ operator). Removed in M1_CoreConcepts v2.9.0."
    ] ;

    sh:property [
        sh:path m1:structuralGrammarFormulaRawText ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "FORBIDDEN (SC-1/D8): m1:structuralGrammarFormulaRawText is retired — the plain-text serialisation of the same non-existent expansion. Removed in M1_CoreConcepts v2.9.0."
    ] ;
.


# ============================================================================
# SHAPE 11 : NoM0MeasurementInM1Shape  — m1/m2:hasEpistemicGap
# ----------------------------------------------------------------------------
# SC-5, 2026-07-17.
# An epistemic gap (delta_1) is a Map/Territory divergence MEASURED on a concrete
# modelled system — an M0 quantity. An M1 combo is an abstract TYPE; it has no
# epistemic gap (measured on which system, by whom?). A scalar delta_1 sitting on
# a combo is an M0 measurement leaking one storey up. Attested: 12 occurrences
# removed from M1_CoreConcepts v2.9.0.
# This shape is the ANCHOR for M0-measurement leaks into M1 — extend its
# sh:property list as further leaks are ATTESTED (anti-overfitting: never
# pre-emptively, only against a real residue).
# NOTE: the property is declared m2:hasEpistemicGap but was serialised m1:...;
# both spellings are forbidden here so neither can re-enter.
# Scope: combo TYPES only (targetClass), NOT the owl:Ontology node — whose
# numeric metadata (conceptsDefined, dimensions, ...) are legitimate file stats.
# ============================================================================

m1:NoM0MeasurementInM1Shape
    a sh:NodeShape ;
    sh:name "NoM0MeasurementInM1Shape" ;
    sh:description "An M1 combo TYPE carries no M0 measurement (e.g. epistemic gap delta_1 is measured on a modelled M0 system, not on an abstract type)." ;
    sh:target [ a sh:SPARQLTarget ;
        sh:select "SELECT DISTINCT ?this WHERE { { ?this <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#GenericConceptCombo> } UNION { ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#GenericConceptCombo> } UNION { ?this <http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#DomainConceptCombo> } UNION { ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#DomainConceptCombo> } }" ] ;   # per-file reach: core AND extension combos

    sh:property [
        sh:path m1:hasEpistemicGap ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "FORBIDDEN (SC-5): m1:hasEpistemicGap is an M0 measurement (delta_1 = Map/Territory divergence of a modelled system) leaking into an abstract M1 combo type. Epistemic gap belongs to an M0 instance, not to a combo type. Removed in M1_CoreConcepts v2.9.0."
    ] ;

    sh:property [
        sh:path m2:hasEpistemicGap ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "FORBIDDEN (SC-5): m2:hasEpistemicGap (declared IRI of the same delta_1 measurement) must not appear on an M1 combo type either. Epistemic gap is an M0 measurement."
    ] ;
.

#############################################################################
# SHAPE 10 : Facet + FacetValue  (SC-3 m3:Facet mechanism, M1-declared)
# First facets declared outside M3 (Cartography domain, 2026-09-09).
# Guard-rail: every m3:FacetValue must be typed skos:Concept and point to
# exactly one m3:Facet via m3:valueOf.
#############################################################################

m1:FacetShape
    a sh:NodeShape ;
    sh:name "FacetShape" ;
    sh:description "Validates m3:Facet axes declared in M1 extensions (SC-3 mechanism)." ;
    sh:targetClass m3:Facet ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue skos:ConceptScheme ;
        sh:severity sh:Violation ;
        sh:message "REQUIRED: an m3:Facet axis must also be typed skos:ConceptScheme."
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "REQUIRED: m3:Facet must carry an rdfs:label."
    ] .

m1:FacetValueShape
    a sh:NodeShape ;
    sh:name "FacetValueShape" ;
    sh:description "Validates m3:FacetValue foci declared in M1 extensions. Every value must be typed and belong to exactly one axis." ;
    sh:targetClass m3:FacetValue ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue skos:Concept ;
        sh:severity sh:Violation ;
        sh:message "REQUIRED: an m3:FacetValue must also be typed skos:Concept."
    ] ;
    sh:property [
        sh:path m3:valueOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class m3:Facet ;
        sh:severity sh:Violation ;
        sh:message "REQUIRED: each m3:FacetValue must declare exactly one m3:valueOf pointing to an m3:Facet."
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "REQUIRED: m3:FacetValue must carry an rdfs:label."
    ] .

#############################################################################
# SHAPE 11 : Domain registry entries (M1_Domains)
# Validates m1:instanceCount / m1:instanceExamples and forbids the retired
# poclet* vocabulary (renamed 2026-09: a domain lists INSTANCES of several
# kinds, not only poclets).
#############################################################################

m1:DomainShape
    a sh:NodeShape ;
    sh:name "DomainShape" ;
    sh:description "Validates m1:Domain registry entries in M1_Domains." ;
    sh:targetClass m1:Domain ;
    sh:property [
        sh:path m1:instanceCount ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0 ;
        sh:severity sh:Violation ;
        sh:message "REQUIRED: each m1:Domain must declare exactly one m1:instanceCount (xsd:integer >= 0)."
    ] ;
    sh:property [
        sh:path m1:instanceExamples ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "m1:instanceExamples values must be strings (M0 instance identifiers)."
    ] ;
    sh:property [
        sh:path m1:pocletCount ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "RETIRED (2026-09): m1:pocletCount renamed to m1:instanceCount. 'poclet' is too narrow — a domain lists instances of several kinds (poclets, TscgTools, SystemicFrameworks, SymbolicSystemGrammars)."
    ] ;
    sh:property [
        sh:path m1:pocletExamples ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "RETIRED (2026-09): m1:pocletExamples renamed to m1:instanceExamples."
    ] .


# ============================================================================
# SHAPE 12 : NoComboPunningShape  — a combo is a DERIVED CLASS, never an instance
#            (WS-1 B2 lot C2, Debt Overview §8.0f — Michel, 2026-10-11)
# ----------------------------------------------------------------------------
# Classes live in M2/M1, instances in M0. An M1 combo is declared
#     "@type": "owl:Class", "rdfs:subClassOf": {"@id": "m2:DomainConceptCombo"}
# and NEVER  "@type": [..., "m2:DomainConceptCombo"]  (that types the class as an
# INSTANCE of the combo class: OWL punning, the class/instance mixing the reasoner
# reported). Lot C2 removed that typing from the 139 combos; this shape keeps it out.
# Targets: every owl:Class (so the shape always has focus nodes and bites on any M1
# file) plus anything typed by a combo class directly (a punned node without
# owl:Class is caught too). One violation per offending rdf:type value.
# ============================================================================

m1:NoComboPunningShape
    a sh:NodeShape ;
    sh:name "NoComboPunningShape" ;
    sh:description "FORBIDS rdf:type m2:GenericConceptCombo / m2:DomainConceptCombo: an M1 combo is a derived class (rdfs:subClassOf), never an instance of the combo class (lot C2)." ;
    sh:targetClass owl:Class , m2:GenericConceptCombo , m2:DomainConceptCombo ;
    sh:property [
        sh:path rdf:type ;
        sh:not [ sh:in ( m2:GenericConceptCombo m2:DomainConceptCombo ) ] ;
        sh:severity sh:Violation ;
        sh:message "FORBIDDEN: a combo class typed as an INSTANCE of a combo class. Remove m2:GenericConceptCombo / m2:DomainConceptCombo from @type (keep \"owl:Class\") and attach it with rdfs:subClassOf {\"@id\": \"m2:...ConceptCombo\"} (lot C2, class/instance separation)."
    ] .
