      ]
    },
    {
      "@id": "m3:F_instantiation",
      "@type": [
        "owl:NamedIndividual",
        "m3:Functor"
      ],
      "rdfs:label": "Instantiation Functor",
      "rdfs:comment": "Functor mapping M2 metaconcepts to M1 domain-specific concepts.",
      "m3:functorType": "covariant",
      "m3:signature": "F_inst: Cat_M2 → Cat_M1",
      "m3:examples": [
        "F_inst(Link) = ChemicalLink (in Chemistry)",
        "F_inst(Processor) = BiologicalProcessor (in Biology)",
        "F_inst(Component) = MechanicalComponent (in Mechanics)"
      ]
    },
    {
      "@id": "m3:F_ArchitecturalAmendments",
      "@type": "owl:NamedIndividual",
      "rdfs:label": "Flow Type Architectural Amendments v3.9.0",
      "rdfs:comment": "Three amendments to the Flow (F) type of ASFID, emerging from the Ranaora & Yii poclet session (2026-03-23). Amendments 1 (structural optionality) and 2 (morphic capacity) are additive and non-destructive. Amendment 3 was REDUCED on 2026-06-29: its continuous numeric F-spectrum (F_crit, F_max, F_total conservation) was removed as a scalar residue inconsistent with m3:MonoidalType; the qualitative latent/active distinction is retained via m2:Potentialization poles. Existing M2 structural compositions remain valid (no concept references the removed spectrum).",
      "dcterms:date": "2026-03-23",
      "dcterms:source": "DOI: 10.5281/zenodo.19160047",
      "m3:amendmentType": "additive",
      "m3:targetType": "F (Flow) — Eagle Eye / ASFID",
      "m3:amendment_1": {
        "dcterms:identifier": "F_axiom_relaxation",
        "dcterms:title": "F Axiom Relaxed: F structurally optional in ground states",
        "status": "DECIDED",
        "before": "F ≠ 0 — F structurally necessary condition for system existence",
        "after": "F structurally optional in boundary/ground states (e.g., vacuum, degenerate systems where F is absent from the structural formula). Replaces numeric F≥0 with qualitative structural optionality.",
        "m3:rationale": "F=0 represents the lowest degraded energy level of a system, not its absence. Examples: tardigrade cryptobiosis, quantum ground state |0⟩, suspended thread, dormant seed. The old axiom was over-restrictive — it excluded legitimate resting states from TSCG modeling.",
        "groundState": {
          "rdfs:label": "Stase",
          "m2Formula": "S×A",
          "m2Reference": "m2:Stase",
          "reversibility": "necessarily reversible — D absent from structural formula by construction"
        },
        "sealedGroundState": {
          "rdfs:label": "Absorbing State",
          "m2Formula": "S×A×F×I×D",
          "m2Reference": "m2:AbsorbingState",
          "reversibility": "irreversible — Entropy seals return path"
        }
      },
      "m3:amendment_2": {
        "dcterms:identifier": "F_morphic_annotation",
        "dcterms:title": "F Morphic Capacity: F ∈ Mor(Cat_M3) ∩ Ob(Cat_M3)",
        "status": "DECIDED",
        "formalAxiom": "F ∈ Mor(Cat_M3) ∩ Ob(Cat_M3)",
        "m3:rationale": "F is the only ASFID types whose definition structurally requires a source AND a target. A flux cannot exist without transport direction. A, S, I, D can describe static states — F is intrinsically relational. This emergent asymmetry was not designed but discovered through analysis.",
        "consequence_forM2": "Any M2 structural formula containing F is a natural candidate for dual entity/morphism ontological nature. M2 property m2:ontologicalNature='entity_and_morphism' applies to all F-containing structural formulas.",
        "consequence_forF0": "F=0 means no active morphisms: Mor_active(Cat_M3) = ∅. System in Stase (ground state) — valid per Amendment 1.",
        "dimensionRoles": {
          "A_S_I_D": "object types — describe system states",
          "F": "morphism type — describes transitions between states"
        }
      },
      "m3:amendment_3": {
        "dcterms:identifier": "F_activation_modes",
        "dcterms:title": "F Activation Modes: latent / active as qualitative pole states (not a numeric spectrum)",
        "status": "REDUCED",
        "supersedes": "F_potential_active_spectrum (v3.9.0) — the continuous numeric spectrum (F_crit, F_max, the 0<F<F_crit band, and F_total conservation) is removed as a scalar residue inconsistent with m3:MonoidalType (qualitative, no metric at M3). Reduced 2026-06-29.",
        "m3:rationale": "When present, F has two qualitative activation modes — latent and active — connected by the poles of m2:Potentialization (_^ mobilization, _$ depletion). This is NOT a numeric continuum: F is a generator, present or absent in a structural formula (per Amendment 1), and when present it is qualitatively latent or active. Any magnitude ('how much flow') is an M0 instance score (F_score in the M0 ValueSpace), never an M3 axiom — per m3:MonoidalType.",
        "activationModes": {
          "absent": "F omitted from the structural formula — Stase (m2:Stase, S×A); the degenerate case of Amendment 1",
          "latent": "F present but dormant — structural flow capacity not currently transporting",
          "active": "F present and mobilized — effective morphism / transport operator"
        },
        "category3Resolution": {
          "concepts": [
            "Resource",
            "Storage",
            "Hub",
            "Stateful",
            "Environment"
          ],
          "interpretation": "These M2 concepts carry F in the latent activation mode (dormant Potentialization state) — not a contradiction. Their formulas legitimately contain F as structural flow capacity; whether a given instance is actively flowing is an M0 score, not an M3 property."
        },
        "transitionOperators": {
          "Potentialization_plus": "latent/absent → active (mobilization) — m2:Potentialization pole _^",
          "Potentialization_minus": "active → latent/absent (depletion) — m2:Potentialization pole _$"
        },
        "magnitudeNote": "Flow magnitude lives at M0 as F_score (xsd:float in [0,1]); the M3 grammar carries only the qualitative present/absent and latent/active distinctions."
      }
    },
    {
      "@id": "m3:F_CategoryTheoryNote",
      "@type": "owl:NamedIndividual",
      "rdfs:label": "M3 Categorical Structure — Theoretical Note on F Asymmetry",
      "rdfs:comment": "The F_morphic amendment (v3.9.0) reveals that M3 has richer categorical structure than a pure homogeneous metric space. ASFID types are not equivalent: {A,S,I,D} describe objects, {F} describes morphisms. This suggests M3 is closer to an enriched category or fibered space than to a simple cartesian product of homogeneous dimensions.",
      "m3:status": "HYPOTHESIS — requires expert mathematical review",
      "m3:currentModel": "M3 as Structural Grammar G_T (Territory) + G_M (Map) — free commutative monoidal (post-reform)",
      "m3:proposedModel": "M3 as enriched category Cat_M3 with Ob={A,S,I,D}-described states and Mor={F}-described transitions",
      "m3:fiberBundleInterpretation": {
        "base": "{A,S,I,D} — object-space (states)",
        "fiber": "{F} — morphism-space (flows over each state)",
        "interpretation": "Each system state (point in base) has a fiber of possible flows (F-values, from 0 to F_max)"
      },
      "m3:implicationForStructuralComposition": "F-containing M2 structural formulas naturally encode morphic capacity. M2 = ×-products of object-dimensions (static) combined with F (dynamic relational component). This is consistent with existing structural composition — it adds interpretive depth, not contradiction.",
      "m3:riskAssessment": "Low — the amendment is interpretive and additive. All existing M2 structural formulas remain valid. No refactoring of M3_EagleEye.jsonld required.",
      "m3:futureWork": "Formal proof of M3 as fibered category. Expert review of F ∈ Mor(Cat_M3) ∩ Ob(Cat_M3) axiom. Investigation of higher-order morphisms in M3."
    },
    {
      "@id": "m3:Facet",
      "@type": "owl:Class",
      "rdfs:label": "Facet",
      "rdfs:comment": "A classificatory axis (Ranganathan faceted classification, 1933): an orthogonal, non-derivable dimension that files instances without altering the backbone type tree. Each individual 'a m3:Facet' is also a skos:ConceptScheme. Values are m3:FacetValue. Semantically a conferred, contingent, Map-perspective role (anchored on m2:Role Ss|K); distinct from ScoringProperty/FocalProperty."
    },
    {
      "@id": "m3:FacetValue",
      "@type": "owl:Class",
      "rdfs:comment": "A value of a facet (the 'focus' in Ranganathan's sense). Also a skos:Concept. Belongs to exactly one axis via m3:valueOf. MAY carry contractual obligations directly as its own properties (SHACL-enforced on any carrier that declares it)."
    },
    {
      "@id": "m3:valueOf",
      "@type": "owl:ObjectProperty",
      "rdfs:subPropertyOf": {
        "@id": "skos:inScheme"
      },
      "rdfs:domain": {
        "@id": "m3:FacetValue"
      },
      "rdfs:range": {
        "@id": "m3:Facet"
      },
      "rdfs:comment": "Links a facet value to the axis (m3:Facet individual) it is a value of. Closes any inter-value relation within one axis."
    },
    {
      "@id": "m3:hasFacetValue",
      "@type": "owl:ObjectProperty",
      "rdfs:range": {
        "@id": "m3:FacetValue"
      },
      "rdfs:comment": "Declares that this instance carries one or more facet values. Multi-valued. Values MUST be IRIs of registered m3:FacetValue individuals. FORBIDDEN: bare string values. Replaces m0:hasFacet."
    },
    {
      "@id": "m3:Audience",
      "@type": [
        "m3:Facet",
        "skos:ConceptScheme"
      ],
      "rdfs:label": "Audience",
      "rdfs:comment": "AUDIENCE facet: for whom the artifact is produced (read 'for whom', not 'by whom'). Values follow the Kit produce->consume chain — KitArchitect produces for KitCrafter, who produces for KitUser (offset by one along the chain) — but that ordering is documentation only: no relation property is graved (SC-3 Decision #3). Optional facet. Closed value-set."
    },
    {
      "@id": "m3:audience.KitArchitect",
      "@type": [
        "m3:FacetValue",
        "skos:Concept"
      ],
      "m3:valueOf": {
        "@id": "m3:Audience"
      },
      "rdfs:label": "KitArchitect",
      "rdfs:comment": "Models/refactors the ontology architecture (M3/M2/M1)."
    },
    {
      "@id": "m3:audience.KitCrafter",
      "@type": [
        "m3:FacetValue",
        "skos:Concept"
      ],
      "m3:valueOf": {
        "@id": "m3:Audience"
      },
      "rdfs:label": "KitCrafter",
      "rdfs:comment": "Fabricates Kits using an Architect's ontologies."
    },
    {
      "@id": "m3:audience.KitUser",
      "@type": [
        "m3:FacetValue",
        "skos:Concept"
      ],
      "m3:valueOf": {
        "@id": "m3:Audience"
      },
      "rdfs:label": "KitUser",
      "rdfs:comment": "Uses what the Crafter fabricated. Absorbs the former m0:facet.Democratization (novice audience)."
    }
  ]
}