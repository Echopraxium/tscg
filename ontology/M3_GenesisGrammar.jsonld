{
  "@context": {
    "@base": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/",
    "dcterms": "http://purl.org/dc/terms/",
    "adms": "http://www.w3.org/ns/adms#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "m3": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M3_GenesisGrammar.jsonld#"
  },
  "@graph": [
    {
      "@id": "m3:GenesisGrammar",
      "@type": "owl:Ontology",
      "owl:versionInfo": "4.15.0",
      "dcterms:created": "2026-01-21",
      "dcterms:modified": "2026-10-08",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "dcterms:title": "TSCG M3 Genesis Grammar — the three perspectives",
      "dcterms:description": "M3 — the most abstract layer of the TSCG Layer Cake (M3 → M0), numbered as in the OMG/UML four-layer metamodel architecture: M3 is the level that every other layer instantiates; M0 holds the concrete instances. This file assembles the structural grammar of TSCG (commutative Lambek calculus): three perspectives, each readable through three lenses that name the same thing and complement each other. Structural-grammar lens: Gt (×), Gm (+), Gs (|). Epistemological lens: Territory (what a system is), Map (how it is known), Stereopsis (their synergy). Metaphoric lens: Eagle Eye, Sphinx Eye, Odin's Wisdom — in a TSCG interpretation of the Norse myth, Odin keeps one eye to see the world and leaves the other in Mímir's well to see into knowledge; his wisdom, born of both, is the Stereopsis. The couplings Φ : Gt → Gm (observation) and Ψ : Gm → Gt (interpretation) are its Synesthesia: one perspective evokes the other, never perfectly — the map is not the territory. The gap between Territory and Map (epistemic gap δ₁) is not a defect but the source of depth of the Stereopsis, as binocular disparity is for vision. Operators, type system and shared vocabulary are declared in the apex M3_GrammarFoundation.",
      "owl:imports": [
        { "@id": "M3_GrammarFoundation.jsonld" },
        { "@id": "M3_EagleEye.jsonld" },
        { "@id": "M3_SphinxEye.jsonld" },
        { "@id": "M3_BicephalousPerspective.jsonld" }
      ],
      "rdfs:label": "Genesis Grammar — Structural Grammar of the three perspectives",
      "metadata": {
        "layer": "M3",
        "name": "Genesis Grammar - Bicephalous Structural Grammar",
        "version": "4.4.0",
        "architecture": "bicephalous",
        "date_created": "2026-01-21",
        "date_modified": "2026-06-29",
        "authors": [
          "Echopraxium with the collaboration of Claude AI"
        ],
        "description": "Complete orthogonal basis for the TSCG framework, consisting of two complementary perspectives: Eagle Eye (ASFID) for Territory measurement and Sphinx Eye (REVOI) for Map construction. Integrates Category Theory formalization as mathematical foundation (definitions included in this file) for functors, morphisms, and categorical structure of TSCG layers."
      },
      "grammar_foundation": {
        "formalism": "Commutative Lambek Calculus / Free Commutative Monoidal Categories",
        "architecture": "Bicephalous Structural Grammar: Gt (Territory) + Gm (Map) — Gs is the reification of their stereopsic synergy",
        "grammars": {
          "Gt": "Territory Grammar — primitives {A,St,F,It,D} — ASFID (5) — Eagle Eye — ontological — operator ×",
          "Gm": "Map Grammar     — primitives {R,E,V,O,Im} — REVOI (5) — Sphinx Eye — epistemic — operator +",
          "Gs": "Stereopsis Grammar — primitives {T,_^,_$,K,Ss,L} — TKSL+poles (6) — Bicephalous — relational — operator | — Base16 extension"
        },
        "connection": {
          "Phi": "Φ : Gt → Gm  (natural transformation — observation: Territory → Map)",
          "Psi": "Ψ : Gm → Gt  (natural transformation — interpretation: Map → Territory)",
          "epistemic_gap": "δ₁ = ||ASFID_mean − REVOI_mean|| / √2",
          "korzybski": "Φ is never a perfect isomorphism — the map is not the territory"
        },
        "see_also": "M3_GrammarFoundation.jsonld for operators, type system, intersubjectiveBenchmark"
      },
      "bicephalous_architecture": {
        "dcterms:description": "Dual complementary perspectives forming complete basis",
        "m3:rationale": "Territory-Map distinction requires both observation (Eagle) and construction (Sphinx)",
        "eagle_eye": {
          "@id": "m3:eagle_eye:EagleEye",
          "basis": "ASFID",
          "basis_expansion": "Attractor, Structure, Flow, Information, Dynamics",
          "dimensions": 5,
          "role": "Territory measurement",
          "perspective": "Analysis",
          "orientation": "Model → Reality",
          "operation": "Observation and decomposition",
          "metaphor": "Eagle sees the Territory from above with penetrating vision",
          "rdfs:seeAlso": "M3_EagleEye.jsonld"
        },
        "sphinx_eye": {
          "@id": "m3:sphinx_eye:SphinxEye",
          "basis": "REVOI",
          "basis_expansion": "Representable, Evolvable, Verifiable, Observable, Interoperable",
          "dimensions": 5,
          "role": "Map construction",
          "perspective": "Synthesis",
          "orientation": "Reality → Model",
          "operation": "Integration and construction",
          "metaphor": "Sphinx poses riddles and constructs Maps through enigmatic wisdom",
          "rdfs:seeAlso": "M3_SphinxEye.jsonld"
        },
        "complementarity": {
          "relationship": "structurally_complementary",
          "independence": "verified (no ASFID primitive derivable from REVOI and vice versa)",
          "completeness": "all systems characterisable via Gt primitives (empirical) and Gm primitives (epistemic)",
          "duality": {
            "territory_map": "Eagle observes Territory, Sphinx constructs Map",
            "analysis_synthesis": "Eagle decomposes, Sphinx composes",
            "model_reality": "Eagle measures Reality, Sphinx builds Model"
          },
          "feedback_loop": {
            "forward": "Φ: ASFID → REVOI (observation)",
            "backward": "Ψ: REVOI → ASFID (interpretation)",
            "iteration": "iterative refinement via Φ/Ψ natural transformations until epistemic equilibrium",
            "convergence": "δ₁ → 0 represents epistemic equilibrium (Map ≈ Territory)",
            "korzybski_principle": "Map influences how we observe Territory, Territory observations refine Map"
          }
        },
        "stereopsis_reification": {
          "dcterms:description": "Gs (Stereopsis Grammar) is the reification of the stereopsic synergy between Eagle Eye and Sphinx Eye. TSCG remains bicephalous — Gs does not add a third head but formalizes what the two heads produce together.",
          "grammar": "Gs over {T}",
          "operator": "|",
          "see_also": "M3_BicephalousPerspective.jsonld"
        }
      },
      "category_theory_foundation": {
        "dcterms:description": "Category Theory provides mathematical foundation for TSCG structure",
        "category_theory": {
          "@id": "m3:CategoryTheory",
          "rdfs:seeAlso": "Definitions below in this @graph",
          "role": "Mathematical foundation",
          "provides": [
            "MathematicalCategory class",
            "CategoryObject class",
            "Morphism class",
            "Functor class",
            "NaturalTransformation class",
            "Adjunction class",
            "Properties for categorical annotations"
          ]
        },
        "tscg_as_categories": {
          "Cat_TSCG": "Category of TSCG layers {M3, M2, M1, M0}",
          "Cat_M3_ASFID": "Category of Territory Grammar Gt primitives {A, St, F, It, D} — ASFID (5)",
          "Cat_M3_REVOI": "Category of Map Grammar Gm primitives {R, E, V, O, Im} — REVOI (5)",
          "Cat_M2": "Category of metaconcepts (defined in M2)",
          "Cat_KnowledgeField": "Category of knowledge fields (defined in M2)",
          "Cat_M3_Gs": "Category of Stereopsis Grammar Gs primitives {T,_^,_$,K,Ss,L} — TKSL+poles (6) — bicephalous relational types — Base16"
        },
        "functors": {
          "F_structuralFormula": "F_×: Cat_M3 → Cat_M2 (structural grammar operators create GenericConcept types)",
          "F_instantiation": "F_inst: Cat_M2 → Cat_M1 (metaconcepts → domain concepts)",
          "F_concretize": "Cat_M1 → Cat_M0 (concepts → concrete instances)"
        },
        "morphisms": {
          "inclusion": "↪ (e.g., Homeostasis ↪ Regulation)",
          "composition": "∘ (e.g., Learning = Memory ∘ Adaptation)",
          "duality": "op (e.g., Divergence = Convergence^op)",
          "emergence": "⇒ (e.g., MetaconceptCombo: M_A × M_B ⇒ M_C)"
        },
        "reification": {
          "dcterms:description": "Objects in categories are reifications (concrete instances)",
          "skos:example": "Chemistry is an object in Cat_KnowledgeField (reification of KnowledgeField category)"
        },
        "integration_note": "Category Theory definitions integrated directly in this file (not imported)"
      },
      "dual_axes_framework": {
        "axis_1": {
          "rdfs:label": "Model vs Reality",
          "eagle_position": "Reality (measures the Territory as-is)",
          "sphinx_position": "Model (constructs the Map representation)"
        },
        "axis_2": {
          "rdfs:label": "Analysis vs Synthesis",
          "eagle_position": "Analysis (decomposes into ASFID types)",
          "sphinx_position": "Synthesis (composes via REVOI operations)"
        },
        "quadrants": [
          "Analysis of Reality (Eagle dominant)",
          "Synthesis of Reality (Eagle-Sphinx bridge)",
          "Analysis of Model (Eagle-Sphinx bridge)",
          "Synthesis of Model (Sphinx dominant)"
        ]
      },
      "derived_layers": [
        {
          "@id": "M2_MetaConcepts.jsonld",
          "layer": "M2",
          "relationship": "foundation_of",
          "dcterms:description": "M3 primitive types generate M2 derived types via structural grammar operators",
          "mechanisms": [
            {
              "source": "m3:eagle_eye:EagleEye",
              "operation": "projects_onto",
              "formula": "Gt primitives → 𝕋₁ type expressions via ×",
              "dcterms:description": "Each ASFID types projects onto all M2 metaconcepts, creating 5D analytical perspective on each metaconcept"
            },
            {
              "source": "m3:sphinx_eye:SphinxEye",
              "operation": "constructs_from",
              "formula": "Gm primitives → 𝕋₁ type expressions via +",
              "dcterms:description": "REVOI operations compose M2 metaconcepts into domain-specific patterns through synthetic construction"
            }
          ],
          "mathematical_relationship": "M2 types are derived from M3 primitive types via ×, + and | (including Gs bicephalous primitives from M3_BicephalousPerspective.jsonld)",
          "structural_grammar": "M2 GenericConcepts are named product types in the TSCG type system (𝕋₁)"
        }
      ],
      "validation": {
        "primitive_independence_test": {
          "status": "passed",
          "method": "Conceptual independence check — no primitive reducible to others",
          "result": "All 16 primitive types are analytically independent (Base16: 5 ASFID + 5 REVOI + 6 TKSL+poles)"
        },
        "completeness_test": {
          "status": "passed",
          "method": "Verification across multiple poclets (Fire Triangle, Exposure Triangle, etc.)",
          "result": "All system aspects expressible in ASFID | REVOI"
        },
        "independence_test": {
          "status": "passed",
          "method": "Linear independence check",
          "result": "No ASFID types expressible via REVOI and vice versa"
        },
        "spanning_test": {
          "status": "passed",
          "method": "Domain coverage analysis",
          "result": "Physical, biological, social, abstract systems all representable"
        },
        "consistency_check": {
          "status": "passed",
          "method": "Cross-validation with established frameworks (TRIZ, Systems Theory)",
          "result": "No contradictions found"
        }
      },
      "evolution_history": {
        "v1.0": {
          "architecture": "tricephalous",
          "components": [
            "Genesis",
            "Eagle Eye",
            "Sphinx Eye"
          ],
          "date": "2020-2025",
          "issue": "Genesis role overlapped with Eagle Eye ASFID basis"
        },
        "v2.0": {
          "architecture": "bicephalous",
          "components": [
            "Eagle Eye (ASFID)",
            "Sphinx Eye (REVOI)"
          ],
          "date": "2026-01-21",
          "resolution": "Genesis merged into Eagle Eye, clarifying pure duality",
          "advantages": [
            "Cleaner mathematical structure",
            "Eliminated redundancy",
            "Stronger Territory-Map metaphor",
            "Better alignment with dual axes framework"
          ]
        },
        "v3.0": {
          "date": "2026-02-10",
          "changes": [
            "REVOI simplification (ability → able)",
            "Feedback loop formalization",
            "Coupling matrix Σ explicit"
          ]
        },
        "v3.0.1": {
          "date": "2026-02-16",
          "changes": [
            "Factorized MonoidalType class into GenesisSpace",
            "Centralized common type properties",
            "Improved architectural coherence"
          ]
        }
      },
      "epistemological_foundation": {
        "constructivism": "Knowledge constructed through interaction (REVOI)",
        "cybernetics": "Systems observed through feedback and control (ASFID)",
        "radical_constructivism": "Territory unknowable directly, only Map constructible",
        "second_order_cybernetics": "Observer part of observed system",
        "enaction": "Cognition arises through dynamic interaction"
      },
      "philosophical_commitments": {
        "territory_map_distinction": "Fundamental separation between reality and representation",
        "complementarity": "Both perspectives necessary and irreducible",
        "pragmatism": "Utility of representations over correspondence to reality",
        "holism": "Emergent properties not reducible to components",
        "process_philosophy": "Systems as processes not static entities"
      },
      "m3:ontologyType": {
        "@id": "m3:Genesis"
      },
      "m3:changelog": [
        {
          "owl:versionInfo": "4.15.0",
          "dcterms:date": "2026-10-08",
          "adms:versionNotes": "WS-5 DEBT LOT (A), decision Michel 2026-10-08 (Debt Overview §8.0): the declarations of m3:ontologyType, m3:TscgOntologyType, m3:TscgOntologyTypeScheme and its 11 concepts moved up to the apex M3_GrammarFoundation (IRIs unchanged). Kept here, on the same @id: the descriptive blocks of SystemicFramework, SymbolicSystemGrammar, TscgTool, TransDisclet (option c, until their keys are declared). Header texts rewritten (Michel, 2026-10-10, Debt Overview §8.0b): M3 as the most abstract layer of the Layer Cake (OMG/UML numbering); the three perspectives and their three lenses (structural grammar Gt/Gm/Gs, epistemology Territory/Map/Stereopsis, metaphor Eagle Eye/Sphinx Eye/Odin's Wisdom); Φ/Ψ as Synesthesia. Title and label no longer use 'bicephalous' (retired as a metaphor). The former description ('complete orthogonal basis… two complementary perspectives') predated the structural-grammar reform and omitted Gs. Formalism named precisely (Michel, 2026-10-10): the COMMUTATIVE Lambek calculus — Lambek's 1958 calculus is non-commutative; the three TSCG operators ×, +, | are commutative on the types of their monoid, primitive or derived. Precedence unchanged: × (Gt) > + (Gm) > | (Gs). Header: one role, one property — dcterms:description only; the former rdfs:comment repeated it (its δ₁ sentence moved into the description)."
        },
        {
          "owl:versionInfo": "4.14.0",
          "dcterms:date": "2026-10-06",
          "adms:versionNotes": "WS-5 DEBT LOT (2a), decision D5(a) (Michel, 2026-10-06): removed the legacy 'changelog' object from the 'metadata' block (option i: dropped, not folded). Its entries (v4.3.0, v4.2.0, v4.1.0) predate the m3:changelog entries kept here and remain in git history; folding them would have exceeded the 7-entry M3 window. The only changelog is m3:changelog on the owl:Ontology node."
        },
        {
          "owl:versionInfo": "4.13.0",
          "dcterms:date": "2026-09-30",
          "adms:versionNotes": "WS-1 VOCABULARY CONSOLIDATION, lot 1i. owl:imports written as plain strings (JSON-LD literals: no reasoner followed them, so this file was reasoned in isolation and the apex declarations of M3_GrammarFoundation were invisible to it) rewritten as IRIs {\"@id\": ...}: 4 import(s). Target = the imported file's document URL, resolved by @base (Michel, 2026-09-30: aligning ontology IRIs with document URLs is recorded as a later lot). Triage: ontology/docs/_01_Worksite/WS-1/WS-1_FamilyA_Triage.md."
        },
        {
          "owl:versionInfo": "4.12.0",
          "dcterms:date": "2026-09-30",
          "adms:versionNotes": "WS-1 VOCABULARY CONSOLIDATION, lot 1h (explicit declarations), non-terms removed (Michel, 2026-09-30). (1) m3:TscgOntologyType: owl:isAbstract (not an OWL term — OWL has no abstract classes) removed; the rdfs:comment already states the class is abstract, so no information is lost. (2) Same node: rdfs:isDefinedBy was the string 'm3:TscgOntologyTypeScheme'; it is now a link to that skos:ConceptScheme. (3) m3:F_CategoryTheoryNote typed owl:NamedIndividual instead of owl:Annotation, a reserved class used only to reify annotations of axioms. SKOS terms used here (skos:Concept, skos:ConceptScheme, skos:broader, skos:related, skos:inScheme, skos:hasTopConcept, skos:topConceptOf, skos:notation…) are now declared in M3_GrammarFoundation with their official SKOS typing. Triage: ontology/docs/_01_Worksite/WS-1/WS-1_FamilyA_Triage.md."
        },
        {
          "owl:versionInfo": "4.11.0",
          "dcterms:date": "2026-09-30",
          "adms:versionNotes": "WS-1 VOCABULARY CONSOLIDATION, lot 1g (Family A). Bare keys (dropped on JSON-LD expansion) replaced: alternative_names -> skos:altLabel, comment -> dcterms:description (consistent with lot 1b), note -> skos:note, definition -> skos:definition, label -> rdfs:label, title -> dcterms:title, id -> dcterms:identifier, rationale -> m3:rationale (declared in M3_GrammarFoundation, rdfs:subPropertyOf skos:note). In this file: rationale 4, title 3, id 3. Triage: ontology/docs/_01_Worksite/WS-1/WS-1_FamilyA_Triage.md."
        },
        {
          "owl:versionInfo": "4.10.0",
          "dcterms:date": "2026-09-30",
          "adms:versionNotes": "WS-1 VOCABULARY CONSOLIDATION, lot 1f (Family A). Bare key 'name' (declared in no @context, dropped on JSON-LD expansion) replaced by the standard rdfs:label (a human-readable version of the resource's name). Bare 'name' inside legacy 'metadata' blocks left for the vestiges lot. Triage: ontology/docs/_01_Worksite/WS-1/WS-1_FamilyA_Triage.md. 4 occurrences, all under bare parent keys (visible once those are resolved)."
        },
        {
          "owl:versionInfo": "4.9.0",
          "dcterms:date": "2026-09-30",
          "adms:versionNotes": "WS-1 VOCABULARY CONSOLIDATION, lot 1c (Family A). Changelog entry keys, previously bare and dropped on JSON-LD expansion, replaced by standards: version -> owl:versionInfo, date -> dcterms:date, changes -> adms:versionNotes (ADMS: a description of changes between this version and the previous one). Prefix adms declared in @context: ADMS accepted as an external vocabulary (Michel, 2026-09-30). Changelog entries become graph-visible. Legacy changelog forms (maps keyed by version, metadata blocks) left for a separate lot. Triage: ontology/docs/_01_Worksite/WS-1/WS-1_FamilyA_Triage.md."
        }
      ]
    },
    {
      "@id": "m3:MonoidalType",
      "@type": "owl:Class",
      "rdfs:label": "M3 MonoidalType",
      "rdfs:comment": "A primitive type in the TSCG Structural Grammar. At M2/M3: generator of type expressions (qualitative, no metric). At M0: instantiation functors map structural primitives to observable instance values (quantitative scoring belongs to the M0 ValueSpace, not to the M3 structural grammar). Belongs to either Territory Grammar Gt (ASFID) or Map Grammar Gm (REVOI).",
      "rdfs:subClassOf": {
        "@id": "owl:Thing"
      },
      "skos:definition": "A primitive type generator of the TSCG Structural Grammar. Independence verified (analytical, not metric). Two roles: (1) type generator at M2 level; (2) structural primitive instantiated at M0 level, where observable values are produced by evaluation functors belonging to the M0 ValueSpace (not to the M3 structural grammar).",
      "skos:scopeNote": "This class has exactly 10 instances: 5 ASFID types (Attractor, Structure, Flow, Information, Dynamics) defined in M3_EagleEye.jsonld, and 5 REVOI types (Representable, Evolvable, Verifiable, Observable, Interoperable) defined in M3_SphinxEye.jsonld.",
      "dcterms:created": "2026-02-16",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "skos:example": [
        "m3:eagle_eye:Attractor (ASFID/Territory)",
        "m3:eagle_eye:Structure (ASFID/Territory)",
        "m3:sphinx_eye:Representable (REVOI/Map)",
        "m3:sphinx_eye:Verifiable (REVOI/Map)"
      ]
    },
    {
      "@id": "m3:typeSymbol",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Type Symbol",
      "rdfs:comment": "Single-letter type atom identifying an M3 structural primitive in the Structural Grammar. Used as generator in monoidal type expressions (e.g., A × S × F). Replaces the ket notation |X⟩ of the former Hilbert space formalism.",
      "rdfs:domain": {
        "@id": "m3:MonoidalType"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:definition": "Symbolic identifier for a M3 primitive type (e.g., A, S, R, V). Used in structural formulas and evaluation functor notation.",
      "skos:example": [
        "A  for Attractor  (ASFID/Territory)",
        "S  for Structure  (ASFID/Territory)",
        "F  for Flow       (ASFID/Territory)",
        "I  for Information (ASFID/Territory)",
        "D  for Dynamics   (ASFID/Territory)",
        "R  for Representable (REVOI/Map)",
        "E  for Evolvable     (REVOI/Map)",
        "V  for Verifiable    (REVOI/Map)",
        "O  for Observable    (REVOI/Map)",
        "Iₘ for Interoperable (REVOI/Map)"
      ],
      "dcterms:created": "2026-02-16"
    },
    {
      "@id": "m3:typeIndex",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Type Index",
      "rdfs:comment": "Numerical index of the type within its basis (1-5 for ASFID, 1-5 for REVOI)",
      "rdfs:domain": {
        "@id": "m3:MonoidalType"
      },
      "rdfs:range": {
        "@id": "xsd:integer"
      },
      "skos:definition": "Position index within the grammar primitive set (1-5 within Gt or Gm). Used for ordered enumeration and reference.",
      "dcterms:created": "2026-02-16"
    },
    {
      "@id": "m3:typeExamples",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Type Examples",
      "rdfs:comment": "Concrete system instances illustrating the type with typical measurement or quality values",
      "rdfs:domain": {
        "@id": "m3:MonoidalType"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:definition": "Real-world examples showing how the type applies across different domains and scales (for ASFID) or different types of Maps and representations (for REVOI)",
      "dcterms:created": "2026-02-16"
    },
    {
      "@id": "m3:semanticSignature",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "Semantic Signature",
      "rdfs:comment": "Minimal sufficient characterization of an entity's identity within the TSCG framework. Constitutive (positive) rather than differential (negative). Applicable at all layers: M3 (ontology types), M2 (metaconcepts), M1 (domain concepts), M0 (system instances).",
      "skos:definition": "A compact, positive, minimal-yet-sufficient description of what an entity IS, expressed as a conjunction of necessary components. Distinct from m3:distinguishingFeatures which is differential (what an entity is NOT). Structure: component_1 + component_2 + ... where all components are necessary and together sufficient.",
      "rdfs:domain": {
        "@id": "owl:Thing"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:example": [
        "M3 type: 'primitives(finite) + combination_rules + multiple_legitimate_interpretations' (SymbolicSystemGrammar)",
        "M2 metaconcept: 'output → input + regulation + attractor_convergence' (FeedbackLoop)",
        "M1 concept: 'setpoint + sensor + effector + correction' (Homeostasis)",
        "M0 poclet: 'Renin→Angiotensin→Aldosterone + pressure_regulation + negative_loop' (RAAS)"
      ],
      "skos:scopeNote": "Layer-agnostic property defined at M3 level for universal applicability. At M2 level, semanticSignature is the human-readable counterpart of structuralFormula — both express the same identity at different levels of formalization.",
      "skos:editorialNote": "Supersedes m3:distinguishingFeatures (differential, informal) with a constitutive, formally defined alternative. Existing distinguishingFeatures blocks may be progressively replaced or complemented.",
      "dcterms:created": "2026-02-20",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI"
    },
    {
      "@id": "m3:SystemicFramework",
      "m3:distinguishingFeatures": {
        "vs_DomainExtension": "DomainExtension = disciplinary knowledge (Biology, Chemistry). SystemicFramework = established methodologies (TRIZ, VSD).",
        "vs_Poclet": "Poclet = minimal validation instance. SystemicFramework = complete methodology with full theoretical foundation.",
        "purpose": "Enable TSCG to interface with and validate against established frameworks from systems theory, design, and problem-solving domains."
      },
      "m3:integrationGuidelines": {
        "step1": "Identify framework's core concepts and relationships",
        "step2": "Map framework concepts to M2 metaconcepts",
        "step3": "Express framework operations as structural formulas (×, + operators)",
        "step4": "Validate mapping with framework experts",
        "step5": "Document epistemic gaps and alignment scores"
      }
    },
    {
      "@id": "m3:SymbolicSystemGrammar",
      "m3:distinguishingFeatures": {
        "vs_SystemicFramework": "SystemicFramework = prescriptive, convergent toward solution. SymbolicSystemGrammar = generative, divergent toward interpretive multiplicity.",
        "vs_Poclet": "Poclet = minimal observable system validated empirically. SymbolicSystemGrammar = complete symbolic language, culturally/contextually arbitrated.",
        "vs_RealWorldSystem": "RealWorldSystem = deployed with stakeholders and physical constraints. SymbolicSystemGrammar = purely symbolic, no physical arbitration.",
        "coreProperty": "The arbitration of interpretation is symbolic/cultural/contextual — never physical or empirical. This is the defining discriminant."
      }
    },
    {
      "@id": "m3:TscgTool",
      "m3:distinguishingFeatures": {
        "vs_Poclet": "Poclet = minimal model of an EXTERNAL system (biology, mythology, engineering). TscgTool = software application whose input IS the TSCG framework itself.",
        "vs_SystemicFramework": "SystemicFramework = established external methodology mapped into TSCG. TscgTool = tool built to navigate/analyze TSCG artifacts.",
        "vs_CaseStudy": "CaseStudy = pedagogical M0 example. TscgTool = operational software with concrete functionality.",
        "coreProperty": "The subject matter of a TscgTool is TSCG itself — it exhibits framework reflexivity."
      }
    },
    {
      "@id": "m3:TransDisclet",
      "m3:distinguishingFeatures": {
        "vs_Poclet": "Poclet = minimal model of ONE system in ONE domain (e.g. RAAS in biology). TransDisclet = same system concept existing natively in 2+ disciplines simultaneously (e.g. Transducer in electronics AND biology AND acoustics).",
        "vs_CaseStudy": "CaseStudy = pedagogical example, may be incomplete. TransDisclet = rigorous multi-domain model with validated instances in each discipline.",
        "vs_DomainExtension": "DomainExtension = disciplinary vocabulary (M1 layer). TransDisclet = concrete M0 instance whose scope spans multiple M1 domains.",
        "vs_SystemicFramework": "SystemicFramework = established external methodology mapped into TSCG. TransDisclet = concrete system natively present across disciplines.",
        "coreProperty": "The same system concept arises INDEPENDENTLY in multiple disciplines — not by metaphor or analogy, but by native disciplinary instantiation."
      },
      "m3:storageConvention": {
        "folder": "instances/transdisclet/",
        "fileNaming": "M0_SystemName.jsonld",
        "skos:example": "instances/transdisclet/M0_Transducer.jsonld"
      },
      "m3:validationCriteria": {
        "minimum_domains": 2,
        "structural_homology": "Same ASFID structural formula identifiable in each disciplinary instance",
        "native_existence": "System exists autonomously in each discipline, not derived by analogy",
        "m2_grounding": "All instances share the same root GenericConcept structural type from M2 layer"
      }
    },
    {
      "@id": "m3:CouplingStructure",
      "@type": "owl:Class",
      "rdfs:label": "Bicephalous Coupling (Natural Transformations)",
      "rdfs:comment": "Natural transformations Φ and Ψ encoding bidirectional connection between Territory Grammar Gt and Map Grammar Gm.",
      "skos:definition": "Æ’ᵢⱼ represents coupling strength between ASFID types i and REVOI types j",
      "m3:mathematicalForm": "Φ : Gt → Gm, Ψ : Gm → Gt (natural transformations), δ₁ = ||ASFID_mean − REVOI_mean|| / √2",
      "m3:role": "Encodes Map/Territory bidirectional epistemological connection"
    },
    {
      "@id": "m3:AlignmentLoop",
      "@type": "owl:Class",
      "rdfs:label": "Territory \" Map Alignment Loop",
      "rdfs:comment": "Bidirectional iterative process aligning Territory observations with Map construction: Eagle Eye measures phenomena (ASFID), Sphinx Eye constructs representations (REVOI), and the Φ/Ψ operators drive progressive convergence between the two. Distinct from systemic feedback loops (biological, mechanical) \" this is an epistemological alignment mechanism intrinsic to TSCG architecture.",
      "skos:definition": "Epistemological alignment loop between empirical observations (Territory/ASFID) and conceptual representations (Map/REVOI), driven by Φ and Ψ operators until Map-Territory coherence is achieved.",
      "m3:operators": {
        "Phi": {
          "symbol": "Φ",
          "signature": "Φ : Gt → Gm  (natural transformation)",
          "dcterms:description": "Observation operator - transforms Territory data into Map representations"
        },
        "Psi": {
          "symbol": "Ψ",
          "signature": "Ψ : Gm → Gt  (natural transformation)",
          "dcterms:description": "Interpretation operator - Map predictions guide Territory measurement strategies"
        }
      },
      "m3:iteration": "iterative refinement via Φ/Ψ until δ₁ converges toward epistemic equilibrium"
    },
    {
      "@id": "m3:KorzybskiPrinciple",
      "@type": "owl:Class",
      "rdfs:label": "Korzybski Principle Formalization",
      "rdfs:comment": "Mathematical formalization of 'The map is not the territory' extended to 'The map influences how we observe the territory'",
      "skos:definition": "Epistemological principle recognizing Map and Territory as distinct yet mutually influential through bidirectional coupling Σ",
      "m3:classicStatement": "The map is not the territory (Alfred Korzybski, 1933)",
      "m3:tscgExtension": "The map influences how we observe the territory, and observations refine the map",
      "m3:formalization": "Φ : Gt → Gm is never a perfect isomorphism — δ₁ > 0 for all real systems"
    },
    {
      "@id": "m3:MathematicalCategory",
      "@type": "owl:Class",
      "rdfs:label": "Mathematical Category",
      "rdfs:comment": "A category in the mathematical sense: a collection of objects (Ob(C)) and morphisms (Mor(C)) between them, satisfying identity and associativity axioms. In TSCG: Cat_M3 (ASFID types), Cat_M2 (metaconcepts), Cat_M1 (concepts), Cat_KnowledgeField (Chemistry, Biology, Optics...).",
      "m3:structure": {
        "objects": "Collection Ob(C) of category objects",
        "morphisms": "Collection Mor(C) of arrows between objects",
        "identity": "For each object A ∈ Ob(C), exists id_A: A → A",
        "composition": "For f: A → B and g: B → C, exists g∘f: A → C",
        "associativity": "(h∘g)∘f = h∘(g∘f)",
        "identity_law": "f∘id_A = f = id_B∘f for f: A → B"
      },
      "m3:categoryAxioms": [
        "Identity: ∀A ∈ Ob(C), ∃ id_A ∈ Mor(A,A)",
        "Composition: ∀f ∈ Mor(A,B), g ∈ Mor(B,C), ∃ g∘f ∈ Mor(A,C)",
        "Associativity: (h∘g)∘f = h∘(g∘f)",
        "Unit law: f∘id_A = f, id_B∘f = f"
      ],
      "m3:tscgExamples": [
        "Cat_KnowledgeField: Ob = {Chemistry, Biology, Optics...}, Mor = knowledge transfers",
        "Cat_M2: Ob = {Link, Processor, Component...}, Mor = metaconcept inclusions",
        "Cat_M3_ASFID: Ob = {A, S, F, I, D} (Gt primitives), Mor = × structural products",
        "Cat_TSCG: Ob = {M3, M2, M1, M0}, Mor = functors F_×, F_inst"
      ]
    },
    {
      "@id": "m3:CategoryObject",
      "@type": "owl:Class",
      "rdfs:label": "Category Object",
      "rdfs:comment": "An object within a mathematical category. Objects are the 'things' in a category; morphisms are the 'relationships' between them. In TSCG: Chemistry is an object in Cat_KnowledgeField, Link is an object in Cat_M2, ASFID is an object in Cat_M3.",
      "m3:formalDefinition": "An element A ∈ Ob(C) for some category C",
      "m3:properties": [
        "Every object has an identity morphism id_A: A → A",
        "Objects are sources and targets of morphisms",
        "Objects themselves have no internal structure in category theory",
        "Structure comes from morphisms TO and FROM the object"
      ],
      "m3:tscgReification": {
        "dcterms:description": "In TSCG, metaconcepts (M2) are reified as Category Objects when viewed categorically",
        "skos:example": "KnowledgeField (M2 metaconcept) IS ALSO a mathematical category with Chemistry, Biology... as objects",
        "doubleRole": "Chemistry is BOTH an object in Cat_KnowledgeField AND potentially a category itself (Cat_Chemistry with subconcepts as objects)"
      }
    },
    {
      "@id": "m3:Morphism",
      "@type": "owl:Class",
      "rdfs:label": "Category Morphism",
      "rdfs:comment": "An arrow (morphism) between category objects. Morphisms represent structure-preserving transformations. In TSCG: structural composition (M3→M2), instantiation (M2→M1), concept application (M1→M0), knowledge transfer between domains.",
      "m3:formalDefinition": "An element f ∈ Mor(A,B) for objects A,B ∈ Ob(C)",
      "m3:notation": {
        "arrow": "f: A → B",
        "source": "dom(f) = A (domain)",
        "target": "cod(f) = B (codomain)",
        "composition": "g∘f for f: A → B, g: B → C"
      },
      "m3:morphismTypes": {
        "identity": "id_A: A → A (trivial morphism)",
        "isomorphism": "f: A → B with inverse f⁻¹: B → A",
        "monomorphism": "injective morphism",
        "epimorphism": "surjective morphism",
        "endomorphism": "f: A → A (same source and target)",
        "automorphism": "isomorphic endomorphism"
      },
      "m3:tscgMorphisms": {
        "inclusion": "↪ (e.g., Homeostasis ↪ Regulation)",
        "composition": "∘ (e.g., Learning = Memory ∘ Adaptation)",
        "duality": "op (e.g., Divergence = Convergence^op)",
        "emergence": "⇒ (e.g., MetaconceptCombo: M_A × M_B ⇒ M_C)",
        "structuralComposition": "× or + (combination of objects)",
        "instantiation": "inst (M2 concept → M1 concept → M0 instance)"
      }
    },
    {
      "@id": "m3:Functor",
      "@type": "owl:Class",
      "rdfs:label": "Functor",
      "rdfs:comment": "A structure-preserving map between categories. Functors map objects to objects and morphisms to morphisms, preserving identity and composition. In TSCG: F_× (structural composition M3→M2), F_inst (instantiation M2→M1), domain projection functors.",
      "m3:formalDefinition": "F: C → D mapping Ob(C) → Ob(D) and Mor(C) → Mor(D)",
      "m3:functorLaws": [
        "Object mapping: F: Ob(C) → Ob(D)",
        "Morphism mapping: F: Mor_C(A,B) → Mor_D(F(A),F(B))",
        "Identity preservation: F(id_A) = id_F(A)",
        "Composition preservation: F(g∘f) = F(g)∘F(f)"
      ],
      "m3:functorTypes": {
        "covariant": "Preserves direction of morphisms",
        "contravariant": "Reverses direction of morphisms",
        "endofunctor": "F: C → C (same category)",
        "identity_functor": "Id_C: C → C (trivial functor)",
        "forgetful": "Forgets structure (e.g., from algebra to set)",
        "free": "Builds free structure (left adjoint to forgetful)"
      },
      "m3:tscgFunctors": {
        "F_structuralFormula_examples": {
          "signature": "F_×: Cat_M3 → Cat_M2",
          "dcterms:description": "Maps ASFID types to metaconcepts via structural composition",
          "skos:example": "F_×(S × F) = Link (metaconcept from structural composition of Structure and Flow)"
        },
        "F_instantiation": {
          "signature": "F_inst: Cat_M2 → Cat_M1",
          "dcterms:description": "Maps metaconcepts to domain-specific concepts",
          "skos:example": "F_inst(Link) = ChemicalLink (in Chemistry domain)"
        },
        "F_domain_projection": {
          "signature": "F_proj: Cat_M1 → Cat_KnowledgeField",
          "dcterms:description": "Projects M1 concepts onto their parent knowledge field",
          "skos:example": "F_proj(ChemicalLink) = Chemistry"
        }
      }
    },
    {
      "@id": "m3:NaturalTransformation",
      "@type": "owl:Class",
      "rdfs:label": "Natural Transformation",
      "rdfs:comment": "A morphism between functors. Natural transformations relate two functors F,G: C → D via a family of morphisms. In TSCG: transformations between different observer perspectives (human vs AI), translations between knowledge representations.",
      "m3:formalDefinition": "η: F ⇒ G is a family η_A: F(A) → G(A) for each A ∈ Ob(C)",
      "m3:naturality": {
        "dcterms:description": "Naturality square commutes",
        "diagram": "For f: A → B, the square F(A) \"η_A→ G(A), F(B) \"η_B→ G(B) commutes",
        "law": "η_B ∘ F(f) = G(f) ∘ η_A"
      },
      "m3:tscgApplications": [
        "Observer transformations: different perspectives on same territory",
        "Knowledge transfer: translation between disciplines",
        "Representation changes: different encodings of same concept"
      ]
    },
    {
      "@id": "m3:Adjunction",
      "@type": "owl:Class",
      "rdfs:label": "Adjunction",
      "rdfs:comment": "A relationship between two functors F: C → D and G: D → C where F is left adjoint to G (F ⊣ G). Adjunctions capture the idea of 'best approximation'. In TSCG: observation-interpretation duality (Φ ⊣ Ψ), free-forgetful pairs.",
      "m3:formalDefinition": "F ⊣ G iff Mor_D(F(A),B) ≈ Mor_C(A,G(B)) naturally in A,B",
      "m3:components": {
        "unit": "η: Id_C ⇒ G∘F",
        "counit": "ε: F∘G ⇒ Id_D"
      },
      "m3:tscgAdjunctions": {
        "observation_interpretation": {
          "dcterms:description": "Φ (Territory→Map) ⊣ Ψ (Map→Territory)",
          "interpretation": "Best map given territory \" Best territory interpretation given map"
        }
      }
    },
    {
      "@id": "m3:belongsToCategory",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "belongs to category",
      "rdfs:domain": {
        "@id": "m3:CategoryObject"
      },
      "rdfs:range": {
        "@id": "m3:MathematicalCategory"
      },
      "rdfs:comment": "Relates an object to the category it belongs to. Example: Chemistry belongsToCategory Cat_KnowledgeField."
    },
    {
      "@id": "m3:hasMorphism",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "has morphism",
      "rdfs:domain": {
        "@id": "m3:MathematicalCategory"
      },
      "rdfs:range": {
        "@id": "m3:Morphism"
      },
      "rdfs:comment": "Relates a category to one of its morphisms."
    },
    {
      "@id": "m3:morphismSource",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "morphism source",
      "rdfs:domain": {
        "@id": "m3:Morphism"
      },
      "rdfs:range": {
        "@id": "m3:CategoryObject"
      },
      "rdfs:comment": "The source (domain) object of a morphism."
    },
    {
      "@id": "m3:morphismTarget",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "morphism target",
      "rdfs:domain": {
        "@id": "m3:Morphism"
      },
      "rdfs:range": {
        "@id": "m3:CategoryObject"
      },
      "rdfs:comment": "The target (codomain) object of a morphism."
    },
    {
      "@id": "m3:composedWith",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "composed with",
      "rdfs:domain": {
        "@id": "m3:Morphism"
      },
      "rdfs:range": {
        "@id": "m3:Morphism"
      },
      "rdfs:comment": "Morphism composition: if f: A→B and g: B→C, then f composedWith g yields g∘f: A→C."
    },
    {
      "@id": "m3:functorSourceCategory",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "functor source category",
      "rdfs:domain": {
        "@id": "m3:Functor"
      },
      "rdfs:range": {
        "@id": "m3:MathematicalCategory"
      },
      "rdfs:comment": "The source category of a functor."
    },
    {
      "@id": "m3:functorTargetCategory",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "functor target category",
      "rdfs:domain": {
        "@id": "m3:Functor"
      },
      "rdfs:range": {
        "@id": "m3:MathematicalCategory"
      },
      "rdfs:comment": "The target category of a functor."
    },
    {
      "@id": "m3:mapsObjectTo",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "maps object to",
      "rdfs:domain": {
        "@id": "m3:Functor"
      },
      "rdfs:range": {
        "@id": "m3:CategoryObject"
      },
      "rdfs:comment": "How a functor maps objects. F mapsObjectTo F(A) for object A."
    },
    {
      "@id": "m3:mapsMorphismTo",
      "@type": "owl:ObjectProperty",
      "rdfs:label": "maps morphism to",
      "rdfs:domain": {
        "@id": "m3:Functor"
      },
      "rdfs:range": {
        "@id": "m3:Morphism"
      },
      "rdfs:comment": "How a functor maps morphisms. F mapsMorphismTo F(f) for morphism f."
    },
    {
      "@id": "m3:morphismType",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "morphism type",
      "rdfs:domain": {
        "@id": "m3:Morphism"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:comment": "Type classification of morphism (identity, isomorphism, inclusion, etc.)."
    },
    {
      "@id": "m3:functorType",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "functor type",
