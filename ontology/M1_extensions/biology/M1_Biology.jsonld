{
  "@context": {
    "m3": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M3_GenesisGrammar.jsonld#",
    "m2": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",
    "adms": "http://www.w3.org/ns/adms#",
    "m1": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M1_CoreConcepts.jsonld#",
    "@base": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@graph": [
    {
      "@id": "m1:extension:biology:M1_Biology",
      "@type": "owl:Ontology",
      "rdfs:label": "TSCG M1 Biology Extension",
      "rdfs:comment": "Domain-specific biological concepts for TSCG framework. Contains patterns and concepts specific to biological systems (cellular, physiological, developmental).",
      "dcterms:title": "TSCG M1 Biology - Domain-Specific Biological Concepts",
      "dcterms:description": "Extension of TSCG framework with biology-specific concepts including cellular communication, signal transduction, homeostasis, and physiological regulation.",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "dcterms:created": "2026-01-22",
      "owl:versionInfo": "1.10.0",
      "m3:ontologyType": {
        "@id": "m3:DomainExtension"
      },
      "owl:imports": [
        { "@id": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M1_CoreConcepts.jsonld" },
        { "@id": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld" }
      ],
      "dcterms:modified": "2026-10-12",
      "m3:changelog": [
        {
          "owl:versionInfo": "1.10.0",
          "dcterms:date": "2026-10-12",
          "adms:versionNotes": "SC-5 Domain fusion (Michel, 2026-10-11/12): domains are classes rdfs:subClassOf m1:Domain, never individuals. m1:extension:biology:Biology -> owl:Class ⊑ m1:Domain; registry data moved onto m1:extension:biology:Biology. m2:KnowledgeField / m1:KnowledgeFieldGenericCombo are obsolete (declared nowhere); the KnowledgeField-only keys m2:knowledgeFieldRole, m2:derivedFrom (now rdfs:subClassOf) dropped; m2:qualifier text kept as skos:definition. Obsolete KnowledgeField vocabulary purged from the live text (Michel, 2026-10-12: there is no KnowledgeField any more, it is Domain)."
        },
        {
          "owl:versionInfo": "1.9.0",
          "dcterms:date": "2026-10-11",
          "adms:versionNotes": "WS-1 B2 lot C1b (class/instance separation, follow-up of C1). rdfs:subClassOf values written as plain strings (JSON-LD literals: the property is not @id-coerced in the @context, so these superclass links were absent from the graph) rewritten as IRIs: 21 value(s). Phantom parent m1:CommunicationPattern on m1:extension:biology:CellularCommunication left as a string, pending the Protocol candidate (attribute of m2:Workflow, Michel 2026-10-11)."
        },
        {
          "owl:versionInfo": "1.8.0",
          "dcterms:date": "2026-10-11",
          "adms:versionNotes": "WS-1 B2 lot C2 (class/instance separation). m2:DomainConceptCombo removed from the @type of 1 combo(s): a combo is a DERIVED CLASS (rdfs:subClassOf m2:DomainConceptCombo, an IRI since lot C1), never an instance of the combo class (Michel, 2026-10-11). @type is now owl:Class alone. Typing a combo as an instance of a combo class is forbidden from now on (M1 SHACL 1.7.0 SHAPE 12 NoComboPunningShape, check_M1 1.7.0 CMB001)."
        }
      ]
    },
    {
      "@id": "m1:extension:biology:Biology",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "m1:Domain"
      },
      "rdfs:label": "Biology",
      "rdfs:comment": "Science of living organisms, their structure, function, growth, evolution, and interactions with their environment",
      "dcterms:created": "2026-05-26",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "skos:definition": "Study of life and living systems at all scales from molecules to ecosystems",
      "m1:subdomains": [
        "Developmental Biology",
        "Cell Biology",
        "Physiology",
        "Endocrinology",
        "Renal Physiology",
        "Cardiovascular Physiology",
        "Nephrology",
        "Homeostasis",
        "Immunology",
        "Neuroscience",
        "Cellular Communication",
        "Pharmacology"
      ],
      "m1:relatedDomains": [
        {
          "@id": "m1:extension:chemistry:Chemistry"
        },
        {
          "@id": "m1:extension:physics:Physics"
        },
        {
          "@id": "m1:domain:Ecology"
        },
        {
          "@id": "m1:domain:Neurobiology"
        }
      ],
      "m1:instanceExamples": [
        "M0_AdaptiveImmuneResponse",
        "M0_BloodPressureControl",
        "M0_ButterflyMetamorphosis",
        "M0_CellSignalingModes",
        "M0_Kidneys",
        "M0_RAAS"
      ],
      "m1:instanceCount": 6
    },
    {
      "@id": "m1:extension:biology:CellularCommunication",
      "@type": "owl:Class",
      "rdfs:subClassOf": [
        {"@id": "m2:DomainConceptCombo"},
        "m1:CommunicationPattern"
      ],
      "rdfs:label": "Cellular Communication",
      "rdfs:comment": "General pattern for intercellular signaling and information exchange. Foundation for all cell-cell communication modes.",
      "m1:structuralGrammarFormula": "Fm1m2(Biology, S × I × F)",
      "m1:extension:biology:domains": [
        "Endocrinology",
        "Neuroscience",
        "Immunology",
        "Developmental Biology"
      ]
    },
    {
      "@id": "m1:extension:biology:AutocrineSignaling",
      "@type": "owl:Class",
      "rdfs:label": "Autocrine Signaling",
      "rdfs:comment": "Self-signaling pattern where a cell responds to signals it secretes itself. Used for feedback regulation and autonomous cell behavior.",
      "rdfs:subClassOf": {"@id": "m1:extension:biology:CellularCommunication"},
      "m1:extension:biology:spatialRange": "Intracellular to immediate cell surface (~1-10 µm)",
      "m1:extension:biology:temporalRange": "Milliseconds to seconds",
      "m1:extension:biology:mechanism": "Local concentration gradient around secreting cell",
      "m1:extension:biology:examples": [
        "T-cell IL-2 autocrine loops",
        "Cancer cell growth factor self-stimulation",
        "Neurotransmitter autoreceptors"
      ]
    },
    {
      "@id": "m1:extension:biology:ParacrineSignaling",
      "@type": "owl:Class",
      "rdfs:label": "Paracrine Signaling",
      "rdfs:comment": "Local neighborhood signaling pattern where signals diffuse through extracellular space to affect nearby cells. Coordinates tissue-level activity.",
      "rdfs:subClassOf": {"@id": "m1:extension:biology:CellularCommunication"},
      "m1:extension:biology:spatialRange": "Local tissue microenvironment (~10 µm - 1 mm)",
      "m1:extension:biology:temporalRange": "Seconds to minutes",
      "m1:extension:biology:mechanism": "Fick's law diffusion through extracellular matrix",
      "m1:extension:biology:examples": [
        "Prostaglandins in inflammation",
        "Nitric oxide vasodilation",
        "Neurotransmitters at synapses",
        "Morphogen gradients in development"
      ]
    },
    {
      "@id": "m1:extension:biology:NeuroendocrineSignaling",
      "@type": "owl:Class",
      "rdfs:label": "Neuroendocrine Signaling",
      "rdfs:comment": "Hybrid signaling pattern combining neural speed with endocrine range. Neurons secrete hormones into bloodstream for systemic distribution.",
      "rdfs:subClassOf": {"@id": "m1:extension:biology:CellularCommunication"},
      "m1:extension:biology:spatialRange": "Systemic (entire organism via bloodstream)",
      "m1:extension:biology:temporalRange": "Seconds (neural trigger) â†’ Minutes to hours (hormonal effect)",
      "m1:extension:biology:mechanism": "Neural activation triggers hormone secretion into circulation",
      "m1:extension:biology:examples": [
        "Hypothalamic-pituitary axis",
        "Adrenal medulla catecholamine release",
        "Oxytocin release in lactation",
        "ADH/Vasopressin water regulation"
      ]
    },
    {
      "@id": "m1:extension:biology:EndocrineSignaling",
      "@type": "owl:Class",
      "rdfs:label": "Endocrine Signaling",
      "rdfs:comment": "Systemic signaling pattern where specialized glands secrete hormones into bloodstream for organism-wide coordination. Classic long-range hormonal communication.",
      "rdfs:subClassOf": {"@id": "m1:extension:biology:CellularCommunication"},
      "m1:extension:biology:spatialRange": "Systemic (entire organism)",
      "m1:extension:biology:temporalRange": "Minutes to hours (hormone half-life dependent)",
      "m1:extension:biology:mechanism": "Convective transport via cardiovascular system",
      "m1:extension:biology:examples": [
        "Insulin glucose regulation",
        "Thyroid hormone metabolic control",
        "Growth hormone",
        "Sex steroids (estrogen, testosterone)",
        "Cortisol stress response"
      ]
    },
    {
      "@id": "m1:extension:biology:Hormone",
      "@type": "owl:Class",
      "rdfs:label": "Hormone",
      "rdfs:comment": "Signaling molecule secreted by cells that travels through body fluids to target cells expressing specific receptors.",
      "m1:extension:biology:categories": {
        "peptide": "Insulin, Growth hormone, Oxytocin (hydrophilic)",
        "steroid": "Cortisol, Estrogen, Testosterone (lipophilic)",
        "amino-acid-derived": "Thyroxine, Adrenaline, Melatonin"
      },
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    },
    {
      "@id": "m1:extension:biology:Receptor",
      "@type": "owl:Class",
      "rdfs:label": "Receptor",
      "rdfs:comment": "Molecular structure that binds specific signaling molecules and transduces signal into cellular response.",
      "m1:extension:biology:types": {
        "membrane": "G-protein coupled receptors (GPCRs), Receptor tyrosine kinases (RTKs), Ion channels",
        "intracellular": "Nuclear receptors (steroid hormones), Cytoplasmic receptors"
      },
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    },
    {
      "@id": "m1:extension:biology:SignalTransduction",
      "@type": "owl:Class",
      "rdfs:label": "Signal Transduction",
      "rdfs:comment": "Process by which extracellular signal is converted into intracellular response through cascade of molecular interactions.",
      "m1:extension:biology:components": [
        "Ligand-receptor binding",
        "Second messenger systems (cAMP, Ca²⁺, IP₃)",
        "Protein kinase cascades",
        "Gene expression modulation"
      ],
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    },
    {
      "@id": "m1:extension:biology:Homeostasis",
      "@type": "owl:Class",
      "rdfs:label": "Homeostasis",
      "rdfs:comment": "Maintenance of stable internal conditions despite external fluctuations. Achieved through negative feedback regulation.",
      "m1:extension:biology:parameters": [
        "Blood glucose (~5 mM)",
        "Body temperature (37°C)",
        "Blood pH (7.35-7.45)",
        "Calcium concentration (~2.5 mM)",
        "Blood pressure (120/80 mmHg)"
      ],
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    },
    {
      "@id": "m1:extension:biology:FeedbackLoop",
      "@type": "owl:Class",
      "rdfs:label": "Feedback Loop",
      "rdfs:comment": "Regulatory circuit where output influences input. Can be negative (stabilizing) or positive (amplifying).",
      "m1:extension:biology:types": {
        "negative": "Thermostat-like stabilization (insulin-glucose, thyroid hormone)",
        "positive": "Explosive amplification (oxytocin in labor, blood clotting)"
      },
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    },
    {
      "@id": "m1:extension:biology:DiffusionGradient",
      "@type": "owl:Class",
      "rdfs:label": "Diffusion Gradient",
      "rdfs:comment": "Spatial concentration pattern driving molecular movement from high to low concentration. Governed by Fick's laws.",
      "m1:extension:biology:physics": {
        "fickFirstLaw": "J = -D∇C (flux proportional to gradient)",
        "fickSecondLaw": "∂C/∂t = D∇²C (concentration evolution)",
        "diffusionCoefficient": "D ~ 10⁻¹⁰ m²/s for proteins in extracellular matrix"
      },
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    },
    {
      "@id": "m1:extension:biology:Morphogen",
      "@type": "owl:Class",
      "rdfs:label": "Morphogen",
      "rdfs:comment": "Signaling molecule that forms concentration gradient and specifies cell fate in developing tissue. Position in gradient determines cell identity.",
      "rdfs:subClassOf": {"@id": "m1:extension:biology:Hormone"},
      "m1:extension:biology:examples": [
        "Hedgehog (vertebrate neural tube patterning)",
        "BMP (bone morphogenetic protein)",
        "Wnt (embryonic axis formation)",
        "Retinoic acid (limb development)"
      ]
    },
    {
      "@id": "m1:extension:biology:HypothalamusPituitaryAxis",
      "@type": "owl:Class",
      "rdfs:label": "Hypothalamus-Pituitary Axis",
      "rdfs:comment": "Master neuroendocrine structure coordinating hormone secretion. Hypothalamus integrates neural signals and controls pituitary hormone release.",
      "m1:extension:biology:axes": [
        "HPA axis (stress): CRH â†’ ACTH â†’ Cortisol",
        "HPG axis (reproduction): GnRH â†’ LH/FSH â†’ Sex steroids",
        "HPT axis (metabolism): TRH â†’ TSH â†’ Thyroid hormones"
      ],
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    },
    {
      "@id": "m1:extension:biology:Cell",
      "@type": "owl:Class",
      "rdfs:label": "Cell",
      "rdfs:comment": "Fundamental unit of life. Bounded compartment capable of metabolism, growth, and reproduction.",
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    },
    {
      "@id": "m1:extension:biology:Tissue",
      "@type": "owl:Class",
      "rdfs:label": "Tissue",
      "rdfs:comment": "Organized ensemble of cells performing coordinated function. Level between cell and organ in biological hierarchy.",
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    },
    {
      "@id": "m1:extension:biology:Organ",
      "@type": "owl:Class",
      "rdfs:label": "Organ",
      "rdfs:comment": "Structural unit composed of multiple tissue types performing specific physiological function.",
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    },
    {
      "@id": "m1:extension:biology:BloodCirculation",
      "@type": "owl:Class",
      "rdfs:label": "Blood Circulation",
      "rdfs:comment": "Cardiovascular transport system distributing nutrients, gases, hormones, and immune cells throughout organism.",
      "m1:extension:biology:parameters": {
        "cardiacOutput": "~5 L/min at rest",
        "circulationTime": "~60 seconds complete circuit",
        "pressure": "120/80 mmHg (systolic/diastolic)"
      },
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    },
    {
      "@id": "m1:extension:biology:Metabolism",
      "@type": "owl:Class",
      "rdfs:label": "Metabolism",
      "rdfs:comment": "Sum of all chemical reactions maintaining life. Includes catabolism (breakdown) and anabolism (synthesis).",
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    },
    {
      "@id": "m1:extension:biology:GeneExpression",
      "@type": "owl:Class",
      "rdfs:label": "Gene Expression",
      "rdfs:comment": "Process by which genetic information (DNA) is converted to functional product (protein). Central dogma: DNA â†’ RNA â†’ Protein.",
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    },
    {
      "@id": "m1:extension:biology:Inflammation",
      "@type": "owl:Class",
      "rdfs:label": "Inflammation",
      "rdfs:comment": "Complex biological response to harmful stimuli (pathogens, damaged cells, irritants). Involves immune cell recruitment and tissue repair.",
      "m1:extension:biology:characteristics": [
        "Rubor (redness)",
        "Calor (heat)",
        "Tumor (swelling)",
        "Dolor (pain)",
        "Functio laesa (loss of function)"
      ],
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    },
    {
      "@id": "m1:extension:biology:Synapse",
      "@type": "owl:Class",
      "rdfs:label": "Synapse",
      "rdfs:comment": "Specialized junction between neurons enabling signal transmission. Can be chemical (neurotransmitter) or electrical (gap junction).",
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    },
    {
      "@id": "m1:extension:biology:ImmuneResponse",
      "@type": "owl:Class",
      "rdfs:label": "Immune Response",
      "rdfs:comment": "Coordinated reaction of immune system to foreign antigens. Involves innate (immediate) and adaptive (specific, memory) components.",
      "rdfs:subClassOf": {"@id": "m2:GenericConcept"}
    }
  ]
}