{
  "@context": {
    "@base": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/",
    "m1": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M1_CoreConcepts.jsonld#",
    "m2": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld#",
    "m3": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M3_GenesisGrammar.jsonld#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",
    "adms": "http://www.w3.org/ns/adms#",
    "skos": "http://www.w3.org/2004/02/skos/core#"
  },
  "@graph": [
    {
      "@id": "m1:extension:energy_generators:M1_EnergyGenerators",
      "@type": "owl:Ontology",
      "dcterms:title": "TSCG M1 Energy Generators Extension",
      "dcterms:description": "Domain extension for energy generation systems. Nuclear reactors fully modeled (9 types), fossil/renewable planned.",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "dcterms:created": "2026-02-10",
      "dcterms:modified": "2026-10-12",
      "owl:versionInfo": "1.9.0",
      "m3:ontologyType": {
        "@id": "m3:DomainExtension"
      },
      "owl:imports": [
        { "@id": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M1_CoreConcepts.jsonld" },
        { "@id": "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld" }
      ],
      "m3:changelog": [
        {
          "owl:versionInfo": "1.9.0",
          "dcterms:date": "2026-10-12",
          "adms:versionNotes": "SC-5 Domain fusion (Michel, 2026-10-11/12): domains are classes rdfs:subClassOf m1:Domain, never individuals. m1:extension:energy_generators:EnergyGenerators -> owl:Class ⊑ m1:Domain. m2:KnowledgeField / m1:KnowledgeFieldGenericCombo are obsolete (declared nowhere); the KnowledgeField-only keys m2:knowledgeFieldRole, m2:derivedFrom (now rdfs:subClassOf) dropped; m2:qualifier text kept as skos:definition. Obsolete KnowledgeField vocabulary purged from the live text (Michel, 2026-10-12: there is no KnowledgeField any more, it is Domain)."
        },
        {
          "owl:versionInfo": "1.8.0",
          "dcterms:date": "2026-10-11",
          "adms:versionNotes": "WS-1 B2 lot C1b (class/instance separation, follow-up of C1). rdfs:subClassOf values written as plain strings (JSON-LD literals: the property is not @id-coerced in the @context, so these superclass links were absent from the graph) rewritten as IRIs: 2 value(s)."
        },
        {
          "owl:versionInfo": "1.7.0",
          "dcterms:date": "2026-10-11",
          "adms:versionNotes": "WS-1 B2 lot C2 (class/instance separation). m2:DomainConceptCombo removed from the @type of 1 combo(s): a combo is a DERIVED CLASS (rdfs:subClassOf m2:DomainConceptCombo, an IRI since lot C1), never an instance of the combo class (Michel, 2026-10-11). @type is now owl:Class alone. Typing a combo as an instance of a combo class is forbidden from now on (M1 SHACL 1.7.0 SHAPE 12 NoComboPunningShape, check_M1 1.7.0 CMB001)."
        }
      ]
    },
    {
      "@id": "m1:extension:energy_generators:EnergyGenerators",
      "@type": "owl:Class",
      "rdfs:subClassOf": {
        "@id": "m1:Domain"
      },
      "rdfs:label": "Energy Generators",
      "rdfs:comment": "Energy Generators as a Domain for TSCG domain modeling.",
      "dcterms:created": "2026-05-26",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI"
    },
    {
      "@id": "m1:extension:energy_generators:EnergyGenerator",
      "@type": "owl:Class",
      "rdfs:label": "Energy Generator",
      "rdfs:comment": "Abstract base class for all power generation systems. Subclass of m2:Processor.",
      "rdfs:subClassOf": {"@id": "m2:Processor"},
      "skos:note": "Domain scope: nuclear, fossil, renewable, hydroelectric, geothermal. See M0_NuclearReactorTypology for first validated instance.",
      "dcterms:created": "2026-02-10",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI"
    },
    {
      "@id": "m1:extension:energy_generators:NuclearReactor",
      "@type": "owl:Class",
      "rdfs:subClassOf": [
        {"@id": "m2:DomainConceptCombo"},
        {"@id": "m1:extension:energy_generators:EnergyGenerator"}
      ],
      "rdfs:label": "Nuclear Reactor",
      "rdfs:comment": "Power generation via controlled nuclear fission. See M0_NuclearReactorTypology for 9 reactor types (PWR, BWR, CANDU, RBMK, VVER, HTGR, FBR, MSR, SMR).",
      "m1:structuralGrammarFormula": "Fm1m2(EnergyGenerators, D × F × A | V + O)",
      "skos:note": "Validated by M0_NuclearReactorTypology poclet (Étape 3 completed 2026-02-10).",
      "dcterms:created": "2026-02-10",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI"
    }
  ]
}