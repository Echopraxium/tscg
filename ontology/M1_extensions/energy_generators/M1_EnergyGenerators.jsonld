  "@graph": [
    {
      "@id": "m1:extension:energy_generators:M1_EnergyGenerators",
      "@type": "owl:Ontology",
      "dcterms:title": "TSCG M1 Energy Generators Extension",
      "dcterms:description": "Domain extension for energy generation systems. Nuclear reactors fully modeled (9 types), fossil/renewable planned.",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "dcterms:created": "2026-02-10",
      "dcterms:modified": "2026-09-30",
      "owl:versionInfo": "1.3.0",
      "m3:ontologyType": {
        "@id": "m3:DomainExtension"
      },
      "owl:imports": [
        "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M1_CoreConcepts.jsonld",
        "https://raw.githubusercontent.com/Echopraxium/tscg/main/ontology/M2_GenericConcepts.jsonld"
      ],
      "m3:changelog": [
        {
          "owl:versionInfo": "1.3.0",
          "dcterms:date": "2026-09-30",
          "adms:versionNotes": "WS-1 VOCABULARY CONSOLIDATION, lot 1d. Changelog container m2:changelog -> m3:changelog, the owl:AnnotationProperty declared in M3_GrammarFoundation since 2026-07-22 (transversal apex property; a lower layer referencing m3: is a legal downward reference). m2:changelog was declared nowhere. Decision (Michel, 2026-09-30): no m2:changelog left anywhere (M0 instances follow in lot 1e). Triage: ontology/docs/_01_Worksite/WS-1/WS-1_FamilyA_Triage.md."
        },
        {
          "owl:versionInfo": "1.2.0",
          "dcterms:date": "2026-09-30",
          "adms:versionNotes": "WS-1 VOCABULARY CONSOLIDATION, lot 1c (Family A). Changelog entry keys, previously bare and dropped on JSON-LD expansion, replaced by standards: version -> owl:versionInfo, date -> dcterms:date, changes -> adms:versionNotes (ADMS: a description of changes between this version and the previous one). Prefix adms declared in @context: ADMS accepted as an external vocabulary (Michel, 2026-09-30). Changelog entries become graph-visible. Legacy changelog forms (maps keyed by version, metadata blocks) left for a separate lot. Triage: ontology/docs/_01_Worksite/WS-1/WS-1_FamilyA_Triage.md."
        },
        {
          "owl:versionInfo": "1.1.0",
          "dcterms:date": "2026-07-12",
          "adms:versionNotes": "SC-1 FUNCTIONAL GRAMMAR MODEL. RENAME (hard): m2:KnowledgeFieldConceptCombo → m2:DomainConceptCombo. The class is also RE-DEFINED: a DomainConceptCombo is defined by its Fm1m2 formula — a hybrid of ≥1 Domain and ≥1 GenericConcept (domain qualification), superseding the former 'parents from distinct epistemological domains' criterion. A combo's formula IS the function signature: Fm2 : GenericConcept²⁺ → GenericConceptCombo (≥2 concepts); Fm1m2 : Domain⁺, GenericConcept⁺ → DomainConceptCombo (≥1 domain AND ≥1 concept). No monoidal formula, no monoidal expansion — emergence is non-compositional, so Fm2/Fm1m2 are FUNCTIONS, not functors. Arguments = named concepts from M2_GenericConcepts or M1_CoreConcepts only, comma-juxtaposed, never primitives, never joined by ×/+/|. Fm1 does not exist. ⚠ Formulas in this file are FLAGGED by the new SHACL (v1.1.0) and NOT repaired here — repair belongs to SC-6. See StructuralGrammar/Functional_Grammar_Model.md."
        }
      ]
    },
    {
      "@id": "m1:extension:energy_generators:EnergyGenerators",
      "@type": [
        "owl:NamedIndividual",
        "m2:KnowledgeField"
      ],
      "rdfs:label": "Energy Generators",
      "rdfs:comment": "Energy Generators as a Knowledge Field for TSCG domain modeling.",
      "m2:knowledgeFieldRole": "NOUN",
      "dcterms:created": "2026-05-26",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI"
    },
    {
      "@id": "m1:extension:energy_generators:EnergyGenerator",
      "@type": "owl:Class",
      "rdfs:label": "Energy Generator",
      "rdfs:comment": "Abstract base class for all power generation systems. Subclass of m2:Processor.",
      "rdfs:subClassOf": "m2:Processor",
      "skos:note": "Domain scope: nuclear, fossil, renewable, hydroelectric, geothermal. See M0_NuclearReactorTypology for first validated instance.",
      "dcterms:created": "2026-02-10",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI"
    },
    {
      "@id": "m1:extension:energy_generators:NuclearReactor",
      "@type": [
        "owl:Class",
        "m2:DomainConceptCombo"
      ],
      "rdfs:subClassOf": [
        "m2:DomainConceptCombo",
        "m1:extension:energy_generators:EnergyGenerator"
      ],
      "rdfs:label": "Nuclear Reactor",
      "rdfs:comment": "Power generation via controlled nuclear fission. See M0_NuclearReactorTypology for 9 reactor types (PWR, BWR, CANDU, RBMK, VVER, HTGR, FBR, MSR, SMR).",
      "m1:structuralGrammarFormula": "Fm1m2(EnergyGenerators, D × F × A | V + O)",
      "skos:note": "Validated by M0_NuclearReactorTypology poclet (Étape 3 completed 2026-02-10).",
      "dcterms:created": "2026-02-10",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI"
    }
  ]
