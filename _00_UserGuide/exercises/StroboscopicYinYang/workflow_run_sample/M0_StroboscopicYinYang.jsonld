      "m3:ontologyType": {
        "@id": "m3:Poclet"
      },
      "rdfs:label": "Stroboscopic Yin-Yang (Poclet)",
      "rdfs:comment": "A spinning order-2 symmetric yin-yang disc sampled discretely by the eye or a strobe. Models the relation speed → perceived regime (smooth / frozen / reversed), making the Territory→Map reduction Φ: Gt → Gm directly visible. Information/Dynamics-dominant, weak Attractor. New-domain finding (Perception); flags an 'Aliasing' M2 candidate.",
      "dcterms:creator": "Echopraxium with the collaboration of Claude AI",
      "dcterms:created": "2026-08-19",
      "owl:versionInfo": "1.0.0",
      "m1:domain": [
        "Perception"
      ],
      "m2:changelog": [
        {
          "version": "1.0.0",
          "date": "2026-08-19",
          "changes": "Initial model via tscg-instance-pipeline (Proposition→Analysis→Modeling). Pattern-B flat scores; SHACL v1.6 conformant. Documents new-domain finding (Perception, adjacent to Optics) and flags 'Aliasing' M2 candidate (hold, anti-overfitting)."
        }
      ],
      "scoreA": 0.3,
      "scoreS": 0.65,
      "scoreF": 0.8,
      "scoreIt": 0.9,
      "scoreD": 0.9,
      "scoreR": 0.85,
      "scoreE": 0.75,
      "scoreV": 0.95,
      "scoreO": 0.9,
      "scoreIm": 0.85,
      "asfidMean": 0.71,
      "revoiMean": 0.86,
      "epistemicGap": 0.106,
      "m0:spectralClass": {
        "@id": "m0:spectralClass.OnCriticalLine"
      },
      "m0:scoringStatus": {
        "@id": "m0:scoringStatus.Complete"
      },
      "focalApplicable": true,
      "stereopsicDepth": 0.75,
      "focalBias": 0.15,
      "focalScore": 0.638,
      "m0:focalClass": {
        "@id": "m0:focalClass.SlightlyHyperopic"
      },
      "m0.stroboscopicYinYang:pocletType": "Composite (perceptual sampling)",
      "m0.stroboscopicYinYang:completeness": "All ASFID dimensions present (A weak, honest)",
      "m0.stroboscopicYinYang:minimality": "3 components + 3 drivers (irreducible)",
      "m0.stroboscopicYinYang:pedagogy": "Entry point for sampling, aliasing, and the Territory/Map distinction — self-verifying",
      "m0.stroboscopicYinYang:observer": "Human visual system (retinal persistence) or mechanical strobe",
      "m0.stroboscopicYinYang:domainFinding": "No Perception/psychophysics M1 extension exists at HEAD (verified: 404). Genuinely distinct from Optics (which models light/lenses, not temporal sampling of perception). New-domain candidate.",
      "m0.stroboscopicYinYang:components": [
        {
          "@id": "m0.stroboscopicYinYang:RotatingDisc",
          "@type": "m2:System",
          "rdfs:label": "Rotating Yin-Yang Disc",
          "m0.stroboscopicYinYang:role": "Territory object (the thing itself, continuously rotating)",
          "m0.stroboscopicYinYang:function": "Carries an order-2 rotationally symmetric figure (S-curve + two dots) rotating at angular speed ω",
          "m0.stroboscopicYinYang:invariant": "Order-2 rotational symmetry: the figure maps onto itself under a 180° rotation",
          "m0.stroboscopicYinYang:asfidContribution": {
            "S": "Order-2 rotational symmetry of the figure",
            "F": "Continuous angular flow (the true rotation)",
            "D": "Angular dynamics — smooth, uniform rotation"
          }
        },
        {
          "@id": "m0.stroboscopicYinYang:Sampler",
          "@type": "m2:Channel",
          "rdfs:label": "Sampler (Retina / Strobe)",
          "m0.stroboscopicYinYang:role": "Map-building apparatus (discretely samples the continuous rotation)",
          "m0.stroboscopicYinYang:function": "Integrates/samples the continuous motion at rate f_s (retinal persistence ~1/16 s, or a strobe frame rate)",
          "m0.stroboscopicYinYang:twoModes": [
            "Retinal persistence: time-integration → motion blur (smeared continuous image)",
            "Stroboscopic sampling: discrete frame stream → aliasing (beat against ω)"
          ],
          "m0.stroboscopicYinYang:asfidContribution": {
            "F": "The discrete sample stream (frames) drawn from the continuous flow",
            "It": "Sampling rate f_s and phase φ — the reduction parameters",
            "D": "Beat dynamics between ω and f_s"
          }
        },
        {
          "@id": "m0.stroboscopicYinYang:PerceivedImage",
          "@type": "m2:Representation",
          "rdfs:label": "Perceived Image (the Map)",
          "m0.stroboscopicYinYang:role": "The Map: what the observer actually sees, which can diverge from the Territory",
          "m0.stroboscopicYinYang:function": "Encodes a perceived regime (smooth / frozen / reversed / morphing) as a function of ω and f_s",
          "m0.stroboscopicYinYang:regimes": [
            {
              "name": "Smooth rotation",
              "condition": "ω ≪ f_s",
              "perception": "Faithful — Map ≈ Territory"
            },
            {
              "name": "Frozen figure",
              "condition": "ω = k·f_s (k ∈ ℤ⁺)",
              "perception": "Apparent standstill — resonance-like fixed point of perception, NOT of the disc"
            },
            {
              "name": "Apparent reversal",
              "condition": "ω slightly above k·f_s",
              "perception": "Wagon-wheel effect — disc appears to rotate backwards"
            },
            {
              "name": "Morphing pattern",
              "condition": "ω near half-integer multiples of f_s",
              "perception": "Doubled / shifted figures, unstable morphing"
            }
          ],
          "m0.stroboscopicYinYang:asfidContribution": {
            "A": "Weak attractor — quasi-fixed points (freeze) only at special speeds, and of the perception not the disc",
            "It": "Encodes the perceived regime"
          }
        }
      ],
      "m0.stroboscopicYinYang:drivers": {
        "m0.stroboscopicYinYang:rotationSpeed": {
          "symbol": "ω",
          "role": "Territory rate — true angular speed of the disc",
          "asfid": "F, D"
        },
        "m0.stroboscopicYinYang:samplingRate": {
          "symbol": "f_s",
          "role": "Map rate — sampling/strobe frequency of the observer",
          "asfid": "It"
        },
        "m0.stroboscopicYinYang:phase": {
          "symbol": "φ",
          "role": "Phase relation between rotation and sampling",
          "asfid": "It"
        }
      },
      "m0.stroboscopicYinYang:process": {
        "name": "Stroboscopic sampling (aliasing beat)",
        "type": "m2:Process",
        "trigger": "Continuous rotation sampled discretely at rate f_s (m2:Trigger when ω crosses a critical multiple of f_s)",
        "mechanism": "A continuous angular flow ω is reduced to a discrete sample stream at rate f_s. The perceived angular velocity is the aliased value ω_perceived = ((ω + f_s/2) mod f_s) − f_s/2 (per symmetry period). When ω is an integer multiple of f_s the samples land on identical figure orientations → frozen; just above, the figure appears to step backwards → reversal.",
        "coreRelation": "Φ: Gt → Gm — the eye/strobe maps a continuous Territory onto a discrete-sampled Map. The gap between them is the whole lesson.",
        "products": [
          "Perceived regime (smooth | frozen | reversed | morphing)",
          "An epistemic gap between actual and perceived motion"
        ],
        "keyProperty": "Order-2 symmetry halves the effective period: freeze/reversal recur twice as often as for a single-mark wheel."
      },
      "m0.stroboscopicYinYang:territorySpace": {
        "description": "The disc as it actually is: a continuously, uniformly rotating order-2 symmetric figure.",
        "observer": "Idealized (ground-truth rotation)",
        "basis": "ASFID (Eagle Eye)",
        "asfidState": {
          "A": 0.3,
          "S": 0.65,
          "F": 0.8,
          "It": 0.9,
          "D": 0.9
        },
        "stateVector": "|Ω_disc⟩ = 0.30|A⟩ + 0.65|S⟩ + 0.80|F⟩ + 0.90|It⟩ + 0.90|D⟩",
        "norm": 1.665,
        "observables": [
          "True angular position θ(t)",
          "Uniform angular velocity ω",
          "Order-2 symmetry"
        ]
      },
      "m0.stroboscopicYinYang:mapSpace": {
        "description": "The perceived/modelled image: a discrete-sampled reconstruction whose regime depends on ω vs f_s.",
        "observer": "Human eye (retinal persistence) or strobe",
        "basis": "REVOI (Sphinx Eye)",
        "reviState": {
          "R": 0.85,
          "E": 0.75,
          "V": 0.95,
          "O": 0.9,
          "Im": 0.85
        },
        "reviStateVector": "|M_perceived⟩_REVOI = 0.85|R⟩ + 0.75|E⟩ + 0.95|V⟩ + 0.90|O⟩ + 0.85|Im⟩",
        "reviNorm": 1.929,
        "justification": {
          "R": "Very representable — a spinning disc with two sliders is a clean diagram",
          "E": "Evolvable — the same Map extends to audio aliasing, moiré, film strobing",
          "V": "Gold-standard verifiability — the viewer checks it against their own eyes in seconds",
          "O": "Highly observable — the freeze/reversal is directly perceptible",
          "Im": "Interoperable — 'aliasing' is shared vocabulary across signal processing, film, audio"
        }
      },
      "m0.stroboscopicYinYang:epistemicGap": {
        "formula": "ΔΘ = ‖ |Ω_disc⟩ − |M_perceived⟩ ‖ ; δ₁ = |asfidMean − revoiMean| / √2",
        "asfidMean": 0.71,
        "revoiMean": 0.86,
        "delta1": 0.106,
        "interpretation": "OnCriticalLine (0.05 ≤ δ₁ < 0.15) — a real but moderate gap between what the disc does and what is seen.",
        "meaning": "The gap is not model error but the phenomenon itself: perception constructs a Map that legitimately diverges from the Territory (that is the wagon-wheel effect)."
      },
      "m0.stroboscopicYinYang:revoi": {
        "description": "Sphinx-Eye evaluation of the perceived-image Map (REVOI).",
        "reviState": {
          "R": 0.85,
          "E": 0.75,
          "V": 0.95,
          "O": 0.9,
          "Im": 0.85
        },
        "dimensionInterpretations": [
          {
            "dimension": "V (Verifiability)",
            "coefficient": 0.95,
            "interpretation": "The reader falsifies/confirms every regime with their own eyes — free, first-person Verifiability."
          },
          {
            "dimension": "O (Observability)",
            "coefficient": 0.9,
            "interpretation": "Freeze and reversal are directly, unmistakably perceptible."
          },
          {
            "dimension": "R (Representability)",
            "coefficient": 0.85,
            "interpretation": "A single disc plus speed and strobe sliders fully represents the model."
          },
          {
            "dimension": "Im (Interoperability)",
            "coefficient": 0.85,
            "interpretation": "Aliasing/wagon-wheel is a shared concept across audio, imaging, film."
          },
          {
            "dimension": "E (Evolvability)",
            "coefficient": 0.75,
            "interpretation": "Generalises to any discretely-sampled continuous process."
          }
        ],
        "overallAssessment": "High-quality Map, especially strong on V and O — a rare poclet whose model the user can check first-hand.",
        "mapQuality": "REVOI_mean = 0.86 → high-quality Map"
      },
      "m0.stroboscopicYinYang:GenericConceptsMobilized": {
        "total": 23,
        "note": "Formulas verified against ontology/M2_GenericConcepts.jsonld at HEAD. Operators: × (Gt/ASFID), + (Gm/REVOI), | (Gs/stereopsis). ⊗ is forbidden.",
        "byCategory": {
          "Structural": [
            {
              "name": "Symmetry",
              "formula": "St",
              "role": "Order-2 rotational symmetry of the yin-yang figure"
            },
            {
              "name": "Component",
              "formula": "St × It | L",
              "role": "Disc, sampler, perceived image as parts"
            },
            {
              "name": "System",
              "formula": "St × F",
              "role": "The coupled disc+sampler+observer whole"
            },
            {
              "name": "Topology",
              "formula": "St | L",
              "role": "Circular (periodic) configuration of the rotation"
            }
          ],
          "Dynamic": [
            {
              "name": "Process",
              "formula": "D × F",
              "role": "Continuous rotation as dynamic transformation"
            },
            {
              "name": "Trajectory",
              "formula": "A × D × F",
              "role": "Angular trajectory θ(t) of the disc over time"
            },
            {
              "name": "Transformation",
              "formula": "D × St × It",
              "role": "Continuous → discrete reduction (sampling)"
            },
            {
              "name": "Bifurcation",
              "formula": "D × F | L",
              "role": "Qualitative regime switch (smooth → frozen → reversed) at critical speeds"
            }
          ],
          "Regulatory": [
            {
              "name": "Threshold",
              "formula": "A × It",
              "role": "Critical speeds ω = k·f_s where the regime changes"
            },
            {
              "name": "Trigger",
              "formula": "D × It",
              "role": "Crossing a critical multiple triggers a regime transition"
            }
          ],
          "Informational": [
            {
              "name": "Signal",
              "formula": "It × F",
              "role": "The rotation as a continuous signal and the sampled stream"
            },
            {
              "name": "Channel",
              "formula": "St × F | Ss",
              "role": "The sampler (retina/strobe) as the sampling channel"
            },
            {
              "name": "Transducer",
              "formula": "F × St × It",
              "role": "Eye/strobe transduces continuous motion into discrete samples"
            },
            {
              "name": "Coding (Encoding/Decoding)",
              "formula": "It × St × D",
              "role": "Sampling encodes the continuous into frames; perception decodes"
            },
            {
              "name": "Segmentation",
              "formula": "St × It × D",
              "role": "Discrete sampling segments continuous motion into frames"
            },
            {
              "name": "Representation",
              "formula": "It × St",
              "role": "The perceived image is a representation of the disc"
            },
            {
              "name": "Signature",
              "formula": "It × Ss | V",
              "role": "The perceived regime is a signature of ω/f_s — verifiable by one's own eyes"
            },
            {
              "name": "State",
              "formula": "It",
              "role": "Instantaneous angular state θ sampled per frame"
            },
            {
              "name": "Pattern (Recognition / Reuse)",
              "formula": "St × It × A | K",
              "role": "Perceiving a stable 'frozen' figure is pattern recognition"
            }
          ],
          "Epistemic": [
            {
              "name": "Observer",
              "formula": "It × A",
              "role": "The regime is observer-relative — depends on the sampler"
            },
            {
              "name": "Observable",
              "formula": "—",
              "role": "The perceived (not actual) motion is what is observable"
            },
            {
              "name": "Coherence (Coherence/Incoherence)",
              "formula": "A × St × It | R + O",
              "role": "Phase-lock coherence (frozen) vs incoherent smear/morph"
            },
            {
              "name": "Modelisation",
              "formula": "D × F × It | R + V + E",
              "role": "Building the Map (perceived regime) from the sampled Territory"
            }
          ]
        }
      },
      "m0.stroboscopicYinYang:m2Candidate": {
        "name": "Aliasing (Stroboscopic Sampling Artifact)",
        "proposedFormula": "F × D × It | Ss",
        "formulaStatus": "PROPOSAL — not verified at HEAD; provisional, subject to review",
        "role": "An artifact produced when a continuous Flow is discretely sampled and the sample rate beats against the process rate, yielding a perceived Dynamics that differs from the actual one (freeze / reversal / morph).",
        "status": "Proposal — to be validated",
        "antiOverfittingHold": "Requires attested residue across ≥6 independent domains before promotion.",
        "candidateDomains": [
          "Perceptual (wagon-wheel effect)",
          "Digital audio (aliasing / foldback)",
          "Optics-imaging (moiré)",
          "Cinematography (strobing on film)",
          "Strobe photography",
          "Signal processing (Nyquist violation)"
        ],
        "decision": "FLAG only — do NOT promote in this instance."
      },
      "m0.stroboscopicYinYang:validation": {
        "asfidCompleteness": "All 5 ASFID dimensions present (A weak but non-null, S/F/It/D strong) ✅",
